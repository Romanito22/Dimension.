---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import ProductCard from '../../components/ProductCard.astro';
import SizeTable from '../../components/SizeTable.astro';
import { media } from '../../lib/media';
import { products, brand, formatPrice, imageKeys, related, categoryLabel, totalStock, LOW_STOCK, SIZES, type Product } from '../../lib/shop';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

const { product: p } = Astro.props as { product: Product };
const keys = imageKeys(p);
const imgs = keys.map((k) => media(k));
const others = related(p);
const soldOut = totalStock(p) === 0;
const sizes = SIZES.map((s) => p.sizes.find((x) => x.size === s)).filter(Boolean) as Product['sizes'];
const data = { id: p.id, slug: p.slug, name: p.name, price: p.price, image: imgs[0].src, sizes: p.sizes, low: LOW_STOCK };

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  sku: p.id,
  description: p.description,
  image: imgs.map((i) => new URL(i.src, Astro.site).toString()),
  brand: { '@type': 'Brand', name: brand.name },
  color: p.colors.map((c) => c.name).join(', '),
  offers: {
    '@type': 'Offer',
    priceCurrency: 'EUR',
    price: p.price,
    availability: soldOut ? 'https://schema.org/OutOfStock' : 'https://schema.org/InStock',
    url: new URL(`/produit/${p.slug}`, Astro.site).toString(),
  },
};
---

<Base title={p.name} description={`${p.name} — ${p.short}. ${formatPrice(p.price)}.`} page="product" image={imgs[0].src} jsonld={jsonld}>
  <article class="pdp wrap" data-product>
    <script type="application/json" data-product-json set:html={JSON.stringify(data)} />

    <!-- Galerie -->
    <div class="gallery">
      <div class="gallery__track" data-gallery-track>
        {
          keys.map((k, i) => (
            <figure class="gallery__item media" data-zoom={i} tabindex="0" role="button" aria-label={`Agrandir l'image ${i + 1} sur ${keys.length}`} data-cursor="Zoom">
              <Img k={k} eager={i === 0} sizes="(max-width: 860px) 100vw, 60vw" vt={i === 0 ? `media-${p.slug}` : undefined} />
            </figure>
          ))
        }
      </div>
      <div class="gallery__count label" aria-hidden="true">
        <span data-gallery-counter>1</span> / {keys.length}
      </div>
      <div class="gallery__dots" aria-hidden="true">
        {keys.map((_, i) => <span data-gallery-dot class:list={[i === 0 && 'is-active']} />)}
      </div>
    </div>

    <!-- Infos -->
    <div class="info">
      <div class="info__sticky">
        <nav class="info__crumbs label muted" aria-label="Fil d'Ariane">
          <a href="/boutique" class="link">Boutique</a>
          <span aria-hidden="true">/</span>
          <a href={`/boutique?categorie=${p.category}`} class="link">{categoryLabel(p.category)}</a>
        </nav>

        <header class="info__head">
          {p.badge && <span class:list={['badge', p.badge === 'Nouveau' ? 'badge--accent' : 'badge--candy']}>{p.badge}</span>}
          <h1 class="display info__title">{p.name}</h1>
          <p class="info__short muted">{p.short}</p>
          <p class="info__price">{formatPrice(p.price)} <span class="muted">TTC</span></p>
        </header>

        <fieldset class="info__group">
          <legend class="info__legend">
            <span class="label">Couleur</span>
            <span data-color-label>{p.colors[0].name}</span>
          </legend>
          <div class="colors">
            {
              p.colors.map((c, i) => (
                <label class="color" title={c.name}>
                  <input type="radio" name="color" value={c.name} checked={i === 0} />
                  <span class="swatch" style={`background:${c.hex}`} />
                  <span class="visually-hidden">{c.name}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset class="info__group" data-sizes>
          <legend class="info__legend">
            <span class="label">Taille</span>
            <span data-size-label>—</span>
            <button type="button" class="info__guide link link--under label" data-size-guide-open>Guide des tailles</button>
          </legend>
          <div class="sizes">
            {
              sizes.map((s) => (
                <label class:list={['size', s.stock === 0 && 'is-out', s.stock > 0 && s.stock <= LOW_STOCK && 'is-low']}>
                  <input type="radio" name="size" value={s.size} disabled={s.stock === 0} />
                  <span>
                    {s.size}
                    {s.stock === 0 && <span class="visually-hidden"> — épuisé</span>}
                  </span>
                </label>
              ))
            }
          </div>
          <p class="info__error" data-size-error role="alert"></p>
        </fieldset>

        <p class="stock" data-stock aria-live="polite">Choisis ta taille</p>

        <button type="button" class="btn btn--accent btn--lg btn--block add" data-add data-add-main disabled={soldOut}>
          <span data-add-label>{soldOut ? 'Épuisé' : 'Ajouter au panier'}</span>
          <span class="add__price">{formatPrice(p.price)}</span>
        </button>

        <ul class="perks" role="list">
          <li><span class="perks__dot" aria-hidden="true"></span>Livraison offerte dès {brand.shipping.freeThreshold} €</li>
          <li><span class="perks__dot" aria-hidden="true"></span>Expédié sous 48 h</li>
          <li><span class="perks__dot" aria-hidden="true"></span>Retours sous {brand.shipping.returnsDays} jours</li>
        </ul>

        <div class="acc">
          <details open>
            <summary>Description</summary>
            <div class="acc__body">
              <p>{p.description}</p>
              <ul>{p.details.map((d) => <li>{d}</li>)}</ul>
              <p class="muted">{p.fit}</p>
            </div>
          </details>
          <details>
            <summary>Matières & entretien</summary>
            <div class="acc__body">
              <p>{p.fabric}</p>
              <ul>{p.care.map((c) => <li>{c}</li>)}</ul>
            </div>
          </details>
          <details>
            <summary>Livraison & retours</summary>
            <div class="acc__body">
              <ul>
                {brand.shipping.methods.map((m) => (
                  <li>
                    {m.label} — {m.delay} — {formatPrice(m.price)}
                  </li>
                ))}
              </ul>
              <p>
                Livraison offerte dès {brand.shipping.freeThreshold} € (hors express). Retours et échanges sous {brand.shipping.returnsDays} jours.{' '}
                <a href="/contact#faq" class="link link--under">Toutes les infos</a>
              </p>
            </div>
          </details>
        </div>
        <p class="info__ref label muted">Réf. {p.id}</p>
      </div>
    </div>
  </article>

  <section class="section wrap more" aria-labelledby="more-title">
    <div class="section-head">
      <div>
        <span class="label accent">{brand.drop.name}</span>
        <h2 id="more-title" data-chars class="display h-xl">Tu vas aussi aimer</h2>
      </div>
      <a href="/boutique" class="link link--under label">Toute la boutique</a>
    </div>
    <div class="more__grid">
      {others.map((o, i) => <div data-reveal style={`--i:${i}`}><ProductCard product={o} index={i} /></div>)}
    </div>
  </section>

  <!-- Barre d'achat mobile -->
  <div class="sticky" data-sticky>
    <div class="sticky__info">
      <span class="sticky__name">{p.name}</span>
      <span class="muted">{formatPrice(p.price)}</span>
    </div>
    <button type="button" class="btn btn--accent" data-add disabled={soldOut}><span data-add-label>Ajouter au panier</span></button>
  </div>

  <!-- Plein écran -->
  <dialog class="lightbox" data-lightbox aria-label={`Galerie — ${p.name}`}>
    <img data-lightbox-img src={imgs[0].src} alt={imgs[0].alt} />
    <button type="button" class="lightbox__close icon-btn" data-lb-close aria-label="Fermer">
      <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 2l12 12M14 2 2 14"></path></svg>
    </button>
    <button type="button" class="lightbox__nav lightbox__nav--prev" data-lb-prev aria-label="Image précédente">
      <svg width="20" height="14" viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 6H1m5-5L1 6l5 5"></path></svg>
    </button>
    <button type="button" class="lightbox__nav lightbox__nav--next" data-lb-next aria-label="Image suivante">
      <svg width="20" height="14" viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 6h16m-5-5 5 5-5 5"></path></svg>
    </button>
    <p class="lightbox__count label" data-lightbox-count>1 / {keys.length}</p>
  </dialog>

  <!-- Guide des tailles -->
  <dialog class="guide" data-size-guide aria-labelledby="guide-title">
    <div class="guide__panel" data-lenis-prevent>
      <header class="guide__head">
        <h2 id="guide-title" class="display guide__title">Guide des tailles</h2>
        <button type="button" class="icon-btn" data-guide-close aria-label="Fermer le guide des tailles">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 2l12 12M14 2 2 14"></path></svg>
        </button>
      </header>
      <p class="muted guide__intro">{p.fit} Entre deux tailles ? Prends la plus grande pour un tombé plus ample.</p>
      <SizeTable only={p.category} />
    </div>
  </dialog>
</Base>

<style>
  .pdp {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 5rem);
    padding-top: 1rem;
  }

  /* Galerie */
  .gallery {
    position: relative;
  }
  .gallery__track {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .gallery__item {
    margin: 0;
    aspect-ratio: 4 / 5;
    cursor: zoom-in;
    border-radius: var(--radius);
  }
  .gallery__item:first-child,
  .gallery__item:nth-child(4) {
    grid-column: 1 / -1;
  }
  .gallery__item :global(img) {
    transition: transform 0.5s var(--ease-out);
  }
  .gallery__item:global(.is-zoomed) :global(img) {
    transform: scale(2);
  }
  .gallery__count,
  .gallery__dots {
    display: none;
  }

  /* Infos */
  .info__sticky {
    position: sticky;
    top: calc(var(--header-total) + 1.5rem);
    display: grid;
    gap: 1.5rem;
    padding-bottom: 2rem;
  }
  .info__crumbs {
    display: flex;
    gap: 0.6rem;
  }
  .info__head {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }
  .info__title {
    font-size: clamp(1.7rem, 1rem + 2.2vw, 3rem);
  }
  .info__price {
    font-family: var(--f-display);
    font-size: 1.9rem;
    font-weight: 700;
    line-height: 1;
  }
  .info__price .muted {
    font-size: var(--fs-xs);
    font-weight: 400;
  }
  .info__group {
    border: 0;
    padding: 0;
    margin: 0;
    position: relative;
  }
  .info__legend {
    width: 100%;
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    margin-bottom: 0.85rem;
    padding: 0;
    font-size: var(--fs-sm);
    font-weight: 600;
  }
  .info__guide {
    margin-left: auto;
    font-weight: 600;
  }
  .colors {
    display: flex;
    gap: 0.75rem;
  }
  .color input,
  .size input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .color .swatch {
    width: 34px;
    height: 34px;
    cursor: pointer;
    transition: box-shadow 0.25s;
  }
  .color input:checked + .swatch {
    box-shadow:
      inset 0 0 0 1px rgb(0 0 0 / 0.18),
      0 0 0 3px var(--bg),
      0 0 0 4.5px var(--fg);
  }
  .color input:focus-visible + .swatch {
    outline: 2px solid var(--accent);
    outline-offset: 5px;
  }
  .sizes {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 6px;
  }
  .size > span {
    position: relative;
    display: grid;
    place-items: center;
    height: 52px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font-weight: 600;
    font-size: var(--fs-sm);
    cursor: pointer;
    transition:
      background 0.2s,
      color 0.2s,
      border-color 0.2s;
  }
  .size:hover > span {
    border-color: var(--fg);
  }
  .size input:checked + span {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }
  .size input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .size.is-low > span::after {
    content: '';
    position: absolute;
    top: 6px;
    right: 6px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }
  .size.is-out > span {
    color: var(--muted);
    cursor: not-allowed;
    background: linear-gradient(to top right, transparent calc(50% - 0.5px), var(--line-strong) 50%, transparent calc(50% + 0.5px));
  }
  .info__group:global(.is-error) .sizes {
    animation: shake 0.45s var(--ease-out);
  }
  .info__group:global(.is-error) .size > span {
    border-color: var(--accent);
  }
  @keyframes shake {
    20%,
    60% {
      transform: translateX(-6px);
    }
    40%,
    80% {
      transform: translateX(6px);
    }
  }
  .info__error {
    color: var(--accent);
    font-size: var(--fs-xs);
    font-weight: 600;
    min-height: 0;
    margin-top: 0.5rem;
  }
  .info__error:empty {
    display: none;
  }
  .stock {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .stock::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
  }
  .stock:global(.is-ok) {
    color: var(--ok);
  }
  .stock:global(.is-ok)::before {
    background: currentColor;
  }
  .stock:global(.is-low) {
    color: var(--accent);
    font-weight: 600;
  }
  .stock:global(.is-low)::before {
    background: currentColor;
    animation: pulse 1.4s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.3;
    }
  }
  .add {
    justify-content: space-between;
    padding-inline: 1.75rem;
  }
  .add:global(.is-added) {
    --btn-bg: var(--ok);
  }
  .add__price {
    opacity: 0.85;
  }
  .perks {
    display: grid;
    gap: 0.5rem;
    font-size: var(--fs-sm);
  }
  .perks li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .perks__dot {
    width: 7px;
    height: 7px;
    border: 1.5px solid var(--accent);
    border-radius: 50%;
  }
  .acc {
    border-top: 1px solid var(--line);
  }
  .acc details {
    border-bottom: 1px solid var(--line);
  }
  .acc summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 1.1rem;
    cursor: pointer;
    font-family: var(--f-mono);
    font-weight: 700;
    font-size: var(--fs-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .acc summary::-webkit-details-marker {
    display: none;
  }
  .acc summary::after {
    content: '+';
    font-size: 1.25rem;
    font-weight: 400;
    transition: transform 0.4s var(--ease-out);
  }
  .acc details[open] summary::after {
    transform: rotate(45deg);
  }
  .acc__body {
    display: grid;
    gap: 0.75rem;
    padding-bottom: 1.25rem;
    font-size: var(--fs-sm);
    color: var(--fg-2);
  }
  .acc__body ul {
    padding-left: 1.1rem;
    display: grid;
    gap: 0.3rem;
  }

  .more__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(12px, 1.4vw, 24px);
  }

  /* Barre collante */
  .sticky {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem var(--gutter) calc(0.75rem + env(safe-area-inset-bottom));
    background: rgb(var(--bg-rgb) / 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid var(--line);
    transform: translateY(100%);
    transition: transform 0.5s var(--ease-out);
  }
  .sticky:global(.is-visible) {
    transform: none;
  }
  .sticky__info {
    display: grid;
    font-size: var(--fs-sm);
    line-height: 1.3;
    min-width: 0;
  }
  .sticky__name {
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Lightbox */
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--media);
    overflow: hidden;
  }
  .lightbox::backdrop {
    background: var(--media);
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
    animation: fade 0.4s var(--ease-out);
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  .lightbox img {
    max-width: 100%;
    max-height: 100dvh;
    object-fit: contain;
    cursor: zoom-in;
    transition: transform 0.5s var(--ease-out);
  }
  .lightbox img:global(.is-zoomed) {
    transform: scale(2.2);
    cursor: zoom-out;
  }
  .lightbox__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: var(--bg);
  }
  .lightbox__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--bg);
    display: grid;
    place-items: center;
    transition:
      background 0.3s,
      color 0.3s;
  }
  .lightbox__nav:hover {
    background: var(--fg);
    color: var(--bg);
  }
  .lightbox__nav--prev {
    left: 1rem;
  }
  .lightbox__nav--next {
    right: 1rem;
  }
  .lightbox__count {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
  }

  /* Guide des tailles */
  .guide {
    margin: 0 0 0 auto;
    height: 100dvh;
    max-height: none;
    width: min(560px, 100%);
    max-width: none;
    padding: 0;
    border: 0;
    background: var(--bg);
    color: var(--fg);
  }
  .guide::backdrop {
    background: rgb(0 0 0 / 0.62);
  }
  .guide[open] {
    animation: slide-in 0.55s var(--ease-out);
  }
  @keyframes slide-in {
    from {
      transform: translateX(100%);
    }
  }
  .guide__panel {
    height: 100%;
    overflow-y: auto;
    padding: 0 var(--gutter) 2rem;
  }
  .guide__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 1.25rem;
  }
  .guide__title {
    font-size: 1.2rem;
  }
  .guide__intro {
    font-size: var(--fs-sm);
    margin-bottom: 1.5rem;
  }

  @media (max-width: 860px) {
    .pdp {
      grid-template-columns: 1fr;
      padding: 0;
      gap: 1.5rem;
    }
    .gallery__track {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      gap: 0;
    }
    .gallery__track::-webkit-scrollbar {
      display: none;
    }
    .gallery__item {
      flex: 0 0 100%;
      scroll-snap-align: start;
      border-radius: 0;
    }
    .gallery__count {
      display: block;
      position: absolute;
      top: 1rem;
      right: var(--gutter);
      padding: 0.35rem 0.7rem;
      background: var(--bg);
      border-radius: 999px;
    }
    .gallery__dots {
      display: flex;
      justify-content: center;
      gap: 6px;
      padding-top: 0.75rem;
    }
    .gallery__dots span {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      border: 1.3px solid var(--fg);
      transition: background 0.3s;
    }
    .gallery__dots span:global(.is-active) {
      background: var(--fg);
    }
    .info {
      padding-inline: var(--gutter);
    }
    .info__sticky {
      position: static;
    }
    .sticky {
      display: flex;
    }
    .more__grid {
      grid-template-columns: 1fr 1fr;
    }
    .sizes {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
