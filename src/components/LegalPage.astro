---
import Base from '../layouts/Base.astro';
import { localeFromPath, translator, type RouteKey } from '../i18n';

interface Props {
  title: string;
  updated: string;
  route?: RouteKey;
}
const { title, updated, route } = Astro.props;
const t = translator(localeFromPath(Astro.url.pathname));
---

<Base title={title} page="legal" route={route}>
  <article class="wrap legal">
    <header class="legal__head">
      <p class="label accent">{t('Informations légales', 'Legal information')}</p>
      <h1 class="display h-xl patch">{title}</h1>
      <p class="label muted">{t('Mise à jour : ', 'Last updated: ')}{updated}</p>
    </header>
    <div class="prose legal__body">
      <slot />
    </div>
  </article>
</Base>

<style>
  .legal {
    padding-block: var(--space-lg);
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-lg);
  }
  .legal__head {
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .legal__body :global(mark) {
    background: var(--accent-soft);
    color: var(--accent-deep);
    padding: 0 0.2em;
  }
  .legal__body > :global(* + *) {
    margin-top: 1em;
  }
  .legal__body :global(ul) {
    list-style: disc;
    padding-left: 1.2em;
    display: grid;
    gap: 0.4em;
  }
  .legal__body :global(.legal__summary) {
    padding: 1.25rem 1.4rem;
    border: 2px solid var(--ink);
    border-radius: 16px;
    background: var(--cotton);
    box-shadow: 5px 5px 0 var(--brand);
  }
  .legal__body :global(.legal__summary ul) {
    margin-top: 0.6rem;
  }
  .legal__body :global(.legal__box) {
    padding: 1rem 1.2rem;
    border-left: 3px solid var(--brand);
    background: var(--surface, #fff);
    font-size: var(--fs-sm);
  }
  .legal__body :global(.legal__box p + p) {
    margin-top: 0.75rem;
  }
  .legal__body :global(h3) {
    font-size: 1.05rem;
    margin-top: 1.5rem;
  }
  .legal__body :global(h2) {
    scroll-margin-top: calc(var(--header-total) + 1rem);
  }
  @media (max-width: 860px) {
    .legal {
      grid-template-columns: 1fr;
    }
  }
</style>
