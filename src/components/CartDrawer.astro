---
import Icon from './Icon.astro';
import brand from '../data/brand.json';
import { localeFromPath, translator, href } from '../i18n';
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
---

<dialog class="sheet drawer" id="cart-drawer" data-drawer data-dialog="cart" aria-labelledby="cart-title" transition:persist="cart-drawer">
  <div class="drawer__panel" data-lenis-prevent>
    <header class="drawer__head">
      <h2 id="cart-title" class="display drawer__title">{t('Panier', 'Bag')} <sup data-cart-count>0</sup></h2>
      <button class="icon-btn" type="button" data-cart-close aria-label={t('Fermer le panier', 'Close bag')}>
        <Icon name="close" size={18} />
      </button>
    </header>

    <div class="drawer__ship" data-ship data-threshold={brand.shipping.freeThreshold}>
      <p class="drawer__ship-text" data-ship-text></p>
      <div class="drawer__ship-bar"><span data-ship-bar></span></div>
    </div>

    <div class="drawer__body">
      <div class="drawer__undo" data-undo hidden>
        <span>{t('Retiré : ', 'Removed: ')}<strong data-undo-name></strong></span>
        <button type="button" class="drawer__undo-btn label" data-undo-btn>{t('Annuler', 'Undo')}</button>
      </div>
      <div data-cart-lines></div>
      <div class="upsell" data-upsell hidden>
        <p class="label upsell__title">{t('Complète ton look', 'Complete the look')}</p>
        <div class="upsell__list" data-upsell-list></div>
      </div>
    </div>

    <footer class="drawer__foot" data-cart-foot>
      <div class="drawer__row">
        <span class="label">{t('Sous-total', 'Subtotal')}</span>
        <strong class="drawer__total" data-cart-subtotal>0 €</strong>
      </div>
      <p class="drawer__note muted">{t("Taxes incluses. Livraison calculée à l'étape suivante.", 'Taxes included. Delivery calculated at the next step.')}</p>
      <a href={href(locale, 'checkout')} class="btn btn--accent btn--lg btn--block" data-checkout-link>
        {t('Commander', 'Checkout')} <span class="btn__dot" aria-hidden="true"></span>
      </a>
      <button type="button" class="drawer__continue link label" data-cart-close>{t('Continuer mes achats', 'Continue shopping')}</button>
    </footer>
  </div>
</dialog>

<style>
  .drawer {
    width: min(460px, 100%);
    overflow: hidden;
  }
  .drawer__panel {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem var(--gutter);
    border-bottom: 2px solid var(--ink);
  }
  .drawer__title {
    font-size: 1.2rem;
  }
  .drawer__title sup {
    font-size: 0.55em;
    color: var(--accent);
    vertical-align: 0.8em;
    margin-left: 0.1em;
  }
  .drawer__ship {
    padding: 1rem var(--gutter);
    border-bottom: 1px solid var(--line);
  }
  .drawer__ship-text {
    font-size: var(--fs-sm);
    margin-bottom: 0.6rem;
  }
  .drawer__ship-bar {
    height: 3px;
    background: var(--surface);
    border-radius: 3px;
    overflow: hidden;
  }
  .drawer__ship-bar span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--accent);
    transition: width 0.8s var(--ease-out);
  }
  .drawer__undo {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    padding: 0.5rem 0.5rem 0.5rem 1rem;
    border: 1.5px dashed var(--line-strong);
    border-radius: 12px;
    font-size: var(--fs-sm);
    animation: undo-in 0.4s var(--ease-out);
  }
  .drawer__undo-btn {
    flex: none;
    min-height: 40px;
    padding: 0 1rem;
    border: 2px solid var(--ink);
    border-radius: 10px;
    background: var(--ink);
    color: var(--cotton);
  }
  .drawer__undo-btn:hover {
    background: var(--brand);
  }
  @keyframes undo-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  .upsell {
    margin-block: 1.5rem;
    padding-top: 1.25rem;
    border-top: 2px solid var(--ink);
  }
  .upsell__title {
    margin-bottom: 0.9rem;
    color: var(--muted);
  }
  .upsell__list {
    display: grid;
    gap: 0.75rem;
  }
  .upsell__list :global(.up) {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 0.9rem;
    padding: 0.6rem;
    border: 2px solid var(--ink);
    border-radius: 14px;
    background: var(--bg);
  }
  .upsell__list :global(.up img) {
    width: 64px;
    height: 80px;
    object-fit: cover;
    border-radius: 8px;
    background: var(--media);
  }
  .upsell__list :global(.up__top) {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: var(--fs-sm);
    font-weight: 600;
  }
  .upsell__list :global(.up__sizes) {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 0.5rem;
  }
  .upsell__list :global(.up__sizes button) {
    min-width: 34px;
    height: 30px;
    padding: 0 0.35rem;
    border: 1.5px solid var(--ink);
    border-radius: 7px;
    font-family: var(--f-mono);
    font-size: 0.625rem;
    font-weight: 600;
  }
  .upsell__list :global(.up__sizes button:hover) {
    background: var(--ink);
    color: var(--cotton);
  }
  .upsell__list :global(.up__sizes button:disabled) {
    opacity: 0.3;
    text-decoration: line-through;
  }
  .upsell__list :global(.up__sizes button.is-added) {
    background: var(--brand);
    color: #fff;
  }
  .drawer__body {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0 var(--gutter);
  }
  .drawer__foot {
    padding: 1.25rem var(--gutter) 1.5rem;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 0.9rem;
  }
  .drawer__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .drawer__total {
    font-size: 1.25rem;
    font-weight: 600;
  }
  .drawer__note {
    font-size: var(--fs-xs);
  }
  .drawer__continue {
    justify-self: center;
    padding: 0.5rem;
  }
</style>
