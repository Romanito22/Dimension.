---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import { SPECS } from '../lib/placeholder';
import { getProducts, getBrand, formatPrice, imageKeys } from '../lib/shop';
import { media } from '../lib/media';
import Icon from '../components/Icon.astro';
import { localeFromPath, translator, href } from '../i18n';

const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const products = getProducts(locale);
const brand = getBrand(locale);

// Chaque image du lookbook renvoie vers les pièces portées.
const looks = [
  { k: 'lookbook/1', p: [0], layout: 'full' },
  { k: 'lookbook/2', p: [1], layout: 'left' },
  { k: 'lookbook/3', p: [2], layout: 'right' },
  { k: 'lookbook/4', p: [4], layout: 'center' },
  { k: 'lookbook/5', p: [3, 1], layout: 'full' },
  { k: 'lookbook/6', p: [0], layout: 'left' },
  { k: 'lookbook/7', p: [4], layout: 'right' },
  { k: 'lookbook/8', p: [3], layout: 'center' },
  { k: 'lookbook/9', p: [2, 0, 4], layout: 'full' },
].map((l) => ({ ...l, wide: SPECS[l.k].ratio === '16:9', items: l.p.map((i) => products[i]) }));
---

<Base
  title="Lookbook"
  description={t(`Lookbook ${brand.drop.name} — ${brand.drop.title}. Les pièces dimension. au soleil.`, `${brand.drop.name} lookbook — ${brand.drop.title}. dimension. pieces in the sun.`)}
  page="lookbook"
  route="lookbook"
>
  <header class="lb-head wrap">
    <p class="label accent" data-reveal>{brand.drop.name} — {brand.drop.season}</p>
    <h1 class="display lb-head__title patch" data-split>
      <span class="split-line"><span>Love over</span></span>
      <span class="split-line" style="--l:1"><span class="lb-head__candy">everything</span></span>
    </h1>
    <p class="lede muted" data-reveal style="--i:2">
      {t('Cinq pièces à plat, sur les couleurs de la marque. Pas de décor : juste le coton, les prints et la broderie.', 'Five pieces laid flat, on the brand colours. No set: just the cotton, the prints and the embroidery.')}
    </p>
  </header>

  <div class="looks wrap">
    {
      looks.map((l, i) => (
        <figure class:list={['look', `look--${l.layout}`, l.wide && 'look--wide']}>
          <div class="look__media media" data-reveal="clip">
            <Img k={l.k} sizes={l.layout === 'full' ? '100vw' : '(max-width: 860px) 100vw, 50vw'} />
          </div>
          <figcaption class="look__cap" data-reveal style="--i:1">
            <span class="label muted">Look {String(i + 1).padStart(2, '0')}</span>
            <ul role="list">
              {l.items.map((p) => (
                <li>
                  <a href={href(locale, 'product', p.slug)} class="link link--under">
                    {p.name}
                  </a>{' '}
                  <span class="muted">{formatPrice(p.price, locale)}</span>
                </li>
              ))}
            </ul>
            <button
              type="button"
              class="btn look__buy"
              data-open="look"
              data-look={JSON.stringify(
                l.items.map((p) => ({
                  id: p.id,
                  slug: p.slug,
                  name: p.name,
                  price: p.price,
                  color: p.colors[0].name,
                  image: media(imageKeys(p)[0]).src,
                  url: href(locale, 'product', p.slug),
                  sizes: p.sizes,
                })),
              )}
              data-look-name={`Look ${String(i + 1).padStart(2, '0')}`}
            >
              {l.items.length > 1 ? t('Acheter le look', 'Shop the look') : t('Acheter la pièce', 'Shop the piece')}
            </button>
          </figcaption>
        </figure>
      ))
    }
  </div>

  <!-- Acheter le look : rempli par scripts/look.ts à l'ouverture -->
  <dialog class="sheet" data-dialog="look" data-look-sheet aria-labelledby="look-title">
    <div class="sheet__panel" data-lenis-prevent>
      <header class="sheet__head">
        <h2 id="look-title" class="display sheet__title" data-look-title>Look</h2>
        <button type="button" class="icon-btn" data-close aria-label={t('Fermer', 'Close')}><Icon name="close" size={18} /></button>
      </header>
      <p class="muted look-sheet__intro">{t('Choisis ta taille pour chaque pièce — ta taille mémorisée est déjà sélectionnée.', 'Pick your size for each piece — your saved size is already selected.')}</p>
      <ul class="look-sheet__list" role="list" data-look-list></ul>
      <p class="look-sheet__msg" data-look-msg role="status" aria-live="polite"></p>
      <button type="button" class="btn btn--accent btn--lg btn--block" data-look-add>{t('Ajouter le look au panier', 'Add the look to bag')}</button>
    </div>
  </dialog>

  <section class="lb-end wrap">
    <p class="display h-xl" data-reveal>{t('Tout le drop,', 'The whole drop,')}<br />{t('en séries courtes.', 'in short runs.')}</p>
    <a href={href(locale, 'shop')} class="btn btn--accent btn--lg" data-reveal style="--i:1">{t('Shop le Drop 01', 'Shop Drop 01')} <span class="btn__dot" aria-hidden="true"></span></a>
  </section>
</Base>

<style>
  .lb-head {
    padding-block: var(--space-lg);
    display: grid;
    gap: 1.25rem;
  }
  .lb-head__title {
    font-size: clamp(1.8rem, 6vw, 6.8rem);
  }
  .lb-head__candy {
    color: var(--accent);
  }
  .looks {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--space-lg) clamp(12px, 1.4vw, 24px);
  }
  .look {
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  .look--full {
    grid-column: 1 / -1;
  }
  .look--left {
    grid-column: 1 / span 6;
  }
  .look--right {
    grid-column: 7 / span 5;
    margin-top: 30%;
  }
  .look--center {
    grid-column: 4 / span 6;
  }
  .look__media {
    aspect-ratio: 4 / 5;
    border: 2px solid var(--ink);
    border-radius: 16px;
  }
  .look--wide .look__media {
    aspect-ratio: 16 / 9;
  }
  .look__cap {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: var(--fs-sm);
  }
  .look__cap ul {
    display: grid;
    gap: 0.25rem;
    text-align: right;
  }
  .look__buy {
    margin-top: 0.4rem;
  }
  .look-sheet__intro {
    font-size: var(--fs-sm);
    margin-bottom: 1rem;
  }
  .look-sheet__list {
    display: grid;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .look-sheet__list :global(li) {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 1rem;
    padding: 0.8rem;
    border: 2px solid var(--ink);
    border-radius: 14px;
    background: #fff;
  }
  .look-sheet__list :global(img) {
    width: 80px;
    height: 100px;
    object-fit: cover;
    border-radius: 10px;
    background: var(--media);
  }
  .look-sheet__list :global(.ls__top) {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-weight: 600;
    font-size: var(--fs-sm);
  }
  .look-sheet__list :global(.ls__sizes) {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 4px;
    margin-top: 0.6rem;
  }
  .look-sheet__list :global(.ls__sizes button) {
    height: 36px;
    border: 1.5px solid var(--ink);
    border-radius: 8px;
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    font-weight: 600;
  }
  .look-sheet__list :global(.ls__sizes button[aria-checked='true']) {
    background: var(--ink);
    color: var(--cotton);
  }
  .look-sheet__list :global(.ls__sizes button:disabled) {
    opacity: 0.3;
    text-decoration: line-through;
  }
  .look-sheet__list :global(.ls__skip) {
    margin-top: 0.5rem;
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .look-sheet__msg {
    color: var(--brand);
    font-size: var(--fs-sm);
    margin-bottom: 0.75rem;
  }
  .look-sheet__msg:empty {
    display: none;
  }
  .lb-end {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 2rem;
    padding-block: var(--space-xl);
  }
  @media (max-width: 860px) {
    .look--left,
    .look--right,
    .look--center {
      grid-column: 1 / -1;
      margin-top: 0;
    }
  }
</style>
