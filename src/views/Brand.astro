---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Logo from '../components/Logo.astro';
import Newsletter from '../components/Newsletter.astro';
import { getBrand } from '../lib/shop';
import { localeFromPath, translator } from '../i18n';

const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const brand = getBrand(locale);
const s = brand.story;
const visuals = ['story/1', 'lookbook/3', 'story/3', 'lookbook/6'];
---

<Base
  title={t('La marque', 'About')}
  description={t(
    "dimension., c'est une phrase qu'on porte sur nous : love over everything. Des vêtements brodés et imprimés en petites séries, pour les gens qu'on aime.",
    'dimension. is a sentence we wear: love over everything. Embroidered and printed clothes in small runs, for the people we love.',
  )}
  page="brand"
  route="brand"
>
  <section class="intro wrap">
    <p class="label accent" data-reveal>{s.kicker}</p>
    <h1 class="display intro__title patch" data-split>
      <span class="split-line"><span>{t('Une dimension', 'One more')}</span></span>
      <span class="split-line" style="--l:1"><span>{t('en plus', 'dimension')}<span class="dot" aria-hidden="true"></span></span></span>
    </h1>
    <div class="intro__grid">
      <p class="lede" data-reveal>{s.intro}</p>
      <div class="intro__mark" data-reveal style="--i:1" aria-hidden="true"><Logo variant="mono" /></div>
    </div>
  </section>

  <div class="wide media" data-reveal="clip">
    <div class="wide__img" data-parallax="0.1"><Img k="story/2" sizes="100vw" /></div>
  </div>

  <section class="section wrap chapters" aria-label={t('Notre histoire en quatre chapitres', 'Our story in four chapters')}>
    {
      s.chapters.map((c, i) => (
        <article class:list={['chapter', i % 2 && 'chapter--flip']}>
          <div class="chapter__media media ratio-45" data-reveal="clip">
            <Img k={visuals[i]} sizes="(max-width: 860px) 100vw, 40vw" />
          </div>
          <div class="chapter__copy">
            <span class="chapter__num display" data-reveal>0{i + 1}</span>
            <h2 class="display h-xl" data-reveal style="--i:1">{c.title}</h2>
            <p class="lede" data-reveal style="--i:2">{c.text}</p>
          </div>
        </article>
      ))
    }
  </section>

  <section class="section wrap values" aria-labelledby="values-title">
    <div class="section-head">
      <div>
        <span class="label accent">{t('Ce qui compte pour nous', 'What matters to us')}</span>
        <h2 id="values-title" data-chars class="display h-xl">{t('Nos règles du jeu', 'How we play it')}</h2>
      </div>
    </div>
    <ul class="values__grid" role="list">
      <li data-reveal><span class="label accent">01</span><h3>{t('Peu de pièces, beaucoup d’attention', 'Few pieces, lots of care')}</h3><p class="muted">{t("On préfère cinq pièces qu'on adore à cinquante qu'on oublie. Chaque drop est court, et chaque pièce a une bonne raison d'exister.", "We'd rather make five pieces we love than fifty we forget. Every drop is short, and every piece has a good reason to exist.")}</p></li>
      <li data-reveal style="--i:1"><span class="label accent">02</span><h3>{t('Des pièces qu’on garde', 'Pieces you keep')}</h3><p class="muted">{t("On veut que ton t-shirt tienne la route, lavage après lavage. S'il te déçoit, dis-le nous : on veut le savoir.", "We want your tee to go the distance, wash after wash. If it lets you down, tell us: we want to know.")}</p></li>
      <li data-reveal style="--i:2"><span class="label accent">03</span><h3>{t('Le dessin d’abord', 'Drawing first')}</h3><p class="muted">{t("Tout part d'un trait de crayon. On garde les accidents et les traits qui débordent : c'est ce qui fait que ta pièce ne ressemble pas à celle du rayon d'à côté.", "Everything starts with a pencil line. We keep the accidents and the lines that spill over: that's what makes your piece look nothing like the one on the next rack.")}</p></li>
      <li data-reveal style="--i:3"><span class="label accent">04</span><h3>{t('Une bande, pas des clients', 'A crew, not customers')}</h3><p class="muted">{t('dimension. se construit avec celles et ceux qui la portent. Tes photos, tes retours, tes idées : viens nous parler sur ', 'dimension. grows with the people who wear it. Your photos, your feedback, your ideas: come and talk to us at ')}{brand.handle}.</p></li>
    </ul>
  </section>

  <Newsletter />
</Base>

<style>
  .intro {
    padding-block: var(--space-lg) var(--space-md);
    display: grid;
    gap: 1.5rem;
  }
  .intro__title {
    font-size: clamp(1.8rem, 5.6vw, 6.2rem);
  }
  .intro__grid {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
  }
  .intro__mark {
    font-size: clamp(3rem, 8vw, 7rem);
    color: var(--accent);
  }
  .wide {
    height: clamp(320px, 70vh, 820px);
  }
  .wide__img {
    position: absolute;
    inset: -10% 0;
  }
  .chapters {
    display: grid;
    gap: var(--space-xl);
  }
  .chapter {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: clamp(1.5rem, 6vw, 8rem);
    align-items: center;
  }
  .chapter--flip .chapter__media {
    order: 2;
  }
  .chapter__media {
    border: 2px solid var(--ink);
    border-radius: 16px;
  }
  .chapter__copy {
    display: grid;
    gap: 1.25rem;
  }
  .chapter__num {
    font-size: clamp(3rem, 7vw, 6rem);
    color: transparent;
    -webkit-text-stroke: 1.5px var(--accent);
  }
  .values__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .values__grid li {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-strong);
  }
  .values__grid h3 {
    font-size: var(--fs-md);
  }
  .values__grid p {
    font-size: var(--fs-sm);
  }
  @media (max-width: 860px) {
    .chapter {
      grid-template-columns: 1fr;
    }
    .chapter--flip .chapter__media {
      order: 0;
    }
    .values__grid {
      grid-template-columns: 1fr 1fr;
    }
    .intro__grid {
      flex-direction: column;
      align-items: start;
    }
  }
</style>
