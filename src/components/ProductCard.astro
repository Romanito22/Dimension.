---
import Img from './Img.astro';
import { formatPrice, imageKeys, availableSizes, SIZES, type Product } from '../lib/shop';

interface Props {
  product: Product;
  index?: number;
  vt?: boolean;
  sizes?: string;
}
const { product: p, index = 0, vt = false, sizes = '(max-width: 700px) 50vw, 25vw' } = Astro.props;
const [k1, k2] = imageKeys(p);
const avail = availableSizes(p);
const soldOut = avail.length === 0;
const productSizes = SIZES.filter((s) => p.sizes.some((x) => x.size === s));
---

<article
  class="card"
  data-card
  data-category={p.category}
  data-sizes={avail.join(',')}
  data-colors={p.colors.map((c) => c.slug).join(',')}
  data-price={p.price}
  data-date={p.date}
  data-name={p.name}
  style={`--i:${index % 4}`}
>
  <a href={`/produit/${p.slug}`} class="card__link" aria-label={`${p.name} — ${formatPrice(p.price)}`}>
    <div class="card__media media ratio-45" data-tilt>
      <span class="card__glare" aria-hidden="true"></span>
      <Img k={k1} class="card__img card__img--1" sizes={sizes} vt={vt ? `media-${p.slug}` : undefined} />
      <Img k={k2} class="card__img card__img--2" sizes={sizes} />
      {
        (p.badge || soldOut) && (
          <span class:list={['badge card__badge', p.badge === 'Nouveau' && 'badge--accent', p.badge === 'Best-seller' && 'badge--candy']}>
            {soldOut ? 'Épuisé' : p.badge}
          </span>
        )
      }
      <ul class="card__sizes label" role="list" aria-label="Tailles disponibles">
        {
          productSizes.map((s) => (
            <li class:list={[!avail.includes(s) && 'is-out']}>{s}</li>
          ))
        }
      </ul>
    </div>
    <div class="card__meta">
      <div>
        <h3 class="card__name">{p.name}</h3>
        <p class="card__sub muted">
          {
            p.colors.map((c) => (
              <span class="swatch" style={`background:${c.hex}`} title={c.name} />
            ))
          }
          <span>{p.colors.map((c) => c.name).join(', ')}</span>
        </p>
      </div>
      <p class="card__price">{formatPrice(p.price)}</p>
    </div>
  </a>
</article>

<style>
  .card__link {
    display: block;
  }
  .card__media {
    border-radius: var(--radius);
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.6s var(--ease-out);
  }
  .card__glare {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background: radial-gradient(circle at var(--gx, 50%) var(--gy, 50%), rgb(255 255 255 / 0.4), transparent 55%);
    mix-blend-mode: soft-light;
    opacity: var(--go, 0);
    transition: opacity 0.5s;
  }
  .card__img {
    position: absolute;
    inset: 0;
    transition:
      opacity 0.6s var(--ease-out),
      transform 1.2s var(--ease-out);
  }
  .card__img--2 {
    opacity: 0;
    transform: scale(1.04);
  }
  @media (hover: hover) {
    .card__link:hover .card__img--2 {
      opacity: 1;
      transform: none;
    }
    .card__link:hover .card__img--1 {
      transform: scale(1.03);
    }
    .card__link:hover .card__sizes {
      opacity: 1;
      transform: none;
    }
  }
  .card__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
  }
  .card__sizes {
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem;
    padding: 0.55rem;
    border-radius: var(--radius-pill);
    background: rgb(246 245 242 / 0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    letter-spacing: 0.08em;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.4s var(--ease-out),
      transform 0.4s var(--ease-out);
  }
  .card__sizes li {
    padding: 0 0.35rem;
  }
  .card__sizes .is-out {
    color: var(--muted);
    text-decoration: line-through;
    opacity: 0.6;
  }
  .card__meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.9rem;
  }
  .card__name {
    font-size: var(--fs-sm);
    font-weight: 600;
    line-height: 1.3;
  }
  .card__sub {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.3rem;
    font-size: var(--fs-xs);
  }
  .card__sub .swatch {
    width: 10px;
    height: 10px;
  }
  .card__price {
    font-size: var(--fs-sm);
    font-weight: 600;
    white-space: nowrap;
  }
</style>
