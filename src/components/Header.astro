---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { getBrand } from '../lib/shop';
import { localeFromPath, translator, href, type RouteKey } from '../i18n';

interface Props {
  route?: RouteKey;
  slug?: string;
}
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const brand = getBrand(locale);
const other = locale === 'fr' ? 'en' : 'fr';
const { route = 'home', slug = '' } = Astro.props;
// Lien vers la même page dans l'autre langue (mis à jour à chaque navigation par app.ts)
const switchHref = href(other, route, slug);

const nav = [
  { href: href(locale, 'shop'), label: t('Boutique', 'Shop') },
  { href: href(locale, 'lookbook'), label: 'Lookbook' },
  { href: href(locale, 'brand'), label: t('La marque', 'About') },
];
const menu = [...nav, { href: href(locale, 'account'), label: t('Mon espace', 'My space') }, { href: href(locale, 'track'), label: t('Suivi de commande', 'Track an order') }, { href: href(locale, 'contact'), label: t('Contact & FAQ', 'Contact & FAQ') }];
---

<header class="site-header" data-header transition:persist="site-header">
  <div class="announce" aria-label={t('Informations', 'Information')}>
    <div class="announce__track">
      {
        [0, 1].map((n) => (
          <ul class="announce__list" role="list" aria-hidden={n === 1 ? 'true' : undefined}>
            {brand.marquee.map((m) => (
              <li>
                <span>{m}</span>
                <span class="announce__sep" aria-hidden="true" />
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>

  <div class="bar">
    <div class="wrap bar__inner">
      <nav class="bar__nav" aria-label={t('Navigation principale', 'Main navigation')}>
        <ul role="list">
          {
            nav.map((l) => (
              <li>
                <a class="link label" href={l.href} data-nav>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <a href={href(locale, 'home')} class="bar__logo" aria-label={t('dimension. — accueil', 'dimension. — home')}>
        <Logo />
      </a>

      <div class="bar__actions">
        <a class="bar__lang label" href={switchHref} data-lang-switch data-astro-reload hreflang={other} lang={other} aria-label={t('Read in English', 'Lire en français')}>{other.toUpperCase()}</a>
        <button class="bar__search label" type="button" data-search-open aria-label={t('Rechercher (touche /)', 'Search (press /)')}>
          <svg width="17" height="17" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6.5"></circle><path d="m13.5 13.5 5 5"></path></svg>
          <span class="bar__search-text">{t('Rechercher', 'Search')}</span>
          <kbd class="bar__kbd" aria-hidden="true">/</kbd>
        </button>
        <a class="bar__icon bar__icon--me" href={href(locale, 'account')} data-nav aria-label={t('Mon espace', 'My space')}>
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c.8-4.2 4-6.5 8-6.5s7.2 2.3 8 6.5"></path></svg>
        </a>
        <a class="bar__icon" href={href(locale, 'wishlist')} data-nav aria-label={t('Favoris', 'Wishlist')}>
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 20.5S3 15 3 8.8C3 6 5.2 4 7.8 4c1.7 0 3.2.9 4.2 2.3C13 4.9 14.5 4 16.2 4 18.8 4 21 6 21 8.8c0 6.2-9 11.7-9 11.7z"></path></svg>
          <span class="bar__badge" data-wish-count hidden>0</span>
        </a>
        <button class="bar__cart label" type="button" data-cart-open aria-haspopup="dialog" aria-controls="cart-drawer">
          <span>{t('Panier', 'Bag')}</span>
          <span class="bar__count" data-cart-count>0</span>
        </button>
        <button
          class="burger"
          type="button"
          data-open="menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={t('Ouvrir le menu', 'Open menu')}
          data-label-open={t('Ouvrir le menu', 'Open menu')}
          data-label-close={t('Fermer le menu', 'Close menu')}
        >
          <span></span><span></span>
        </button>
      </div>
    </div>
  </div>

  <dialog class="sheet menu theme-brand" id="mobile-menu" data-menu data-dialog="menu" aria-label={t('Menu', 'Menu')}>
    <div class="menu__head wrap">
      <a href={href(locale, 'home')} class="menu__logo" aria-label={t('dimension. — accueil', 'dimension. — home')}><Logo /></a>
      <button type="button" class="icon-btn menu__close" data-close aria-label={t('Fermer le menu', 'Close menu')}>
        <Icon name="close" size={22} />
      </button>
    </div>
    <nav class="wrap menu__inner" aria-label={t('Menu mobile', 'Mobile menu')}>
      <ul role="list" class="menu__list">
        {
          menu.map((l, i) => (
            <li style={`--i:${i}`}>
              <a href={l.href} class="display menu__link" data-nav>
                <span class="menu__index label">0{i + 1}</span>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="menu__foot">
        <p class="label muted">{brand.tagline}</p>
        <button type="button" class="label link link--under menu__help" data-open="help">{t('Besoin d’aide ?', 'Need help?')}</button>
        <a class="label menu__lang" href={switchHref} data-lang-switch data-astro-reload hreflang={other} lang={other}>{other === 'en' ? 'English' : 'Français'} →</a>
        <ul role="list" class="menu__socials">
          {
            brand.socials.map((s) => (
              <li>
                <a class="link label" href={s.url} target="_blank" rel="noopener">
                  {s.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>
  </dialog>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    color: var(--fg);
    transition: transform 0.5s var(--ease-out);
  }
  .site-header.is-hidden {
    transform: translateY(calc(-100% + 0px));
  }

  /* Bandeau défilant */
  .announce {
    background: var(--brand);
    color: #fff;
    border-bottom: 2px solid var(--ink);
    height: 32px;
    overflow: hidden;
    display: flex;
    align-items: center;
  }
  .announce__track {
    display: flex;
    width: max-content;
    animation: marquee 38s linear infinite;
  }
  .announce:hover .announce__track {
    animation-play-state: paused;
  }
  .announce__list {
    display: flex;
    align-items: center;
  }
  .announce__list li {
    display: flex;
    align-items: center;
    font-family: var(--f-mono);
    font-weight: 600;
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .announce__sep {
    width: 7px;
    height: 7px;
    border: 1.3px solid currentColor;
    border-radius: 50%;
    margin-inline: 2.2rem;
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* Barre principale */
  .bar {
    background: var(--bg);
    border-bottom: 2px solid var(--ink);
    transition:
      background 0.4s,
      color 0.4s,
      border-color 0.4s;
  }
  :global(body[data-header='overlay']) .site-header:not(.is-scrolled) .bar {
    background: transparent;
    border-color: transparent;
    color: #fff;
  }
  .bar__inner {
    height: var(--header-h);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }
  .bar__nav ul {
    display: flex;
    gap: clamp(1rem, 2.4vw, 2.4rem);
  }
  .bar__logo {
    font-size: 1.5rem;
    display: inline-flex;
    transition: opacity 0.3s;
  }
  .bar__logo:hover {
    opacity: 0.75;
  }
  .bar__actions {
    display: flex;
    align-items: center;
    justify-content: end;
    gap: clamp(1rem, 2.4vw, 2.4rem);
  }
  .bar__lang {
    display: inline-grid;
    place-items: center;
    min-width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1.5px solid transparent;
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .bar__lang:hover {
    border-color: currentColor;
    color: var(--brand);
  }
  .bar__search {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 40px;
    padding: 0 0.6rem 0 0.75rem;
    border: 1.5px solid currentColor;
    border-radius: 999px;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .bar__search:hover {
    background: var(--brand);
    border-color: var(--brand);
    color: #fff;
  }
  .bar__kbd {
    font-family: var(--f-mono);
    font-size: 0.625rem;
    min-width: 18px;
    height: 18px;
    display: grid;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 4px;
    opacity: 0.7;
  }
  .bar__icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    transition: color 0.2s;
  }
  .bar__icon:hover,
  .bar__icon[aria-current='page'] {
    color: var(--brand);
  }
  .bar__badge {
    position: absolute;
    top: 2px;
    right: 0;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    border-radius: 999px;
    background: var(--brand);
    color: #fff;
    border: 1.5px solid var(--ink);
    font-family: var(--f-mono);
    font-size: 0.5625rem;
    display: grid;
    place-items: center;
  }
  .bar__cart {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
  }
  .bar__count {
    display: inline-grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 999px;
    border: 1.3px solid currentColor;
    letter-spacing: 0;
    font-size: 0.625rem;
    transition:
      background 0.3s,
      color 0.3s,
      transform 0.4s var(--ease-out);
  }
  .bar__count.has-items {
    background: var(--brand);
    border-color: var(--ink);
    color: #fff;
  }
  .bar__count.bump {
    animation: bump 0.6s var(--ease-out);
  }
  @keyframes bump {
    40% {
      transform: scale(1.35);
    }
  }

  .burger {
    display: none;
    width: 44px;
    height: 44px;
    position: relative;
    margin-right: -10px;
  }
  .burger span {
    position: absolute;
    left: 11px;
    right: 11px;
    height: 1.5px;
    background: currentColor;
    transition:
      transform 0.45s var(--ease-out),
      top 0.45s var(--ease-out);
  }
  .burger span:first-child {
    top: 18px;
  }
  .burger span:last-child {
    top: 25px;
  }
  .burger[aria-expanded='true'] span:first-child {
    top: 21.5px;
    transform: rotate(45deg);
  }
  .burger[aria-expanded='true'] span:last-child {
    top: 21.5px;
    transform: rotate(-45deg);
  }

  /* Menu mobile : panneau plein écran framboise */
  .menu {
    width: 100%;
    background: var(--brand);
    color: #fff;
    border: 0;
    overflow-y: auto;
  }
  .menu__head {
    height: calc(32px + var(--header-h));
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 2px solid var(--ink);
    font-size: 1.3rem;
  }
  .menu__close {
    width: 44px;
    height: 44px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--cotton);
    color: var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
  }
  .menu__inner {
    min-height: calc(100% - 32px - var(--header-h));
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-block: 1.5rem 2rem;
  }
  .menu__list li {
    border-bottom: 2px dashed rgb(255 255 255 / 0.45);
    animation: item-in 0.55s var(--ease-out) both;
    animation-delay: calc(var(--i) * 55ms + 80ms);
  }
  @keyframes item-in {
    from {
      opacity: 0;
      transform: translateX(-24px) rotate(-2deg);
    }
  }
  .menu__link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    font-size: clamp(1.6rem, 8.5vw, 3rem);
    padding-block: 0.9rem;
    color: #fff;
    -webkit-text-stroke: 1.5px var(--ink);
    text-shadow: 3px 3px 0 var(--ink);
  }
  .menu__link[aria-current='page'] {
    color: var(--cotton);
    -webkit-text-stroke: 0;
    text-shadow: 3px 3px 0 var(--ink);
  }
  .menu__index {
    color: var(--ink);
    -webkit-text-stroke: 0;
    text-shadow: none;
  }
  .menu__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
    padding-top: 2rem;
  }
  .menu__foot .muted {
    color: rgb(255 255 255 / 0.8);
  }
  .menu__lang {
    color: var(--ink);
  }
  .menu__socials {
    display: flex;
    gap: 1.25rem;
  }

  @media (max-width: 860px) {
    .bar__nav,
    .bar__lang,
    .bar__icon--me {
      display: none;
    }
    .bar__search {
      border: 0;
      padding: 0;
      width: 40px;
      justify-content: center;
    }
    .bar__search-text,
    .bar__kbd {
      display: none;
    }
    .burger {
      display: block;
    }
    .bar__inner {
      grid-template-columns: auto 1fr;
    }
    .bar__logo {
      font-size: 1.3rem;
    }
    .bar__cart span:first-child {
      display: none;
    }
  }
</style>
