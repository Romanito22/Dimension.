---
import Base from '../layouts/Base.astro';
import { localeFromPath, translator, type RouteKey } from '../i18n';

interface Props {
  title: string;
  updated: string;
  route?: RouteKey;
}
const { title, updated, route } = Astro.props;
const t = translator(localeFromPath(Astro.url.pathname));
---

<Base title={title} page="legal" route={route}>
  <article class="wrap legal">
    <header class="legal__head">
      <p class="label accent">{t('Informations légales', 'Legal information')}</p>
      <h1 class="display h-xl patch">{title}</h1>
      <p class="label muted">{t('Mise à jour : ', 'Last updated: ')}{updated}</p>
    </header>
    <div class="prose legal__body">
      <slot />
    </div>
  </article>
</Base>

<style>
  .legal {
    padding-block: var(--space-lg);
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-lg);
  }
  .legal__head {
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .legal__body :global(mark) {
    background: var(--accent-soft);
    color: var(--accent-deep);
    padding: 0 0.2em;
  }
  @media (max-width: 860px) {
    .legal {
      grid-template-columns: 1fr;
    }
  }
</style>
