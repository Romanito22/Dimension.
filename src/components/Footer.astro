---
import Logo from './Logo.astro';
import Sticker from './Sticker.astro';
import { getBrand, formatPrice } from '../lib/shop';
import { localeFromPath, translator, href } from '../i18n';

const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const brand = getBrand(locale);
const h = (k: Parameters<typeof href>[1], rest = '') => href(locale, k) + rest;
const other = locale === 'fr' ? 'en' : 'fr';

const year = new Date().getFullYear();
const cols = [
  {
    title: t('Boutique', 'Shop'),
    links: [
      { href: h('shop'), label: t('Tout le Drop 01', 'All of Drop 01') },
      { href: h('shop', '?categorie=t-shirts'), label: 'T-shirts' },
      { href: h('shop', '?categorie=maille'), label: t('Maille', 'Knitwear') },
      { href: h('lookbook'), label: 'Lookbook' },
    ],
  },
  {
    title: t('Aide', 'Help'),
    links: [
      { open: 'help', label: t('Centre d’aide', 'Help centre') },
      { href: h('contact', '#faq'), label: 'FAQ' },
      { href: h('contact', '#guide-des-tailles'), label: t('Guide des tailles', 'Size guide') },
      { href: h('track'), label: t('Suivi de commande', 'Track an order') },
      { href: h('account'), label: t('Mon espace', 'My space') },
      { href: h('contact'), label: t('Nous écrire', 'Contact us') },
    ],
  },
  {
    title: 'dimension.',
    links: [
      { href: h('brand'), label: t('La marque', 'About') },
      { href: h('terms'), label: t('CGV', 'Terms of sale') },
      { href: h('legal'), label: t('Mentions légales', 'Legal notice') },
      { href: h('legal', '#confidentialite'), label: t('Confidentialité', 'Privacy') },
    ],
  },
];
---

<footer class="footer theme-dark cv">
  <div class="wrap">
    <div class="footer__top">
      <p class="footer__claim display">
        <Sticker class="footer__sticker" ring="Love over everything · dimension." core="d°" size={120} rot={-14} />
        Love<br />over<br /><span class="footer__candy">everything<span class="dot" aria-hidden="true"></span></span>
      </p>
      <div class="footer__cols">
        {
          cols.map((c) => (
            <div>
              <p class="label footer__title">{c.title}</p>
              <ul role="list">
                {c.links.map((l) => (
                  <li>
                    {'open' in l ? (
                      <button type="button" class="link" data-open={l.open}>
                        {l.label}
                      </button>
                    ) : (
                      <a class="link" href={l.href}>
                        {l.label}
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        <div>
          <p class="label footer__title">{t('Suivre', 'Follow')}</p>
          <ul role="list">
            {
              brand.socials.map((s) => (
                <li>
                  <a class="link" href={s.url} target="_blank" rel="noopener">
                    {s.name}
                  </a>
                </li>
              ))
            }
            <li><a class="link" href={`mailto:${brand.email}`}>{brand.email}</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer__brand" aria-hidden="true">
      <Logo variant="lockup" />
    </div>

    <div class="footer__bottom label">
      <span>© {year} {brand.legalName}</span>
      <span>{t('Paiement sécurisé · Livraison offerte dès ', 'Secure payment · Free delivery from ')}{formatPrice(brand.shipping.freeThreshold, locale)}</span>
      <a class="link" href={href(other, 'home')} data-lang-switch data-astro-reload hreflang={other} lang={other}>{other === 'en' ? 'English' : 'Français'}</a>
      <a href="#top" class="link" data-to-top>{t('Haut de page ↑', 'Back to top ↑')}</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-2);
    color: var(--fg);
    border-top: 1px solid var(--line);
    padding-top: var(--space-lg);
    overflow: hidden;
  }
  .footer__top {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-md);
    padding-bottom: var(--space-lg);
  }
  .footer__claim :global(.footer__sticker) {
    position: absolute;
    left: clamp(9rem, 20vw, 17rem);
    top: -1.5rem;
  }
  .footer__claim {
    position: relative;
    font-size: clamp(1.5rem, 2.8vw, 2.7rem);
  }
  .footer__candy {
    color: var(--accent);
  }
  .footer__cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .footer__title {
    color: rgb(var(--fg-rgb) / 0.5);
    margin-bottom: 1.1rem;
  }
  .footer__cols ul {
    display: grid;
    gap: 0.55rem;
    font-size: var(--fs-sm);
  }
  .footer__brand {
    font-size: clamp(2.6rem, 10.5vw, 11rem);
    line-height: 0.9;
    display: flex;
    justify-content: center;
    padding-block: 0.1em 0.18em;
    border-top: 1px solid rgb(var(--fg-rgb) / 0.14);
    color: var(--fg);
    text-shadow: 0.05em 0.05em 0 var(--brand);
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid rgb(var(--fg-rgb) / 0.14);
    color: rgb(var(--fg-rgb) / 0.6);
  }
  @media (max-width: 960px) {
    .footer__top {
      grid-template-columns: 1fr;
    }
    .footer__cols {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 2.25rem;
    }
  }
</style>
