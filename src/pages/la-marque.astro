---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Logo from '../components/Logo.astro';
import Newsletter from '../components/Newsletter.astro';
import brand from '../data/brand.json';

const s = brand.story;
const visuals = ['story/1', 'lookbook/3', 'story/3', 'lookbook/6'];
---

<Base title="La marque" description="dimension. — notre histoire : des vêtements brodés et imprimés en séries courtes, une seule règle : love over everything." page="brand">
  <section class="intro wrap">
    <p class="label accent" data-reveal>{s.kicker}</p>
    <h1 class="display intro__title" data-split>
      <span class="split-line"><span>Une dimension</span></span>
      <span class="split-line" style="--l:1"><span>en plus<span class="dot" aria-hidden="true"></span></span></span>
    </h1>
    <div class="intro__grid">
      <p class="lede" data-reveal>{s.intro}</p>
      <div class="intro__mark" data-reveal style="--i:1" aria-hidden="true"><Logo variant="mono" /></div>
    </div>
  </section>

  <div class="wide media" data-reveal="clip">
    <div class="wide__img" data-parallax="0.1"><Img k="story/2" sizes="100vw" /></div>
  </div>

  <section class="section wrap chapters" aria-label="Notre histoire en quatre chapitres">
    {
      s.chapters.map((c, i) => (
        <article class:list={['chapter', i % 2 && 'chapter--flip']}>
          <div class="chapter__media media ratio-45" data-reveal="clip">
            <Img k={visuals[i]} sizes="(max-width: 860px) 100vw, 40vw" />
          </div>
          <div class="chapter__copy">
            <span class="chapter__num display" data-reveal>0{i + 1}</span>
            <h2 class="display h-xl" data-reveal style="--i:1">{c.title}</h2>
            <p class="lede" data-reveal style="--i:2">{c.text}</p>
          </div>
        </article>
      ))
    }
  </section>

  <section class="manifesto" aria-label="Manifeste">
    <div class="wrap">
      <p class="display manifesto__text" data-reveal>
        On ne fait pas des vêtements pour remplir des placards. On les fait pour qu'ils <span class="manifesto__candy">racontent quelque chose</span> — et qu'on les garde.
      </p>
      <p class="manifesto__sign">
        <span class="script">dimension</span><span class="manifesto__point">.</span> — {brand.tagline}
      </p>
    </div>
  </section>

  <section class="section wrap values" aria-labelledby="values-title">
    <div class="section-head">
      <div>
        <span class="label accent">Ce qu'on défend</span>
        <h2 id="values-title" class="display h-xl">Nos engagements</h2>
      </div>
    </div>
    <ul class="values__grid" role="list">
      <li data-reveal><span class="label accent">01</span><h3>Moins, mais mieux</h3><p class="muted">Des drops courts plutôt qu'un catalogue infini. Chaque pièce est pensée, dessinée, testée.</p></li>
      <li data-reveal style="--i:1"><span class="label accent">02</span><h3>Des matières qui durent</h3><p class="muted">Cotons épais, broderies denses, encres résistantes : des pièces qui vieillissent bien.</p></li>
      <li data-reveal style="--i:2"><span class="label accent">03</span><h3>Fait à la main d'abord</h3><p class="muted">Chaque graphisme naît d'un dessin. On garde le trait, l'accident, la main.</p></li>
      <li data-reveal style="--i:3"><span class="label accent">04</span><h3>Une communauté</h3><p class="muted">On construit dimension. avec celles et ceux qui la portent — retrouve-nous sur {brand.handle}.</p></li>
    </ul>
  </section>

  <Newsletter />
</Base>

<style>
  .intro {
    padding-block: var(--space-lg) var(--space-md);
    display: grid;
    gap: 1.5rem;
  }
  .intro__title {
    font-size: clamp(2.6rem, 9vw, 10rem);
  }
  .intro__grid {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
  }
  .intro__mark {
    font-size: clamp(3rem, 8vw, 7rem);
    color: var(--framboise);
  }
  .wide {
    height: clamp(320px, 70vh, 820px);
  }
  .wide__img {
    position: absolute;
    inset: -10% 0;
  }
  .chapters {
    display: grid;
    gap: var(--space-xl);
  }
  .chapter {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: clamp(1.5rem, 6vw, 8rem);
    align-items: center;
  }
  .chapter--flip .chapter__media {
    order: 2;
  }
  .chapter__media {
    border-radius: var(--radius);
  }
  .chapter__copy {
    display: grid;
    gap: 1.25rem;
  }
  .chapter__num {
    font-size: clamp(3rem, 7vw, 6rem);
    color: transparent;
    -webkit-text-stroke: 1.5px var(--framboise);
  }
  .manifesto {
    background: var(--framboise);
    color: var(--cotton);
    padding-block: var(--space-xl);
  }
  .manifesto__text {
    font-size: clamp(1.75rem, 4.4vw, 4.5rem);
    line-height: 1;
    max-width: 22ch;
  }
  .manifesto__candy {
    color: var(--candy);
  }
  .manifesto__sign {
    margin-top: var(--space-md);
    font-size: var(--fs-md);
  }
  .manifesto__sign .script {
    font-size: 1.8em;
  }
  .manifesto__point {
    color: var(--candy);
    font-size: 1.8em;
  }
  .values__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .values__grid li {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-strong);
  }
  .values__grid h3 {
    font-size: var(--fs-md);
  }
  .values__grid p {
    font-size: var(--fs-sm);
  }
  @media (max-width: 860px) {
    .chapter {
      grid-template-columns: 1fr;
    }
    .chapter--flip .chapter__media {
      order: 0;
    }
    .values__grid {
      grid-template-columns: 1fr 1fr;
    }
    .intro__grid {
      flex-direction: column;
      align-items: start;
    }
  }
</style>
