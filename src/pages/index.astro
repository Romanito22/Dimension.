---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import Img from '../components/Img.astro';
import Logo from '../components/Logo.astro';
import Newsletter from '../components/Newsletter.astro';
import { media } from '../lib/media';
import { products, brand, byNewest, formatPrice } from '../lib/shop';

const ogImage = media('hero/desktop');
const teeBack = media('cutout/love-back');
const teeFront = media('cutout/love-front');
const latest = byNewest(products);
const signature = products.find((p) => p.art === 'love')!;
const tshirtCount = products.filter((p) => p.category === 't-shirts').length;
const knitCount = products.filter((p) => p.category === 'maille').length;
const socialHandle = brand.handle;
const tiktok = brand.socials.find((s) => s.name === 'TikTok')!.url;
const sigUrl = `/produit/${signature.slug}`;
---

<Base header="overlay" page="home" image={ogImage.src}>
  <!-- HERO -->
  <section class="hx" data-hero aria-labelledby="hero-title">
    <div class="hx__bg" aria-hidden="true">
      <span class="blob blob--1"></span>
      <span class="blob blob--2"></span>
      <span class="blob blob--3"></span>
      <span class="blob blob--cursor" data-blob></span>
    </div>

    <div class="wrap hx__meta">
      <p class="label">{brand.drop.name} — {brand.drop.season}</p>
      <p class="label hx__handle">{socialHandle}</p>
    </div>

    <h1 id="hero-title" class="hx__love display" data-layer="-0.6">
      <span class="visually-hidden">Love over everything</span>
      <span class="hx__letters" aria-hidden="true">
        {['L', 'O', 'V', 'E'].map((c, i) => <span style={`--c:${i}`}>{c}</span>)}
      </span>
    </h1>

    <div class="hx__stage" data-layer="1">
      <div class="hx__float">
        <div class="hx__tee" data-hero-tee>
          <img src={teeBack.src} alt={teeBack.alt} width={teeBack.width} height={teeBack.height} fetchpriority="high" />
          <a href={sigUrl} class="hotspot" style="left:50%;top:46%">
            <span class="hotspot__dot" aria-hidden="true"></span>
            <span class="hotspot__tag"><span class="label">Print LOVE</span> {signature.name} — {formatPrice(signature.price)}</span>
          </a>
        </div>
      </div>
      <span class="hx__shadow" aria-hidden="true"></span>
    </div>

    <p class="hx__over display" aria-hidden="true" data-layer="1.6">Over everything<span class="dot"></span></p>

    <div class="wrap hx__foot">
      <p class="hx__lede">Streetwear brodé et imprimé en séries courtes. Des cotons épais, des graphismes faits main — et une seule règle.</p>
      <a href="#drop" class="hx__scroll label" aria-label="Défiler vers les nouveautés">
        <span class="hx__scroll-ring" aria-hidden="true"></span>Scroll
      </a>
      <div class="hx__ctas">
        <a href="/boutique" class="btn btn--lg">Shop le drop <span class="btn__dot" aria-hidden="true"></span></a>
        <a href="/lookbook" class="btn btn--ghost btn--lg">Lookbook</a>
      </div>
    </div>
  </section>

  <!-- NOUVEAUTÉS : défilement horizontal -->
  <section id="drop" class="hs" data-hscroll aria-labelledby="drop-title">
    <div class="hs__sticky">
      <div class="wrap hs__head">
        <div>
          <span class="label accent">{brand.drop.name} · {products.length} pièces</span>
          <h2 id="drop-title" class="display h-xl" data-chars>Nouveautés</h2>
        </div>
        <a href="/boutique" class="link link--under label">Tout voir</a>
      </div>
      <div class="hs__viewport">
        <div class="hs__track" data-hs-track>
          <div class="hs__intro">
            <p class="display hs__big">5 pièces.<br /><span class="accent">Séries courtes.</span></p>
            <p class="muted">Brodées, imprimées, tricotées. Quand c'est parti, c'est parti.</p>
            <span class="label hs__hint" aria-hidden="true">Continue de scroller <span class="hs__arrow">→</span></span>
          </div>
          {
            latest.map((p, i) => (
              <div class="hs__item" style={`--i:${i}`}>
                <span class="hs__num display" aria-hidden="true">0{i + 1}</span>
                <ProductCard product={p} index={i} vt sizes="(max-width: 860px) 74vw, 26vw" />
              </div>
            ))
          }
          <a href="/boutique" class="hs__end" data-cursor="Boutique">
            <span class="hs__end-ring" aria-hidden="true"></span>
            <span class="display">Toute la<br />boutique →</span>
          </a>
        </div>
      </div>
      <div class="wrap hs__bar"><span data-hs-progress></span></div>
    </div>
  </section>

  <!-- PIÈCE SIGNATURE : devant / dos au scroll -->
  <section class="flip" data-flip aria-labelledby="flip-title">
    <div class="flip__sticky">
      <div class="wrap flip__grid">
        <div class="flip__copy">
          <span class="label accent">La pièce signature</span>
          <h2 id="flip-title" class="display flip__title">Love over<br />everything</h2>
          <ol class="flip__steps" role="list">
            <li data-flip-step="0" class="is-active">
              <span class="flip__n display">01</span>
              <div><strong>Monogramme brodé</strong><p>Le « d° » au point plein, fil framboise cerné de noir, côté cœur.</p></div>
            </li>
            <li data-flip-step="1">
              <span class="flip__n display">02</span>
              <div><strong>Jersey 240 g/m²</strong><p>Coton épais, col côtelé, épaules tombées : la coupe boxy qui tient.</p></div>
            </li>
            <li data-flip-step="2">
              <span class="flip__n display">03</span>
              <div><strong>Le cœur LOVE</strong><p>Imprimé au dos en deux tons, gonflé comme une bulle. Signé over everything.</p></div>
            </li>
          </ol>
          <div class="flip__buy">
            <span class="flip__price display">{formatPrice(signature.price)}</span>
            <a href={sigUrl} class="btn btn--accent btn--lg">Je le veux <span class="btn__dot" aria-hidden="true"></span></a>
          </div>
        </div>

        <div class="flip__stage">
          <svg class="flip__ring" viewBox="0 0 100 100" aria-hidden="true">
            <circle cx="50" cy="50" r="48" pathLength="1"></circle>
            <circle class="flip__ring-p" cx="50" cy="50" r="48" pathLength="1"></circle>
          </svg>
          <span class="flip__side display" aria-hidden="true"><span data-flip-side>Devant</span></span>
          <div class="flip__card" data-flip-card>
            <div class="flip__face flip__face--front">
              <img src={teeFront.src} alt={teeFront.alt} width={teeFront.width} height={teeFront.height} loading="lazy" />
              <span class="flip__pin" style="left:50%;top:36%" aria-hidden="true"></span>
            </div>
            <div class="flip__face flip__face--back">
              <img src={teeBack.src} alt={teeBack.alt} width={teeBack.width} height={teeBack.height} loading="lazy" />
              <span class="flip__pin" style="left:50%;top:46%" aria-hidden="true"></span>
            </div>
          </div>
          <span class="flip__count label" aria-hidden="true"><span data-flip-count>01</span> / 03</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CATÉGORIES -->
  <section class="section cats" aria-labelledby="cats-title">
    <div class="wrap">
      <div class="section-head">
        <div data-reveal>
          <span class="label accent">Explorer</span>
          <h2 id="cats-title" class="display h-xl" data-chars>Le vestiaire</h2>
        </div>
      </div>
      <div class="cats__grid">
        <a href="/boutique?categorie=t-shirts" class="cat cat--a" data-reveal="clip" data-cursor="Explorer">
          <div class="media cat__media"><Img k="categories/t-shirts" sizes="(max-width: 860px) 100vw, 45vw" /></div>
          <div class="cat__meta">
            <h3 class="display cat__title">T-shirts</h3>
            <span class="label">{tshirtCount} pièces →</span>
          </div>
        </a>
        <a href="/boutique?categorie=maille" class="cat cat--b" data-reveal="clip" style="--i:1" data-cursor="Explorer">
          <div class="media cat__media"><Img k="categories/maille" sizes="(max-width: 860px) 50vw, 30vw" /></div>
          <div class="cat__meta">
            <h3 class="display cat__title">Maille</h3>
            <span class="label">{knitCount} pièce →</span>
          </div>
        </a>
        <a href="/lookbook" class="cat cat--c" data-reveal="clip" style="--i:2" data-cursor="Voir">
          <div class="media cat__media"><Img k="categories/love" sizes="(max-width: 860px) 50vw, 25vw" /></div>
          <div class="cat__meta">
            <h3 class="display cat__title">Lookbook</h3>
            <span class="label">{brand.drop.name} →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- BANDEAU SCRIPT -->
  <div class="ribbon-wrap" aria-hidden="true"><div class="ribbon">
    <div class="ribbon__track">
      {
        [0, 1].map(() => (
          <div class="ribbon__set">
            <span class="ribbon__word">dimension</span>
            <span class="ribbon__ring" />
            <span class="ribbon__caps display">Love over everything</span>
            <span class="ribbon__ring" />
            <span class="ribbon__word">dimension</span>
            <span class="ribbon__ring" />
            <span class="ribbon__caps display">{brand.drop.name}</span>
            <span class="ribbon__ring" />
          </div>
        ))
      }
    </div>
  </div></div>

  <!-- STORY -->
  <section class="section story" aria-labelledby="story-title">
    <div class="wrap story__grid">
      <div class="story__copy">
        <span class="label accent" data-reveal>{brand.story.kicker}</span>
        <h2 id="story-title" class="display h-xl" data-reveal style="--i:1">{brand.story.title}</h2>
        <p class="lede" data-reveal style="--i:2">{brand.story.intro}</p>
        <a href="/la-marque" class="btn btn--ghost" data-reveal style="--i:3">Notre histoire <span class="btn__dot" aria-hidden="true"></span></a>
      </div>
      <div class="story__visual">
        <div class="media ratio-45 story__img" data-reveal="clip">
          <Img k="story/1" sizes="(max-width: 860px) 100vw, 40vw" />
        </div>
        <div class="story__badge" aria-hidden="true">
          <Logo variant="mono" />
        </div>
      </div>
    </div>
    <ul class="wrap story__facts" role="list">
      <li data-reveal><span class="display">Brodé</span><span class="muted">monogramme au point plein</span></li>
      <li data-reveal style="--i:1"><span class="display">240 g/m²</span><span class="muted">jersey de coton épais</span></li>
      <li data-reveal style="--i:2"><span class="display">Séries</span><span class="muted">courtes, par drops</span></li>
      <li data-reveal style="--i:3"><span class="display">14 j</span><span class="muted">pour changer d'avis</span></li>
    </ul>
  </section>

  <!-- LOOKBOOK TEASER -->
  <section class="look" aria-labelledby="look-title">
    <a href="/lookbook" class="look__hero media" data-cursor="Lookbook">
      <div class="look__img" data-parallax="0.12"><Img k="lookbook/1" sizes="100vw" /></div>
      <div class="look__overlay">
        <div class="wrap">
          <span class="label">{brand.drop.name} — Lookbook</span>
          <h2 id="look-title" class="display h-2xl" data-split>
            <span class="split-line"><span>Sous le</span></span>
            <span class="split-line" style="--l:1"><span>soleil<span class="dot" aria-hidden="true"></span></span></span>
          </h2>
        </div>
      </div>
    </a>
  </section>

  <!-- SOCIAL -->
  <section class="section social" aria-labelledby="social-title">
    <div class="wrap">
      <div class="section-head social__head">
        <div data-reveal>
          <span class="label accent">On se retrouve là-bas</span>
          <h2 id="social-title" class="display h-xl" data-chars>{socialHandle}</h2>
        </div>
        <a href={tiktok} target="_blank" rel="noopener" class="btn btn--ghost" data-reveal>Suivre sur TikTok</a>
      </div>
      <ul class="social__grid" role="list">
        {
          [1, 2, 3, 4, 5, 6].map((n) => (
            <li data-reveal style={`--i:${n - 1}`}>
              <a href={tiktok} target="_blank" rel="noopener" class="social__item media ratio-11" aria-label={`Publication ${n} sur TikTok`}>
                <Img k={`social/${n}`} sizes="(max-width: 700px) 33vw, 16vw" />
                <span class="social__hover" aria-hidden="true">
                  <svg width="22" height="24" viewBox="0 0 22 24" fill="currentColor"><path d="M16 0c.4 3 2.3 5 5.6 5.3v3.9c-2 .1-3.8-.5-5.6-1.6V16c0 9.6-10.5 10.2-13.5 4.7C.3 17 1.6 10.8 8.6 10.6v4.1c-.6.1-1.1.2-1.6.4-1.4.5-2.2 1.4-2 3 .4 3 6.1 4 5.6-2V0z"></path></svg>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Newsletter />
</Base>

<style>
  /* ================= HERO ================= */
  .hx {
    --mx: 0;
    --my: 0;
    --sp: 0;
    position: relative;
    min-height: max(100svh, 700px);
    background: var(--candy);
    color: var(--framboise-deep);
    overflow: hidden;
    isolation: isolate;
    display: grid;
    grid-template-rows: auto 1fr auto;
  }
  .hx__bg {
    position: absolute;
    inset: -10%;
    z-index: -1;
  }
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    will-change: transform;
  }
  .blob--1 {
    width: 55vw;
    height: 55vw;
    left: -8%;
    top: 5%;
    background: #f8cfe3;
    animation: drift-a 19s ease-in-out infinite alternate;
  }
  .blob--2 {
    width: 46vw;
    height: 46vw;
    right: -6%;
    bottom: -4%;
    background: #e5719f;
    opacity: 0.75;
    animation: drift-b 23s ease-in-out infinite alternate;
  }
  .blob--3 {
    width: 30vw;
    height: 30vw;
    left: 40%;
    top: 55%;
    background: #fbe6f0;
    animation: drift-a 16s ease-in-out infinite alternate-reverse;
  }
  .blob--cursor {
    width: 26vw;
    height: 26vw;
    left: 0;
    top: 0;
    margin: -13vw 0 0 -13vw;
    background: var(--framboise);
    opacity: 0.32;
    filter: blur(80px);
    transform: translate3d(var(--bx, 50vw), var(--by, 50vh), 0);
  }
  @keyframes drift-a {
    to {
      transform: translate3d(12vw, 8vh, 0) scale(1.15);
    }
  }
  @keyframes drift-b {
    to {
      transform: translate3d(-14vw, -10vh, 0) scale(0.9);
    }
  }
  .hx__meta {
    position: relative;
    z-index: 3;
    width: 100%;
    display: flex;
    justify-content: space-between;
    padding-top: calc(var(--header-total) + 1.25rem);
  }
  .hx__love {
    position: absolute;
    left: 50%;
    top: 47%;
    z-index: 0;
    margin: 0;
    font-size: clamp(8rem, 27vw, 34rem);
    line-height: 0.78;
    letter-spacing: -0.045em;
    color: var(--framboise);
    white-space: nowrap;
    transform: translate(-50%, -50%) translate3d(calc(var(--mx) * -14px), calc(var(--my) * -10px), 0) scale(calc(1 + var(--sp) * 0.25));
    opacity: calc(1 - var(--sp) * 0.9);
  }
  .hx__letters {
    display: flex;
    overflow: hidden;
    padding-top: 0.04em;
  }
  .hx__letters span {
    display: block;
    transform: translateY(105%);
    transition: transform 1.3s var(--ease-out);
    transition-delay: calc(var(--c) * 90ms + 150ms);
  }
  .hx.is-ready .hx__letters span {
    transform: none;
  }
  .hx__stage {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 1;
    width: min(44vw, 74vh, 660px);
    aspect-ratio: 4 / 5;
    transform: translate(-50%, -50%) translate3d(calc(var(--mx) * 22px), calc(var(--my) * 16px + var(--sp) * -140px), 0);
    perspective: 1200px;
  }
  .hx__float {
    width: 100%;
    height: 100%;
    opacity: 0;
    transform: translateY(80px) rotate(-14deg) scale(0.82);
    transition:
      opacity 1s var(--ease-out),
      transform 1.6s cubic-bezier(0.2, 1.3, 0.3, 1);
    transition-delay: 0.45s;
  }
  .hx.is-ready .hx__float {
    opacity: 1;
    transform: none;
    animation: float 6s ease-in-out 2.2s infinite;
  }
  @keyframes float {
    0%,
    100% {
      translate: 0 0;
      rotate: 0deg;
    }
    50% {
      translate: 0 -14px;
      rotate: 1.4deg;
    }
  }
  .hx__tee {
    position: relative;
    width: 100%;
    height: 100%;
    transform: rotateY(calc(var(--mx) * 14deg)) rotateX(calc(var(--my) * -10deg)) rotate(-6deg);
    transition: transform 0.2s linear;
    transform-style: preserve-3d;
  }
  .hx__tee img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 30px 40px rgb(126 15 58 / 0.28));
  }
  .hx__shadow {
    position: absolute;
    left: 20%;
    right: 20%;
    bottom: 12%;
    height: 7%;
    border-radius: 50%;
    background: rgb(126 15 58 / 0.3);
    filter: blur(22px);
    z-index: -1;
  }
  .hx__over {
    position: absolute;
    left: 50%;
    bottom: clamp(7.5rem, 18vh, 11rem);
    z-index: 2;
    margin: 0;
    font-size: clamp(2.2rem, 7.6vw, 9rem);
    white-space: nowrap;
    color: var(--cotton);
    -webkit-text-stroke: 0.035em var(--framboise);
    paint-order: stroke fill;
    letter-spacing: -0.02em;
    opacity: 0;
    transform: translate(-50%, 40px) translate3d(calc(var(--mx) * 30px), calc(var(--my) * 18px), 0);
    transition:
      opacity 1s var(--ease-out) 1.1s,
      transform 1.2s var(--ease-out) 1.1s;
  }
  .hx.is-ready .hx__over {
    opacity: calc(1 - var(--sp) * 1.4);
    transform: translate(-50%, 0) translate3d(calc(var(--mx) * 30px), calc(var(--my) * 18px + var(--sp) * -60px), 0);
    transition:
      opacity 1s var(--ease-out) 1.1s,
      transform 0.25s linear;
  }
  .hx__over .dot {
    -webkit-text-stroke: 0;
    border-color: var(--framboise);
  }
  .hx__foot {
    grid-row: 3;
    position: relative;
    z-index: 3;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    gap: 1.5rem;
    padding-bottom: clamp(1.5rem, 4vh, 2.5rem);
    opacity: 0;
    transition: opacity 1s var(--ease-out) 1.4s;
  }
  .hx.is-ready .hx__foot {
    opacity: 1;
  }
  .hx__lede {
    max-width: 34ch;
    font-size: var(--fs-sm);
    color: var(--ink);
  }
  .hx__ctas {
    display: flex;
    justify-content: end;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .hx__scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .hx__scroll-ring {
    width: 10px;
    height: 10px;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    animation: bob 2.2s var(--ease-in-out) infinite;
  }
  @keyframes bob {
    50% {
      transform: translateY(6px);
    }
  }

  /* Point cliquable sur le produit */
  .hotspot {
    position: absolute;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    z-index: 2;
  }
  .hotspot__dot {
    position: relative;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--cotton);
    box-shadow: 0 0 0 4px rgb(163 23 77 / 0.85);
  }
  .hotspot__dot::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid var(--cotton);
    animation: ping 2s var(--ease-out) infinite;
  }
  @keyframes ping {
    to {
      transform: scale(2.6);
      opacity: 0;
    }
  }
  .hotspot__tag {
    position: absolute;
    left: calc(100% + 0.75rem);
    white-space: nowrap;
    display: grid;
    gap: 0.15rem;
    padding: 0.6rem 0.9rem;
    border-radius: 12px;
    background: var(--cotton);
    color: var(--ink);
    font-size: var(--fs-xs);
    font-weight: 600;
    box-shadow: 0 12px 30px rgb(126 15 58 / 0.18);
    opacity: 0;
    transform: translateX(-8px);
    transition:
      opacity 0.35s var(--ease-out),
      transform 0.35s var(--ease-out);
    pointer-events: none;
  }
  .hotspot__tag .label {
    color: var(--framboise);
  }
  .hotspot:hover .hotspot__tag,
  .hotspot:focus-visible .hotspot__tag {
    opacity: 1;
    transform: none;
  }
  @media (max-width: 860px) {
    .hx {
      min-height: max(100svh, 640px);
    }
    .hx__handle {
      display: none;
    }
    .hx__love {
      top: 38%;
      font-size: 29vw;
    }
    .hx__stage {
      top: 42%;
      width: min(82vw, 52vh);
    }
    .hx__over {
      bottom: auto;
      top: calc(42% + min(41vw, 26vh) + 0.5rem);
      font-size: 7.2vw;
    }
    .hx__foot {
      grid-template-columns: 1fr;
    }
    .hx__scroll {
      display: none;
    }
    .hx__ctas {
      justify-content: stretch;
    }
    .hx__ctas .btn {
      flex: 1;
      padding-inline: 0.75rem;
      font-size: 0.6875rem;
    }
    .hx__ctas .btn__dot {
      display: none;
    }
    .hotspot__tag {
      display: none;
    }
  }

  /* ================= DÉFILEMENT HORIZONTAL ================= */
  .hs {
    position: relative;
    padding-block: var(--space-lg) var(--space-md);
  }
  .hs__head,
  .hs__bar {
    width: 100%;
  }
  .hs__head {
    display: flex;
    justify-content: space-between;
    align-items: end;
