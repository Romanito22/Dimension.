---
import '@fontsource-variable/unbounded';
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import '../styles/cart.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Search from '../components/Search.astro';
import TabBar from '../components/TabBar.astro';
import Help from '../components/Help.astro';
import { media, galleryKeys } from '../lib/media';
import { getProducts, getBrand, categoryLabel, badgeLabel } from '../lib/shop';
import { localeFromPath, translator, href, type RouteKey } from '../i18n';
import { MONO_VIEWBOX, MONO_BOWL, MONO_STEM, MONO_RING } from '../lib/logo';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  header?: 'overlay' | 'solid';
  page?: string;
  jsonld?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** Page équivalente dans l'autre langue (sélecteur de langue et balises hreflang). */
  route?: RouteKey;
  slug?: string;
}

const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const brand = getBrand(locale);

const {
  title,
  description = brand.description,
  image = media('hero/desktop').src,
  header = 'solid',
  page = 'default',
  jsonld,
  noindex = false,
  route,
  slug = '',
} = Astro.props;
const alternates = route ? { fr: new URL(href('fr', route, slug), Astro.site), en: new URL(href('en', route, slug), Astro.site) } : null;

// Catalogue embarqué pour la recherche, les favoris et les suggestions du panier
const catalog = getProducts(locale).map((p) => {
  const [k1, k2] = galleryKeys(p);
  return {
    id: p.id,
    slug: p.slug,
    name: p.name,
    short: p.short,
    price: p.price,
    category: categoryLabel(p.category, locale),
    color: p.colors[0].name,
    image: media(k1).src,
    hover: media(k2).src,
    url: href(locale, 'product', p.slug),
    badge: badgeLabel(p.badge, locale),
    sizes: p.sizes,
  };
});

const fullTitle = title ? `${title} — dimension.` : `dimension. — ${brand.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: brand.name,
  url: brand.url,
  sameAs: brand.socials.map((s) => s.url),
};
---

<!doctype html>
<html lang={locale} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#C2124F" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="dimension." />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="dimension." />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={t('fr_FR', 'en_GB')} />
    {
      alternates && (
        <>
          <link rel="alternate" hreflang="fr" href={alternates.fr} />
          <link rel="alternate" hreflang="en" href={alternates.en} />
          <link rel="alternate" hreflang="x-default" href={alternates.fr} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline data-astro-rerun>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    <script is:inline>
      try {
        if (sessionStorage.getItem('dim-wipe')) {
          sessionStorage.removeItem('dim-wipe');
          document.documentElement.classList.add('wipe-cover');
        }
      } catch (e) {}
    </script>
    <script is:inline>
      try {
        if (!sessionStorage.getItem('dim-intro') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('is-loading');
        }
      } catch (e) {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonld ?? orgLd)} />
    <ClientRouter />
  </head>
  <body data-header={header}>
    <div class="loader theme-brand" data-loader aria-hidden="true">
      <div class="loader__center">
        <svg class="loader__mono" viewBox={MONO_VIEWBOX}>
          <path d={MONO_BOWL} fill-rule="evenodd" pathLength="1"></path>
          <path d={MONO_STEM} pathLength="1"></path>
          <circle class="loader__ring" cx={MONO_RING.cx} cy={MONO_RING.cy} r={MONO_RING.r}></circle>
        </svg>
        <p class="loader__word">dimension<span>.</span></p>
      </div>
      <p class="loader__tag label">Love over everything</p>
      <p class="loader__count display" data-loader-count>000</p>
    </div>
    <a class="skip-link" href="#main">{t('Aller au contenu', 'Skip to content')}</a>
    <Header route={route} slug={slug} />
    <main id="main" data-page={page} class:list={['main', header === 'solid' && 'main--offset']} transition:name="main">
      <slot />
    </main>
    <Footer />
    <CartDrawer />
    <Search />
    <Help />
    <TabBar />
    <script type="application/json" id="catalog" set:html={JSON.stringify(catalog)} />
    <div class="toast" data-toast role="status" aria-live="polite" transition:persist="toast">
      <img data-toast-img src="data:," alt="" width="56" height="70" />
      <div class="toast__body">
        <p class="label toast__ok">{t('Ajouté au panier', 'Added to bag')}</p>
        <p class="toast__name" data-toast-name></p>
        <p class="toast__meta" data-toast-meta></p>
      </div>
      <div class="toast__ctas">
        <button type="button" class="btn btn--ghost toast__btn" data-cart-open>{t('Panier', 'Bag')}</button>
        <a href={href(locale, 'checkout')} class="btn btn--accent toast__btn">{t('Commander', 'Checkout')}</a>
      </div>
      <button type="button" class="toast__x" data-toast-close aria-label={t('Fermer la notification', 'Close notification')}>×</button>
    </div>
    <aside class="welcome" data-welcome hidden aria-label={t('Bienvenue', 'Welcome')} transition:persist="welcome">
      <button type="button" class="welcome__x" data-welcome-close aria-label={t('Fermer', 'Close')}>×</button>
      <p class="welcome__kicker label">{t('Première visite ?', 'First time here?')}</p>
      <p class="welcome__title display">{t(`−${Math.round(brand.promo.rate * 100)} %`, `${Math.round(brand.promo.rate * 100)}% off`)}</p>
      <p class="welcome__text">{t('sur ta première commande, avec le code', 'your first order, with the code')}</p>
      <button type="button" class="welcome__code" data-welcome-copy={brand.promo.code}>{brand.promo.code}</button>
    </aside>
    <div class="wipe" data-wipe aria-hidden="true" transition:persist="wipe">
      <svg class="wipe__mono" viewBox={MONO_VIEWBOX}>
        <path d={MONO_BOWL} fill-rule="evenodd" fill="#fff" stroke="#111" stroke-width="1.4"></path>
        <path d={MONO_STEM} fill="#fff" stroke="#111" stroke-width="1.4"></path>
        <circle cx={MONO_RING.cx} cy={MONO_RING.cy} r={MONO_RING.r} fill="none" stroke="#fff" stroke-width="2.2"></circle>
      </svg>
    </div>
    <div class="cursor" aria-hidden="true" transition:persist="cursor">
      <span class="cursor__ring"></span>
      <span class="cursor__label" data-cursor-label></span>
    </div>
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>

<style is:global>
  :root {
    --header-total: calc(32px + var(--header-h));
  }
  .main--offset {
    padding-top: var(--header-total);
  }

  /* Intro : le monogramme se dessine */
  .loader {
    position: fixed;
    inset: 0;
    z-index: 500;
    display: none;
    background: var(--brand);
    color: #fff;
    clip-path: inset(0 0 0 0);
    transition: clip-path 1.1s cubic-bezier(0.76, 0, 0.24, 1);
  }
  .is-loading .loader {
    display: grid;
    place-items: center;
    animation: loader-failsafe 0s 6s forwards;
  }
  @keyframes loader-failsafe {
    to {
      visibility: hidden;
    }
  }
  .loader.is-out {
    clip-path: inset(0 0 100% 0);
  }
  .loader__center {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    transition:
      transform 1.1s cubic-bezier(0.76, 0, 0.24, 1),
      opacity 0.6s;
  }
  .loader.is-out .loader__center {
    transform: translateY(-12vh);
    opacity: 0;
  }
  .loader__mono {
    width: clamp(90px, 12vw, 150px);
    overflow: visible;
  }
  .loader__mono path {
    fill: #fff;
    fill-opacity: 0;
    stroke: var(--ink);
    stroke-width: 1.2;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation:
      draw 1.1s var(--ease-in-out) 0.1s forwards,
      fill-in 0.5s ease 1s forwards;
  }
  .loader__mono path:nth-child(2) {
    animation-delay: 0.35s, 1.15s;
  }
  .loader__ring {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.8;
    transform-origin: 98px 7px;
    transform: scale(0);
    animation: pop-ring 0.7s cubic-bezier(0.3, 1.6, 0.4, 1) 1.2s forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes fill-in {
    to {
      fill-opacity: 1;
    }
  }
  @keyframes pop-ring {
    to {
      transform: scale(1);
    }
  }
  .loader__word {
    font-family: var(--f-display);
    font-weight: 600;
    letter-spacing: -0.04em;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    opacity: 0;
    animation: fade-up 0.8s var(--ease-out) 0.9s forwards;
  }
  .loader__word span {
    color: var(--ink);
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .loader__tag {
    position: absolute;
    left: var(--gutter);
    bottom: 1.5rem;
  }
  .loader__count {
    position: absolute;
    right: var(--gutter);
    bottom: 0.6rem;
    font-size: clamp(3rem, 9vw, 8rem);
    line-height: 0.8;
    color: #fff;
    -webkit-text-stroke: 0.03em var(--ink);
    text-shadow: 0.05em 0.06em 0 var(--ink);
    font-variant-numeric: tabular-nums;
  }

  /* Ajout instantané : pastille volante + notification */
  .fly {
    position: fixed;
    z-index: 120;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--brand);
    border: 2px solid var(--ink);
    box-shadow: 0 0 24px rgb(var(--accent-rgb) / 0.8);
    pointer-events: none;
  }
  .toast {
    position: fixed;
    left: 50%;
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 85;
    width: min(560px, calc(100% - 2rem));
    display: grid;
    grid-template-columns: 56px 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 2.4rem 0.75rem 0.75rem;
    border-radius: 16px;
    background: var(--cotton);
    color: var(--ink);
    border: 2px solid var(--ink);
    box-shadow: 6px 6px 0 var(--brand);
    transform: translate(-50%, 140%);
    opacity: 0;
    visibility: hidden;
    transition:
      transform 0.6s var(--ease-out),
      opacity 0.4s,
      visibility 0s 0.6s;
  }
  .toast.is-visible {
    transform: translate(-50%, 0);
    opacity: 1;
    visibility: visible;
    transition:
      transform 0.6s var(--ease-out),
      opacity 0.3s;
  }
  /* Ordinateur : la confirmation apparaît sous le panier, sans masquer le contenu. */
  @media (min-width: 861px) {
    .toast {
      left: auto;
      right: var(--gutter);
      bottom: auto;
      top: calc(var(--header-total) + 14px);
      width: min(400px, calc(100% - 2rem));
      grid-template-columns: 56px 1fr;
      transform: translateY(-16px);
    }
    .toast__ctas {
      grid-column: 1 / -1;
    }
    .toast__btn {
      flex: 1;
    }
    .toast.is-visible {
      transform: none;
    }
  }
  /* Bienvenue (première visite) */
  .welcome {
    position: fixed;
    left: var(--gutter);
    bottom: 1.25rem;
    z-index: 84;
    display: grid;
    gap: 0.3rem;
    width: min(270px, calc(100% - 2rem));
    padding: 1.1rem 1.2rem 1.2rem;
    border: 2px solid var(--ink);
    border-radius: 18px;
    background: var(--brand);
    color: #fff;
    box-shadow: 6px 6px 0 var(--ink);
    rotate: -2deg;
    transform: translateY(140%);
    transition: transform 0.6s var(--ease-out);
  }
  .welcome.is-visible {
    transform: none;
  }
  .welcome__x {
    position: absolute;
    top: 0.4rem;
    right: 0.6rem;
    font-size: 1.3rem;
    color: #fff;
  }
  .welcome__title {
    font-size: 2.6rem;
    line-height: 1;
    -webkit-text-stroke: 0.04em var(--ink);
    paint-order: stroke fill;
    text-shadow: 0.06em 0.06em 0 var(--ink);
  }
  .welcome__text {
    font-size: var(--fs-sm);
  }
  .welcome__code {
    justify-self: start;
    margin-top: 0.4rem;
    padding: 0.5rem 0.9rem;
    border: 2px dashed var(--ink);
    border-radius: 10px;
    background: var(--cotton);
    color: var(--ink);
    font-family: var(--f-mono);
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  @media (max-width: 860px) {
    .welcome {
      bottom: calc(var(--tabbar-h, 0px) + 26px + env(safe-area-inset-bottom));
    }
  }
  .toast img {
    width: 56px;
    height: 70px;
    object-fit: cover;
    border-radius: 6px;
    background: var(--media);
  }
  .toast__ok {
    color: var(--brand);
  }
  .toast__name {
    font-weight: 600;
    font-size: var(--fs-sm);
    margin-top: 0.15rem;
  }
  .toast__meta {
    font-size: var(--fs-xs);
    color: #6b655e;
  }
  .toast__ctas {
    display: flex;
    gap: 0.4rem;
  }
  .toast__btn {
    min-height: 42px;
    padding: 0 1rem;
    font-size: 0.8125rem;
  }
  .toast__x {
    position: absolute;
    top: 0.35rem;
    right: 0.6rem;
    width: 28px;
    height: 28px;
    font-size: 1.2rem;
    color: var(--muted);
  }
  @media (max-width: 600px) {
    .toast {
      grid-template-columns: 48px 1fr;
    }
    .toast img {
      width: 48px;
      height: 60px;
    }
    .toast__ctas {
      grid-column: 1 / -1;
    }
    .toast__btn {
      flex: 1;
    }
  }

  /* Titres lettre par lettre */
  [data-chars] .w {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.06em;
    margin-bottom: -0.06em;
  }
  [data-chars] .ch {
    display: inline-block;
  }
  .js [data-chars] .ch {
    transform: translateY(110%) rotate(8deg);
    transition: transform 0.9s var(--ease-out);
    transition-delay: calc(var(--ci) * 28ms);
  }
  .js [data-chars].is-in .ch {
    transform: none;
  }

  /* Curseur : le petit cercle du logo suit le pointeur */
  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: var(--z-cursor);
    pointer-events: none;
    display: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .js .cursor {
      display: block;
    }
  }
  .cursor__ring {
    position: absolute;
    width: 26px;
    height: 26px;
    margin: -13px 0 0 -13px;
    border: 1.5px solid #fff;
    border-radius: 50%;
    mix-blend-mode: difference;
    transition:
      width 0.45s var(--ease-out),
      height 0.45s var(--ease-out),
      margin 0.45s var(--ease-out),
      background 0.3s,
      border-color 0.3s,
      opacity 0.3s;
  }
  .cursor.is-hover .cursor__ring {
    width: 46px;
    height: 46px;
    margin: -23px 0 0 -23px;
    background: rgb(242 162 204 / 0.25);
  }
  .cursor.is-label .cursor__ring {
    width: 84px;
    height: 84px;
    margin: -42px 0 0 -42px;
    background: var(--accent);
    border-color: var(--accent);
  }
  .cursor.is-hidden .cursor__ring {
    opacity: 0;
  }
  .cursor__label {
    position: absolute;
    transform: translate(-50%, -50%);
    color: var(--on-accent);
    font-family: var(--f-mono);
    font-weight: 700;
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0;
    transition: opacity 0.25s;
    white-space: nowrap;
  }
  .cursor.is-label .cursor__label {
    opacity: 1;
  }
</style>
