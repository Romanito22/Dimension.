---
// Avis clients d'une pièce : uniquement de vrais avis (src/data/reviews.json), sinon un
// état vide qui invite à en laisser un. Formulaire : scripts/product-media.ts (envoi simulé).
import Icon from './Icon.astro';
import { productReviews, starText } from '../lib/extras';
import { localeFromPath, translator, intlLocale } from '../i18n';

interface Props {
  id: string;
  name: string;
  sizes: string[];
}
const { id, name, sizes } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const reviews = productReviews(id);
const num = new Intl.NumberFormat(intlLocale(locale), { maximumFractionDigits: 1, minimumFractionDigits: 1 });
const dateFmt = new Intl.DateTimeFormat(intlLocale(locale), { day: 'numeric', month: 'long', year: 'numeric' });
const FIT = [t('Taille petit', 'Runs small'), t('Taille bien', 'True to size'), t('Taille grand', 'Runs large')];
---

  <!-- Avis clients : uniquement de vrais avis (src/data/reviews.json) -->
  <section id="avis" class="section wrap reviews" aria-labelledby="reviews-title" data-reviews>
    <div class="section-head">
      <div>
        <span class="label accent">{t('Avis clients', 'Customer reviews')}</span>
        <h2 id="reviews-title" class="display h-xl">{reviews.count ? t('Ce que vous en dites', 'What you say') : t('Les avis', 'Reviews')}</h2>
      </div>
      <button type="button" class="btn btn--ghost" data-open="review">{t('Donner mon avis', 'Write a review')}</button>
    </div>
    {
      reviews.count > 0 ? (
        <div class="reviews__grid">
          <aside class="reviews__sum">
            <p class="reviews__avg display">{num.format(reviews.average)}<span>/5</span></p>
            <p class="stars stars--lg" aria-hidden="true">{starText(reviews.average)}</p>
            <p class="muted">{t(`${reviews.count} avis`, `${reviews.count} review${reviews.count > 1 ? 's' : ''}`)}</p>
            <ul class="reviews__dist" role="list">
              {reviews.dist.map((d) => (
                <li>
                  <span>{d.n}★</span>
                  <span class="reviews__track"><i style={`width:${(d.count / reviews.count) * 100}%`} /></span>
                  <span class="muted">{d.count}</span>
                </li>
              ))}
            </ul>
            {reviews.fit !== null && (
              <div class="reviews__fit">
                <p class="label">{t('La coupe', 'Fit')}</p>
                <div class="reviews__fitbar" aria-hidden="true"><i style={`left:${((reviews.fit + 1) / 2) * 100}%`} /></div>
                <p class="reviews__fitlbl label"><span>{FIT[0]}</span><span>{FIT[1]}</span><span>{FIT[2]}</span></p>
              </div>
            )}
          </aside>
          <ul class="reviews__list" role="list">
            {reviews.list.map((r) => (
              <li class="review">
                <p class="stars" aria-label={t(`${r.rating} sur 5`, `${r.rating} out of 5`)}>{starText(r.rating)}</p>
                {r.title && <h3 class="review__title">{r.title}</h3>}
                <p>{r.text}</p>
                <p class="review__meta label">
                  <span>{r.author}</span>
                  <span>{dateFmt.format(new Date(r.date))}</span>
                  {r.size && <span>{t('Taille', 'Size')} {r.size}</span>}
                  {typeof r.fit === 'number' && <span>{FIT[r.fit + 1]}</span>}
                  {r.verified && <span class="review__ok">{t('Achat vérifié', 'Verified purchase')}</span>}
                </p>
              </li>
            ))}
          </ul>
        </div>
      ) : (
        <div class="empty-state">
          <span class="empty-state__mark" aria-hidden="true">★</span>
          <p class="display h-lg">{t("Pas encore d'avis", 'No reviews yet')}</p>
          <p class="muted">{t("Le drop vient de sortir. Tu as cette pièce ? Raconte-nous comment elle tombe — ton avis aidera les prochains.", "The drop just landed. Own this piece? Tell us how it fits — your review will help the next people.")}</p>
        </div>
      )
    }
  </section>

  <!-- Formulaire d'avis (envoi simulé : à relier à Judge.me, Trustpilot ou Google) -->
  <dialog class="sheet" data-review-dialog data-dialog="review" aria-labelledby="review-title">
    <div class="sheet__panel" data-lenis-prevent>
      <header class="sheet__head">
        <h2 id="review-title" class="display sheet__title">{t('Ton avis', 'Your review')}</h2>
        <button type="button" class="icon-btn" data-close aria-label={t('Fermer', 'Close')}>
          <Icon name="close" size={18} />
        </button>
      </header>
      <form class="rform" data-review-form novalidate>
        <p class="muted">{name}</p>
        <fieldset class="rform__stars">
          <legend class="label">{t('Ta note', 'Your rating')}</legend>
          <div class="rstars">
            {[5, 4, 3, 2, 1].map((n) => (
              <>
                <input type="radio" id={`r-${n}`} name="rating" value={n} />
                <label for={`r-${n}`} title={`${n}/5`}><span class="visually-hidden">{n} / 5</span>★</label>
              </>
            ))}
          </div>
          <p class="field-error" data-rating-error></p>
        </fieldset>
        <div class="row row--2">
          <div class="field">
            <label for="r-name" class="label">{t('Prénom', 'First name')}</label>
            <input class="input" id="r-name" name="author" autocomplete="given-name" required />
            <p class="field-error"></p>
          </div>
          <div class="field">
            <label for="r-email" class="label">{t('E-mail de commande', 'Order email')} <span class="muted">{t('(non publié)', '(not published)')}</span></label>
            <input class="input" id="r-email" name="email" type="email" autocomplete="email" required />
            <p class="field-error"></p>
          </div>
        </div>
        <div class="row row--2">
          <div class="field">
            <label for="r-size" class="label">{t('Taille achetée', 'Size bought')}</label>
            <select class="select" id="r-size" name="size" required>
              <option value="">—</option>
              {sizes.map((x) => <option>{x}</option>)}
            </select>
            <p class="field-error"></p>
          </div>
          <fieldset class="rform__fit">
            <legend class="label">{t('La coupe', 'Fit')}</legend>
            {FIT.map((f, i) => (
              <label><input type="radio" name="fit" value={i - 1} checked={i === 1} /> <span>{f}</span></label>
            ))}
          </fieldset>
        </div>
        <div class="field">
          <label for="r-text" class="label">{t('Ton avis', 'Your review')}</label>
          <textarea class="textarea" id="r-text" name="text" required minlength="10"></textarea>
          <p class="field-error"></p>
        </div>
        <button class="btn btn--accent btn--lg" type="submit">{t('Envoyer mon avis', 'Send my review')}</button>
      </form>
      <div class="rform__ok" data-review-ok hidden tabindex="-1">
        <p class="display h-lg">{t('Merci !', 'Thank you!')}</p>
        <p class="muted">{t('Ton avis sera publié après vérification de ta commande.', 'Your review will be published once we have checked your order.')}</p>
      </div>
    </div>
  </dialog>

<style>
  /* Avis */
  .reviews__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr);
    gap: var(--space-md);
    align-items: start;
  }
  .reviews__sum {
    display: grid;
    gap: 0.5rem;
    padding: 1.5rem;
    border: 2px solid var(--ink);
    border-radius: 16px;
    background: #fff;
    box-shadow: 6px 6px 0 var(--brand);
  }
  .reviews__avg {
    font-size: 3rem;
    line-height: 1;
  }
  .reviews__avg span {
    font-size: 1rem;
    color: var(--muted);
  }
  .reviews__dist {
    display: grid;
    gap: 0.3rem;
    margin-top: 0.5rem;
    font-size: var(--fs-xs);
  }
  .reviews__dist li {
    display: grid;
    grid-template-columns: 2.2em 1fr 2em;
    gap: 0.5rem;
    align-items: center;
  }
  .reviews__track {
    height: 8px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    overflow: hidden;
  }
  .reviews__track i {
    display: block;
    height: 100%;
    background: var(--brand);
  }
  .reviews__fit {
    display: grid;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .reviews__fitbar {
    position: relative;
    height: 8px;
    border-radius: 999px;
    background: var(--stitch), var(--bg-2);
  }
  .reviews__fitbar i {
    position: absolute;
    top: 50%;
    width: 16px;
    height: 16px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--brand);
    transform: translate(-50%, -50%);
  }
  .reviews__fitlbl {
    display: flex;
    justify-content: space-between;
    color: var(--muted);
    font-size: 0.625rem;
  }
  .reviews__list {
    display: grid;
    gap: 1rem;
  }
  .review {
    display: grid;
    gap: 0.5rem;
    padding-bottom: 1rem;
    border-bottom: 2px dashed var(--line);
  }
  .review__title {
    font-size: var(--fs-md);
  }
  .review__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    color: var(--muted);
  }
  .review__ok {
    color: var(--ok);
  }
  .rform {
    display: grid;
    gap: 1rem;
  }
  .rform .row--2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .rform fieldset {
    border: 0;
    padding: 0;
    margin: 0;
  }
  .rform__fit {
    display: grid;
    gap: 0.3rem;
    font-size: var(--fs-sm);
  }
  .rstars {
    display: inline-flex;
    flex-direction: row-reverse;
    gap: 0.2rem;
  }
  .rstars input {
    position: absolute;
    opacity: 0;
  }
  .rstars label {
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
    color: var(--line-strong);
    -webkit-text-stroke: 1px var(--ink);
    color: transparent;
    transition: transform 0.15s;
  }
  .rstars label:hover,
  .rstars label:hover ~ label,
  .rstars input:checked ~ label {
    color: var(--brand);
  }
  .rstars label:active {
    transform: scale(0.85);
  }
  .rstars input:focus-visible + label {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }
  .rform__ok {
    display: grid;
    gap: 0.75rem;
    padding-top: 1rem;
  }
  @media (max-width: 860px) {
    .reviews__grid {
      grid-template-columns: 1fr;
    }
    .rform .row--2 {
      grid-template-columns: 1fr;
    }
  }
</style>
