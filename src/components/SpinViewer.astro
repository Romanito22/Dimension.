---
// Vue 3D / 360° d'une pièce : photos de rotation si elles existent, sinon devant et dos détourés.
// Comportement dans scripts/product-media.ts, ouverture par [data-open="spin"].
import Icon from './Icon.astro';
import type { Media } from '../lib/media';
import { localeFromPath, translator } from '../i18n';

interface Props {
  name: string;
  frames: string[];
  front: Media;
  back: Media;
}
const { name, frames, front, back } = Astro.props;
const t = translator(localeFromPath(Astro.url.pathname));
---

  <!-- Vue 3D / 360° -->
  <dialog class="modal spin" data-spin data-dialog="spin" aria-labelledby="spin-title">
    <div class="spin__panel">
      <header class="spin__head">
        <h2 id="spin-title" class="label">{frames.length ? t('Vue 360°', '360° view') : t('Vue 3D', '3D view')} — {name}</h2>
        <button type="button" class="icon-btn" data-close aria-label={t('Fermer', 'Close')}>
          <Icon name="close" size={18} />
        </button>
      </header>
      <div class="spin__stage" data-spin-stage data-frames={JSON.stringify(frames)}>
        {
          frames.length ? (
            <img class="spin__frame" data-spin-frame src={frames[0]} alt={name} draggable="false" />
          ) : (
            <div class="spin__card" data-spin-card>
              <img class="spin__face" src={front.src} alt={front.alt} draggable="false" />
              <img class="spin__face spin__face--back" src={back.src} alt={back.alt} draggable="false" />
            </div>
          )
        }
        <span class="spin__floor" aria-hidden="true"></span>
      </div>
      <div class="spin__controls">
        <button type="button" class="chip" data-spin-to="0">{t('Devant', 'Front')}</button>
        <input class="spin__range" type="range" min="0" max="359" value="0" data-spin-range aria-label={t('Rotation', 'Rotation')} />
        <button type="button" class="chip" data-spin-to="180">{t('Dos', 'Back')}</button>
      </div>
      <p class="spin__hint label">{t('Fais glisser pour faire tourner la pièce', 'Drag to turn the piece')}</p>
    </div>
  </dialog>

<style>
  .spin__panel {
    display: grid;
    gap: 1rem;
    padding: 1rem 1.25rem 1.5rem;
  }
  .spin__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .spin__stage {
    position: relative;
    height: min(62vh, 560px);
    display: grid;
    place-items: center;
    perspective: 1400px;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    border-radius: 14px;
    background: radial-gradient(ellipse at 50% 40%, #fff 0%, var(--cotton) 60%, #e3dfd7 100%);
    overflow: hidden;
  }
  .spin__stage:global(.is-dragging) {
    cursor: grabbing;
  }
  .spin__card {
    position: relative;
    width: min(70%, 420px);
    aspect-ratio: 4 / 5;
    transform-style: preserve-3d;
    will-change: transform;
  }
  .spin__face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    filter: drop-shadow(0 22px 22px rgb(0 0 0 / 0.28));
    pointer-events: none;
  }
  .spin__face--back {
    transform: rotateY(180deg);
  }
  .spin__frame {
    max-width: 90%;
    max-height: 100%;
    object-fit: contain;
    pointer-events: none;
  }
  .spin__floor {
    position: absolute;
    left: 50%;
    bottom: 8%;
    width: 46%;
    height: 22px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(ellipse, rgb(0 0 0 / 0.22), transparent 70%);
    pointer-events: none;
  }
  .spin__controls {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: center;
  }
  .spin__range {
    width: 100%;
    accent-color: var(--brand);
  }
  .spin__hint {
    text-align: center;
    color: var(--muted);
  }
</style>
