---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import ProductCard from '../components/ProductCard.astro';
import SizeTable from '../components/SizeTable.astro';
import Icon from '../components/Icon.astro';
import Perks from '../components/Perks.astro';
import ProductReviews from '../components/ProductReviews.astro';
import Sticker from '../components/Sticker.astro';
import SpinViewer from '../components/SpinViewer.astro';
import { media } from '../lib/media';
import { getProducts, getBrand, formatPrice, imageKeys, related, categoryLabel, badgeLabel, totalStock, LOW_STOCK, SIZES, type Product } from '../lib/shop';
import { localeFromPath, translator, href, intlLocale } from '../i18n';
import { productVideo, spinFrames, productReviews, modelHeight, starText } from '../lib/extras';

interface Props {
  slug: string;
}
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const products = getProducts(locale);
const brand = getBrand(locale);
const fmt = (n: number) => formatPrice(n, locale);
const p = products.find((x) => x.slug === Astro.props.slug)!;
const keys = imageKeys(p);
const imgs = keys.map((k) => media(k, undefined, locale));
const others = related(p, products);
const soldOut = totalStock(p) === 0;
const sizes = SIZES.map((s) => p.sizes.find((x) => x.size === s)).filter(Boolean) as Product['sizes'];
const data = { id: p.id, slug: p.slug, name: p.name, price: p.price, image: imgs[0].src, sizes: p.sizes, low: LOW_STOCK };
const outSizes = p.sizes.filter((s) => s.stock === 0).map((s) => s.size);

// Fiche enrichie : vidéo portée, vue 3D / 360°, porté par le modèle, avis
const video = productVideo(p.id);
const frames = spinFrames(p.id);
const front = media(`cutout/${p.id.toLowerCase()}-front`, undefined, locale);
const back = media(`cutout/${p.id.toLowerCase()}-back`, undefined, locale);
const reviews = productReviews(p.id);
const galleryCount = keys.length + (video ? 1 : 0);
// « Porte-le avec » : la pièce conseillée avec celle-ci
const mate = products.find((x) => x.id === p.pair && x.id !== p.id);
const mateImg = mate ? media(imageKeys(mate)[0], undefined, locale) : null;
const mateData = mate
  ? { id: mate.id, slug: mate.slug, name: mate.name, price: mate.price, color: mate.colors[0].name, image: mateImg!.src, sizes: mate.sizes }
  : null;
const modelLine = t(
  `Le modèle mesure ${modelHeight(p.model.height, 'fr')} et porte du ${p.model.size}.`,
  `The model is ${modelHeight(p.model.height, 'en')} and wears a ${p.model.size}.`,
);
const num = new Intl.NumberFormat(intlLocale(locale), { maximumFractionDigits: 1, minimumFractionDigits: 1 });

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  sku: p.id,
  description: p.description,
  image: imgs.map((i) => new URL(i.src, Astro.site).toString()),
  brand: { '@type': 'Brand', name: brand.name },
  color: p.colors.map((c) => c.name).join(', '),
  offers: {
    '@type': 'Offer',
    priceCurrency: 'EUR',
    price: p.price,
    availability: soldOut ? 'https://schema.org/OutOfStock' : 'https://schema.org/InStock',
    url: new URL(href(locale, 'product', p.slug), Astro.site).toString(),
  },
  // Notes publiées uniquement quand de vrais avis existent
  ...(reviews.count
    ? {
        aggregateRating: { '@type': 'AggregateRating', ratingValue: reviews.average.toFixed(1), reviewCount: reviews.count },
        review: reviews.list.slice(0, 5).map((r) => ({
          '@type': 'Review',
          author: { '@type': 'Person', name: r.author },
          datePublished: r.date,
          reviewBody: r.text,
          reviewRating: { '@type': 'Rating', ratingValue: r.rating, bestRating: 5 },
        })),
      }
    : {}),
};
---

<Base title={p.name} description={`${p.name} — ${p.short}. ${fmt(p.price)}.`} page="product" image={imgs[0].src} jsonld={jsonld} route="product" slug={p.slug}>
  <article class="pdp wrap" data-product>
    <script type="application/json" data-product-json set:html={JSON.stringify(data)} />

    <!-- Galerie -->
    <div class="gallery">
      <div class="gallery__track" data-gallery-track>
        {
          keys.map((k, i) => (
            <figure class="gallery__item media" data-zoom={i} tabindex="0" role="button" aria-label={t(`Agrandir l'image ${i + 1} sur ${keys.length}`, `Enlarge image ${i + 1} of ${keys.length}`)} data-cursor="Zoom">
              <Img k={k} eager={i === 0} sizes="(max-width: 860px) 100vw, 60vw" vt={i === 0 ? `media-${p.slug}` : undefined} />
            </figure>
          ))
        }
        {
          video && (
            <figure class="gallery__item gallery__item--video media">
              <video src={video} poster={imgs[1].src} autoplay muted loop playsinline preload="metadata" aria-label={t(`${p.name} — portée en vidéo`, `${p.name} — worn, on video`)} />
              <span class="gallery__tag label">{t('Portée', 'Worn')}</span>
            </figure>
          )
        }
      </div>
      <div class="gallery__count label" aria-hidden="true">
        <span data-gallery-counter>1</span> / {galleryCount}
      </div>
      <div class="gallery__dots" aria-hidden="true">
        {Array.from({ length: galleryCount }).map((_, i) => <span data-gallery-dot class:list={[i === 0 && 'is-active']} />)}
      </div>
      <Sticker class="gallery__sticker" ring={`dimension. · ${brand.drop.name} · ${p.id}`} core={fmt(p.price)} size={128} rot={-10} />
      <button type="button" class="gallery__spin" data-open="spin">
        <Icon name="rotate" size={18} />
        {frames.length ? t('Vue 360°', '360° view') : t('Vue 3D', '3D view')}
      </button>
    </div>

    <!-- Infos -->
    <div class="info">
      <div class="info__sticky">
        <nav class="info__crumbs label muted" aria-label={t("Fil d'Ariane", 'Breadcrumb')}>
          <a href={href(locale, 'shop')} class="link">{t('Boutique', 'Shop')}</a>
          <span aria-hidden="true">/</span>
          <a href={href(locale, 'shop', `?categorie=${p.category}`)} class="link">{categoryLabel(p.category, locale)}</a>
        </nav>

        <header class="info__head">
          {p.badge && <span class:list={['badge', p.badge === 'Nouveau' ? 'badge--accent' : 'badge--candy']}>{badgeLabel(p.badge, locale)}</span>}
          <h1 class="display info__title patch">{p.name}</h1>
          <p class="info__short muted">{p.short}</p>
          <p class="info__price">{fmt(p.price)} <span class="muted">{t('TTC', 'incl. VAT')}</span></p>
          {
            reviews.count > 0 && (
              <a href="#avis" class="info__rating" aria-label={t(`Note moyenne ${num.format(reviews.average)} sur 5, ${reviews.count} avis`, `Average rating ${num.format(reviews.average)} out of 5, ${reviews.count} reviews`)}>
                <span class="stars" aria-hidden="true">{starText(reviews.average)}</span>
                <span>{num.format(reviews.average)}</span>
                <span class="muted">({reviews.count})</span>
              </a>
            )
          }
        </header>

        <fieldset class="info__group">
          <legend class="info__legend">
            <span class="label">{t('Couleur', 'Colour')}</span>
            <span data-color-label>{p.colors[0].name}</span>
          </legend>
          <div class="colors">
            {
              p.colors.map((c, i) => (
                <label class="color" title={c.name}>
                  <input type="radio" name="color" value={c.name} checked={i === 0} />
                  <span class="swatch" style={`background:${c.hex}`} />
                  <span class="visually-hidden">{c.name}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset class="info__group" data-sizes>
          <legend class="info__legend">
            <span class="label">{t('Taille', 'Size')}</span>
            <span data-size-label>—</span>
            <button type="button" class="info__guide link link--under label" data-open="size-guide">{t('Guide des tailles', 'Size guide')}</button>
          </legend>
          <div class="sizes">
            {
              sizes.map((s) => (
                <label class:list={['size', s.stock === 0 && 'is-out', s.stock > 0 && s.stock <= LOW_STOCK && 'is-low']}>
                  <input type="radio" name="size" value={s.size} disabled={s.stock === 0} />
                  <span>
                    {s.size}
                    {s.stock === 0 && <span class="visually-hidden">{t(' — épuisé', ' — sold out')}</span>}
                  </span>
                </label>
              ))
            }
          </div>
          <p class="info__error" data-size-error role="alert"></p>
        </fieldset>

        <div class="fit">
          <Icon name="person" size={20} />
          <div class="fit__body">
            <p>{modelLine} <span class="muted">{p.fit}</span></p>
            <p class="fit__mine" data-mysize hidden>{t('Ta taille conseillée : ', 'Your recommended size: ')}<strong data-mysize-value></strong></p>
            <button type="button" class="fit__cta link link--under label" data-open="size-guide" data-mysize-cta>{t('Trouve ta taille en 10 secondes →', 'Find your size in 10 seconds →')}</button>
          </div>
        </div>

        <p class="stock" data-stock aria-live="polite">{t('Choisis ta taille', 'Pick your size')}</p>

        <div class="buyrow">
          <button type="button" class="btn btn--accent btn--lg add" data-add data-add-main disabled={soldOut}>
            <span data-add-label>{soldOut ? t('Épuisé', 'Sold out') : t('Ajouter au panier', 'Add to bag')}</span>
            <span class="add__price">{fmt(p.price)}</span>
          </button>
          <button type="button" class="wish-btn buyrow__icon" data-wish={p.id} aria-pressed="false" aria-label={t('Ajouter aux favoris', 'Add to wishlist')}>
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5S3 15 3 8.8C3 6 5.2 4 7.8 4c1.7 0 3.2.9 4.2 2.3C13 4.9 14.5 4 16.2 4 18.8 4 21 6 21 8.8c0 6.2-9 11.7-9 11.7z"></path></svg>
          </button>
          <button type="button" class="wish-btn buyrow__icon" data-share aria-label={t('Partager cette pièce', 'Share this piece')}>
            <Icon name="share" size={18} />
          </button>
        </div>
        <p class="share-msg label" data-share-msg role="status" aria-live="polite"></p>

        {
          outSizes.length > 0 && (
            <details class="notify" data-notify>
              <summary>
                {t('Ta taille est épuisée ? ', 'Your size is sold out? ')}<span class="link link--under">{t('Préviens-moi', 'Notify me')}</span>
              </summary>
              <form class="notify__form" data-notify-form novalidate>
                <label class="visually-hidden" for="notify-size">{t('Taille', 'Size')}</label>
                <select id="notify-size" class="select" name="size">
                  {outSizes.map((s) => <option>{s}</option>)}
                </select>
                <label class="visually-hidden" for="notify-email">{t('E-mail', 'Email')}</label>
                <input id="notify-email" class="input" type="email" name="email" placeholder={t('ton@email.com', 'you@email.com')} required autocomplete="email" />
                <button class="btn" type="submit">{t("M'alerter", 'Alert me')}</button>
              </form>
              <p class="notify__msg" data-notify-msg role="status" aria-live="polite"></p>
            </details>
          )
        }

        {
          mate && mateImg && (
            <div class="pair" data-pair data-pair-json={JSON.stringify(mateData)}>
              <p class="label">{t('Porte-le avec', 'Wear it with')}</p>
              <div class="pair__row">
                <a href={href(locale, 'product', mate.slug)} class="pair__img">
                  <img src={mateImg.src} alt={mateImg.alt} width="160" height="200" loading="lazy" />
                </a>
                <div class="pair__info">
                  <p class="pair__top">
                    <a href={href(locale, 'product', mate.slug)} class="link">{mate.name}</a>
                    <span>{fmt(mate.price)}</span>
                  </p>
                  <div class="pair__sizes" role="radiogroup" aria-label={t(`Taille pour ${mate.name}`, `Size for ${mate.name}`)}>
                    {SIZES.map((z) => mate.sizes.find((s) => s.size === z)!).map((s) => (
                      <button type="button" role="radio" aria-checked="false" data-pair-size={s.size} data-qa-size={s.size} disabled={s.stock === 0}>
                        {s.size}
                      </button>
                    ))}
                  </div>
                </div>
              </div>
              <button type="button" class="btn btn--block pair__add" data-pair-add disabled={soldOut}>
                {t('Ajouter les deux', 'Add both')} · {fmt(p.price + mate.price)}
              </button>
              <p class="pair__msg" data-pair-msg role="status" aria-live="polite" />
            </div>
          )
        }

        <div class="shipcard">
          <p class="eta" data-eta>
            <Icon name="truck" size={18} />
            <span data-eta-text>{t('Livraison en 3 à 5 jours ouvrés', 'Delivery in 3 to 5 working days')}</span>
          </p>
          <Perks variant="compact" only={['ship', 'returns', 'pay']} />
          <button type="button" class="shipcard__help link link--under label" data-open="help" data-help-topic={t('taille', 'size')}>{t('Une question sur cette pièce ?', 'A question about this piece?')}</button>
        </div>

        <div class="acc">
          <details open>
            <summary>{t('Description', 'Description')}</summary>
            <div class="acc__body">
              <p>{p.description}</p>
              <ul>{p.details.map((d) => <li>{d}</li>)}</ul>
              <p class="muted">{p.fit} {modelLine}</p>
            </div>
          </details>
          <details>
            <summary>{t('Matières & entretien', 'Fabric & care')}</summary>
            <div class="acc__body">
              <p>{p.fabric}</p>
              <ul>{p.care.map((c) => <li>{c}</li>)}</ul>
            </div>
          </details>
          <details>
            <summary>{t('Livraison & retours', 'Delivery & returns')}</summary>
            <div class="acc__body">
              <ul>
                {brand.shipping.methods.map((m) => (
                  <li>
                    {m.label} — {m.delay} — {fmt(m.price)}
                  </li>
                ))}
              </ul>
              <p>
                {t(
                  `Livraison offerte dès ${fmt(brand.shipping.freeThreshold)} (hors express). Retours et échanges sous ${brand.shipping.returnsDays} jours.`,
                  `Free delivery from ${fmt(brand.shipping.freeThreshold)} (except express). Returns and exchanges within ${brand.shipping.returnsDays} days.`,
                )}{' '}
                <a href={href(locale, 'contact', '#faq')} class="link link--under">{t('Toutes les infos', 'All the details')}</a>
              </p>
            </div>
          </details>
        </div>
        <p class="info__ref label muted">{t('Réf.', 'Ref.')} {p.id}</p>
      </div>
    </div>
  </article>

  <ProductReviews id={p.id} name={p.name} sizes={sizes.map((x) => x.size)} />

  <section class="wrap recent" data-recent hidden aria-labelledby="recent-title">
    <div class="section-head">
      <div>
        <span class="label accent">{t('Ton historique', 'Your history')}</span>
        <h2 id="recent-title" class="display h-xl">{t('Vus récemment', 'Recently viewed')}</h2>
      </div>
    </div>
    <div class="recent__track" data-recent-list></div>
  </section>

  <section class="section wrap more" aria-labelledby="more-title">
    <div class="section-head">
      <div>
        <span class="label accent">{brand.drop.name}</span>
        <h2 id="more-title" data-chars class="display h-xl">{t('Tu vas aussi aimer', 'You may also like')}</h2>
      </div>
      <a href={href(locale, 'shop')} class="link link--under label">{t('Toute la boutique', 'Shop all')}</a>
    </div>
    <div class="more__grid">
      {others.map((o, i) => <div data-reveal style={`--i:${i}`}><ProductCard product={o} index={i} /></div>)}
    </div>
  </section>

  <!-- Barre d'achat mobile -->
  <div class="sticky" data-sticky>
    <div class="sticky__info">
      <span class="sticky__name">{p.name}</span>
      <span class="muted">{fmt(p.price)}</span>
    </div>
    <button type="button" class="btn btn--accent" data-add disabled={soldOut}><span data-add-label>{soldOut ? t('Épuisé', 'Sold out') : t('Ajouter au panier', 'Add to bag')}</span></button>
  </div>

  <!-- Plein écran -->
  <dialog class="lightbox" data-lightbox data-dialog="lightbox" aria-label={t(`Galerie — ${p.name}`, `Gallery — ${p.name}`)}>
    <img data-lightbox-img src={imgs[0].src} alt={imgs[0].alt} />
    <button type="button" class="lightbox__close icon-btn" data-close aria-label={t('Fermer', 'Close')}>
      <Icon name="close" size={20} />
    </button>
    <button type="button" class="lightbox__nav lightbox__nav--prev" data-lb-prev aria-label={t('Image précédente', 'Previous image')}>
      <svg width="20" height="14" viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 6H1m5-5L1 6l5 5"></path></svg>
    </button>
    <button type="button" class="lightbox__nav lightbox__nav--next" data-lb-next aria-label={t('Image suivante', 'Next image')}>
      <svg width="20" height="14" viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 6h16m-5-5 5 5-5 5"></path></svg>
    </button>
    <p class="lightbox__count label" data-lightbox-count>1 / {keys.length}</p>
  </dialog>

  <SpinViewer name={p.name} frames={frames} front={front} back={back} />

  <!-- Guide des tailles -->
  <dialog class="sheet" data-size-guide data-dialog="size-guide" aria-labelledby="guide-title">
    <div class="sheet__panel" data-lenis-prevent>
      <header class="sheet__head">
        <h2 id="guide-title" class="display sheet__title">{t('Guide des tailles', 'Size guide')}</h2>
        <button type="button" class="icon-btn" data-close aria-label={t('Fermer le guide des tailles', 'Close the size guide')}>
          <Icon name="close" size={18} />
        </button>
      </header>
      <form class="finder" data-finder novalidate>
        <p class="finder__title display">{t('Trouve ta taille', 'Find your size')}</p>
        <p class="muted finder__sub">{t("Trois infos, une recommandation. On s'en souvient pour les autres pièces.", "Three details, one recommendation. We'll remember it for the other pieces.")}</p>
        <div class="finder__row">
          <div class="field">
            <label for="f-height" class="label">{t('Taille (cm)', 'Height (cm)')}</label>
            <input id="f-height" class="input" name="height" type="number" inputmode="numeric" min="140" max="215" placeholder="178" required />
          </div>
          <div class="field">
            <label for="f-weight" class="label">{t('Poids (kg)', 'Weight (kg)')}</label>
            <input id="f-weight" class="input" name="weight" type="number" inputmode="numeric" min="35" max="160" placeholder="72" required />
          </div>
        </div>
        <fieldset class="finder__fit">
          <legend class="label">{t('Tu le portes plutôt…', 'You like it…')}</legend>
          <label><input type="radio" name="fit" value="-1" /> <span>{t('Près du corps', 'Close-fitting')}</span></label>
          <label><input type="radio" name="fit" value="0" checked /> <span>{t('Boxy (comme prévu)', 'Boxy (as designed)')}</span></label>
          <label><input type="radio" name="fit" value="1" /> <span>{t('Très oversize', 'Very oversized')}</span></label>
        </fieldset>
        <button class="btn btn--accent" type="submit">{t('Calculer ma taille', 'Get my size')}</button>
        <div class="finder__result" data-finder-result hidden>
          <p>{t('On te conseille le ', 'We recommend ')}<strong class="finder__size display" data-finder-size>M</strong></p>
          <p class="muted finder__note" data-finder-note></p>
          <button type="button" class="btn" data-finder-apply>{t('Sélectionner cette taille', 'Select this size')}</button>
        </div>
      </form>
      <hr class="stitch finder__stitch" />
      <p class="muted guide__intro">{p.fit} {t('Entre deux tailles ? Prends la plus grande pour un tombé plus ample.', 'Between two sizes? Take the larger one for a roomier drape.')}</p>
      <SizeTable only={p.category} />
    </div>
  </dialog>
</Base>

<style>
  .pdp {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 5rem);
    padding-top: 1rem;
  }

  /* Galerie */
  .gallery {
    position: relative;
  }
  .gallery__track {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .gallery__item {
    margin: 0;
    aspect-ratio: 4 / 5;
    cursor: zoom-in;
    border-radius: var(--radius);
  }
  .gallery__item:first-child,
  .gallery__item:nth-child(4) {
    grid-column: 1 / -1;
  }
  .gallery__item :global(img) {
    transition: transform 0.5s var(--ease-out);
  }
  .gallery__item:global(.is-zoomed) :global(img) {
    transform: scale(2);
  }
  .gallery__count,
  .gallery__dots {
    display: none;
  }

  /* Infos */
  .info__sticky {
    position: sticky;
    top: calc(var(--header-total) + 1.5rem);
    display: grid;
    gap: 1.5rem;
    padding-bottom: 2rem;
  }
  .info__crumbs {
    display: flex;
    gap: 0.6rem;
  }
  .info__head {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }
  .info__title {
    font-size: clamp(1.7rem, 1rem + 2.2vw, 3rem);
  }
  .info__price {
    font-family: var(--f-display);
    font-size: 1.9rem;
    font-weight: 700;
    line-height: 1;
  }
  .info__price .muted {
    font-size: var(--fs-xs);
    font-weight: 400;
  }
  .info__group {
    border: 0;
    padding: 0;
    margin: 0;
    position: relative;
  }
  .info__legend {
    width: 100%;
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    margin-bottom: 0.85rem;
    padding: 0;
    font-size: var(--fs-sm);
    font-weight: 600;
  }
  .info__guide {
    margin-left: auto;
    font-weight: 600;
  }
  .colors {
    display: flex;
    gap: 0.75rem;
  }
  .color input,
  .size input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .color .swatch {
    width: 34px;
    height: 34px;
    cursor: pointer;
    transition: box-shadow 0.25s;
  }
  .color input:checked + .swatch {
    box-shadow:
      inset 0 0 0 1px rgb(0 0 0 / 0.18),
      0 0 0 3px var(--bg),
      0 0 0 4.5px var(--fg);
  }
  .color input:focus-visible + .swatch {
    outline: 2px solid var(--accent);
    outline-offset: 5px;
  }
  .sizes {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 6px;
  }
  .size > span {
    position: relative;
    display: grid;
    place-items: center;
    height: 52px;
