---
import LegalPage from '../components/LegalPage.astro';
import { getBrand, formatPrice } from '../lib/shop';
import { localeFromPath } from '../i18n';
const locale = localeFromPath(Astro.url.pathname);
const brand = getBrand(locale);
const free = formatPrice(brand.shipping.freeThreshold, locale);
---

{
  locale === 'en' ? (
    <LegalPage title="Terms of sale" updated="October 2026" route="terms">
      <p><mark>Template to be validated — adapt it to your legal structure before going live.</mark></p>
      <h2>1. Purpose</h2>
      <p>These terms govern the sale of clothing and accessories on {brand.url} by {brand.legalName}.</p>
      <h2>2. Prices</h2>
      <p>Prices are shown in euros, including all taxes, excluding delivery. Delivery costs are shown before the order is confirmed.</p>
      <h2>3. Orders & payment</h2>
      <p>An order is confirmed once payment is accepted. A confirmation email summarises the order. Payment is secured by our payment provider.</p>
      <h2>4. Delivery</h2>
      <p>
        Orders ship within 24 to 48 working hours. Free delivery from {free} in metropolitan France (except express). Estimated times:{' '}
        {brand.shipping.methods.map((m) => `${m.label} ${m.delay}`).join('; ')}.
      </p>
      <h2>5. Right of withdrawal & returns</h2>
      <p>
        You have {brand.shipping.returnsDays} days from delivery to withdraw from your purchase, without giving a reason. Items must be returned unworn, unwashed and with their tags. Refunds are issued within 14 days of receiving the return.
      </p>
      <h2>6. Warranties</h2>
      <p>Products are covered by the statutory guarantee of conformity and the guarantee against hidden defects under French law.</p>
      <h2>7. Disputes</h2>
      <p>In the event of a dispute, an amicable solution will be sought first. Failing that, consumers may use a consumer mediator free of charge: <mark>mediator name</mark>. French law applies.</p>
    </LegalPage>
  ) : (
<LegalPage title="Conditions générales de vente" updated="octobre 2026" route="terms">
  <p><mark>Modèle à faire valider — à adapter à ta structure juridique avant la mise en ligne.</mark></p>
  <h2>1. Objet</h2>
  <p>Les présentes conditions régissent les ventes de vêtements et accessoires réalisées sur le site {brand.url} par {brand.legalName}.</p>
  <h2>2. Prix</h2>
  <p>Les prix sont indiqués en euros, toutes taxes comprises, hors frais de livraison. Les frais de livraison sont précisés avant la validation de la commande.</p>
  <h2>3. Commande & paiement</h2>
  <p>La commande est confirmée après acceptation du paiement. Un e-mail de confirmation récapitule la commande. Le paiement est sécurisé par notre prestataire de paiement.</p>
  <h2>4. Livraison</h2>
  <p>
    Les commandes sont expédiées sous 24 à 48 h ouvrées. Livraison offerte dès {free} en France métropolitaine (hors express). Délais indicatifs :{' '}
    {brand.shipping.methods.map((m) => `${m.label} ${m.delay}`).join(' ; ')}.
  </p>
  <h2>5. Droit de rétractation & retours</h2>
  <p>
    Tu disposes de {brand.shipping.returnsDays} jours à compter de la réception pour exercer ton droit de rétractation, sans justification. Les articles doivent être retournés non portés, non lavés, avec leurs étiquettes. Le remboursement intervient sous 14 jours après réception du retour.
  </p>
  <h2>6. Garanties</h2>
  <p>Les produits bénéficient de la garantie légale de conformité et de la garantie contre les vices cachés.</p>
  <h2>7. Litiges</h2>
  <p>En cas de litige, une solution amiable sera recherchée en priorité. À défaut, le consommateur peut recourir gratuitement à un médiateur de la consommation : <mark>nom du médiateur</mark>.</p>
</LegalPage>
  )
}
