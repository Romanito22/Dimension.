---
import Base from '../layouts/Base.astro';
---

<Base title="Favoris" page="wishlist" noindex>
  <section class="wrap wl" data-wish-page>
    <header class="wl__head">
      <p class="label accent">Gardées de côté</p>
      <h1 class="display h-2xl patch" data-chars>Favoris</h1>
      <p class="lede muted"><span data-wish-total>0</span> pièce(s) enregistrée(s) sur cet appareil. Choisis ta taille pour l'ajouter directement au panier.</p>
    </header>
    <div class="wl__grid" data-wish-grid></div>
    <div class="wl__empty" data-wish-empty hidden>
      <span class="wl__heart" aria-hidden="true">♡</span>
      <p class="display h-lg">Rien pour l'instant</p>
      <p class="muted">Touche le cœur d'une pièce pour la retrouver ici.</p>
      <a href="/boutique" class="btn btn--accent">Voir la boutique</a>
    </div>
  </section>
</Base>

<style>
  .wl {
    padding-block: var(--space-lg);
  }
  .wl__head {
    display: grid;
    gap: 1rem;
    margin-bottom: var(--space-md);
  }
  .wl__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem) clamp(12px, 1.4vw, 24px);
  }
  .wl__grid :global(.wcard) {
    position: relative;
    display: grid;
    gap: 0.6rem;
    animation: wl-in 0.5s var(--ease-out) both;
  }
  @keyframes wl-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  .wl__grid :global(.wcard__media) {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 2px solid var(--ink);
    border-radius: 16px;
    background: var(--media);
    transition: box-shadow 0.2s;
  }
  .wl__grid :global(.wcard__media:hover) {
    box-shadow: 6px 6px 0 var(--brand);
  }
  .wl__grid :global(.wcard__media img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .wl__grid :global(.wcard__wish) {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
  }
  .wl__grid :global(.wcard__meta) {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: var(--fs-sm);
  }
  .wl__grid :global(.wcard__price) {
    font-family: var(--f-display);
    font-weight: 700;
  }
  .wl__grid :global(.wcard__stock) {
    color: var(--ok);
  }
  .wl__grid :global(.wcard__sizes) {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 4px;
  }
  .wl__grid :global(.wcard__sizes button) {
    height: 36px;
    border: 1.5px solid var(--ink);
    border-radius: 8px;
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    font-weight: 600;
  }
  .wl__grid :global(.wcard__sizes button:hover) {
    background: var(--ink);
    color: var(--cotton);
  }
  .wl__grid :global(.wcard__sizes button:disabled) {
    opacity: 0.3;
    text-decoration: line-through;
  }
  .wl__grid :global(.wcard__sizes button.is-added) {
    background: var(--brand);
    color: #fff;
  }
  .wl__empty {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1rem;
    padding-block: var(--space-lg);
  }
  .wl__heart {
    font-size: 3.5rem;
    color: var(--brand);
    line-height: 1;
  }
</style>
