---
// Section réseaux de l'accueil : vraies vidéos TikTok si des liens sont renseignés
// (src/data/tiktok.json), sinon une grille de visuels qui renvoie vers le profil.
// Le lecteur TikTok n'est chargé qu'au clic : rien de tiers avant que la personne choisisse.
import Img from './Img.astro';
import { getBrand } from '../lib/shop';
import { tiktokVideos } from '../lib/tiktok';
import { localeFromPath, translator } from '../i18n';

const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const brand = getBrand(locale);
const profile = brand.socials.find((s) => s.name === 'TikTok')!.url;
const videos = await tiktokVideos();
const LOGO =
  'M16 0c.4 3 2.3 5 5.6 5.3v3.9c-2 .1-3.8-.5-5.6-1.6V16c0 9.6-10.5 10.2-13.5 4.7C.3 17 1.6 10.8 8.6 10.6v4.1c-.6.1-1.1.2-1.6.4-1.4.5-2.2 1.4-2 3 .4 3 6.1 4 5.6-2V0z';
---

<section class="section social" aria-labelledby="social-title" data-tiktok>
  <div class="wrap">
    <div class="section-head social__head">
      <div data-reveal>
        <span class="label accent">{videos.length ? t('En vidéo', 'On video') : t('On se retrouve là-bas', 'Find us there')}</span>
        <h2 id="social-title" class="display h-xl" data-chars>{brand.handle}</h2>
      </div>
      <a href={profile} target="_blank" rel="noopener" class="btn btn--ghost" data-reveal>{t('Suivre sur TikTok', 'Follow on TikTok')}</a>
    </div>
  </div>

  {
    videos.length ? (
      <>
        <div class="tt__rail" data-lenis-prevent>
          <ul class="tt__track" role="list">
            {videos.map((v, i) => (
              <li>
                <button type="button" class="tt__card" data-tt-play={i} aria-label={t(`Lire la vidéo TikTok : ${v.caption || i + 1}`, `Play TikTok video: ${v.caption || i + 1}`)}>
                  <img src={v.cover} alt="" loading="lazy" width="540" height="960" />
                  <span class="tt__play" aria-hidden="true">
                    <svg width="18" height="20" viewBox="0 0 18 20" fill="currentColor"><path d="M2 1.5v17L17 10z" /></svg>
                  </span>
                  {v.caption && <span class="tt__cap">{v.caption}</span>}
                  <svg class="tt__logo" width="16" height="18" viewBox="0 0 22 24" fill="currentColor" aria-hidden="true"><path d={LOGO} /></svg>
                </button>
              </li>
            ))}
          </ul>
        </div>
        <script type="application/json" data-tt-json set:html={JSON.stringify(videos.map((v) => ({ id: v.id, url: v.url })))} />
        <dialog class="tt__dialog" data-tt-dialog aria-label={t('Vidéo TikTok', 'TikTok video')}>
          <div class="tt__frame" data-tt-frame />
          <div class="tt__bar">
            <button type="button" class="icon-btn" data-tt-prev aria-label={t('Vidéo précédente', 'Previous video')}>←</button>
            <a class="link label" data-tt-link href={profile} target="_blank" rel="noopener">{t('Voir sur TikTok ↗', 'Open on TikTok ↗')}</a>
            <button type="button" class="icon-btn" data-tt-next aria-label={t('Vidéo suivante', 'Next video')}>→</button>
          </div>
          <button type="button" class="tt__close icon-btn" data-tt-close aria-label={t('Fermer', 'Close')}>×</button>
        </dialog>
      </>
    ) : (
      <div class="wrap">
        <ul class="social__grid" role="list">
          {[1, 2, 3, 4, 5, 6].map((n) => (
            <li data-reveal style={`--i:${n - 1}`}>
              <a href={profile} target="_blank" rel="noopener" class="social__item media ratio-11" aria-label={t(`Publication ${n} sur TikTok`, `TikTok post ${n}`)}>
                <Img k={`social/${n}`} sizes="(max-width: 700px) 33vw, 16vw" />
                <span class="social__hover" aria-hidden="true">
                  <svg width="22" height="24" viewBox="0 0 22 24" fill="currentColor"><path d={LOGO} /></svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</section>

<style>
  .social__head {
    flex-wrap: wrap;
  }
  .social__head h2 {
    font-size: clamp(1.5rem, 7.4vw, 4.25rem);
    overflow-wrap: anywhere;
  }
  .social__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: clamp(8px, 1vw, 16px);
  }
  .social__item {
    display: block;
    border: 2px solid var(--ink);
    border-radius: 14px;
  }
  .social__hover {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgb(var(--accent-rgb) / 0.8);
    color: var(--on-accent);
    opacity: 0;
    transition: opacity 0.35s;
  }
  .social__item:hover .social__hover,
  .social__item:focus-visible .social__hover {
    opacity: 1;
  }

  /* Vidéos */
  .tt__rail {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .tt__rail::-webkit-scrollbar {
    display: none;
  }
  .tt__track {
    display: flex;
    gap: clamp(10px, 1.2vw, 18px);
    width: max-content;
    padding: 4px var(--gutter) 14px;
  }
  .tt__track li {
    scroll-snap-align: start;
  }
  .tt__card {
    position: relative;
    display: block;
    width: clamp(200px, 19vw, 280px);
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border: 2px solid var(--ink);
    border-radius: 18px;
    background: var(--ink);
    color: #fff;
    text-align: left;
    transition:
      transform 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out);
  }
  .tt__card:hover,
  .tt__card:focus-visible {
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 var(--brand);
  }
  .tt__card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tt__card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgb(0 0 0 / 0.7));
  }
  .tt__play {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 1;
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    padding-left: 4px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--brand);
    transform: translate(-50%, -50%);
    transition: transform 0.3s var(--ease-out);
  }
  .tt__card:hover .tt__play {
    transform: translate(-50%, -50%) scale(1.1);
  }
  .tt__cap {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    z-index: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: var(--fs-sm);
    font-weight: 600;
  }
  .tt__logo {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 1;
  }
  .tt__dialog {
    padding: 0;
    border: 2px solid var(--ink);
    border-radius: 20px;
    background: var(--ink);
    color: var(--cotton);
    box-shadow: 8px 8px 0 var(--brand);
    overflow: visible;
  }
  .tt__dialog::backdrop {
    background: rgb(0 0 0 / 0.75);
  }
  .tt__frame {
    width: min(calc((86dvh - 56px) * 9 / 16), calc(100vw - 2rem));
    aspect-ratio: 9 / 16;
    border-radius: 18px 18px 0 0;
    overflow: hidden;
  }
  .tt__frame :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .tt__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 56px;
    padding: 0 0.5rem;
  }
  .tt__close {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    width: 40px;
    height: 40px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--cotton);
    color: var(--ink);
    font-size: 1.4rem;
  }
  @media (max-width: 860px) {
    .social__grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .tt__card {
      width: 58vw;
    }
  }
</style>
