---
import Base from '../layouts/Base.astro';
import { brand, formatPrice } from '../lib/shop';

const countries = ['France', 'Belgique', 'Suisse', 'Luxembourg', 'Allemagne', 'Espagne', 'Italie', 'Pays-Bas', 'Portugal', 'Royaume-Uni'];
---

<Base title="Commande" page="checkout" noindex>
  <div class="co wrap" data-checkout>
    <header class="co__head">
      <a href="/boutique" class="link label muted">← Continuer mes achats</a>
      <h1 class="display h-xl">Commande</h1>
      <ol class="co__steps label" role="list" aria-label="Étapes">
        <li>Coordonnées</li><li>Livraison</li><li>Paiement</li>
      </ol>
    </header>

    <!-- Panier vide -->
    <div class="co__empty" data-checkout-empty hidden>
      <span class="co__ring" aria-hidden="true"></span>
      <p class="display h-lg">Ton panier est vide</p>
      <p class="muted">Ajoute une pièce du Drop 01 pour passer commande.</p>
      <a href="/boutique" class="btn">Voir la boutique <span class="btn__dot" aria-hidden="true"></span></a>
    </div>

    <div class="co__layout" data-checkout-layout>
      <form class="co__form" data-checkout-form novalidate>
        <!-- 1. Coordonnées -->
        <section class="step" data-step aria-labelledby="s1">
          <header class="step__head">
            <h2 id="s1" class="step__title"><span class="step__num">1</span> Coordonnées</h2>
            <button type="button" class="link link--under label" data-step-edit hidden>Modifier</button>
          </header>
          <p class="step__summary muted" data-step-summary></p>
          <div class="step__body" data-step-body>
            <div class="row">
              <div class="field">
                <label for="email" class="label">E-mail</label>
                <input class="input" id="email" name="email" type="email" autocomplete="email" required />
                <p class="field-error"></p>
              </div>
            </div>
            <div class="row row--2">
              <div class="field">
                <label for="firstname" class="label">Prénom</label>
                <input class="input" id="firstname" name="firstname" autocomplete="given-name" required />
                <p class="field-error"></p>
              </div>
              <div class="field">
                <label for="lastname" class="label">Nom</label>
                <input class="input" id="lastname" name="lastname" autocomplete="family-name" required />
                <p class="field-error"></p>
              </div>
            </div>
            <div class="row">
              <div class="field">
                <label for="phone" class="label">Téléphone <span class="muted">(pour le suivi)</span></label>
                <input class="input" id="phone" name="phone" type="tel" autocomplete="tel" data-pattern="^[+]?[0-9]{9,14}$" data-message="Numéro de téléphone invalide." required />
                <p class="field-error"></p>
              </div>
            </div>
            <label class="check">
              <input type="checkbox" name="newsletter" />
              <span>Je veux recevoir les drops en avant-première (et −10 % sur la prochaine commande).</span>
            </label>
            <button type="button" class="btn btn--lg" data-step-next>Continuer vers la livraison</button>
          </div>
        </section>

        <!-- 2. Livraison -->
        <section class="step" data-step aria-labelledby="s2">
          <header class="step__head">
            <h2 id="s2" class="step__title"><span class="step__num">2</span> Livraison</h2>
            <button type="button" class="link link--under label" data-step-edit hidden>Modifier</button>
          </header>
          <p class="step__summary muted" data-step-summary></p>
          <div class="step__body" data-step-body hidden>
            <div class="row">
              <div class="field">
                <label for="address" class="label">Adresse</label>
                <input class="input" id="address" name="address" autocomplete="street-address" required />
                <p class="field-error"></p>
              </div>
            </div>
            <div class="row row--3">
              <div class="field">
                <label for="zip" class="label">Code postal</label>
                <input class="input" id="zip" name="zip" autocomplete="postal-code" inputmode="numeric" required />
                <p class="field-error"></p>
              </div>
              <div class="field">
                <label for="city" class="label">Ville</label>
                <input class="input" id="city" name="city" autocomplete="address-level2" required />
                <p class="field-error"></p>
              </div>
              <div class="field">
                <label for="country" class="label">Pays</label>
                <select class="select" id="country" name="country" autocomplete="country-name" required>
                  {countries.map((c) => <option>{c}</option>)}
                </select>
                <p class="field-error"></p>
              </div>
            </div>
            <fieldset class="ship">
              <legend class="label">Mode de livraison</legend>
              {
                brand.shipping.methods.map((m, i) => (
                  <label class="ship__opt">
                    <input type="radio" name="shipping" value={m.id} checked={i === 0} />
                    <span class="ship__radio" aria-hidden="true" />
                    <span class="ship__text">
                      <strong>{m.label}</strong>
                      <span class="muted">{m.delay}</span>
                    </span>
                    <span class="ship__price" data-ship-price={m.id}>{formatPrice(m.price)}</span>
                  </label>
                ))
              }
            </fieldset>
            <button type="button" class="btn btn--lg" data-step-next>Continuer vers le paiement</button>
          </div>
        </section>

        <!-- 3. Paiement -->
        <section class="step" data-step aria-labelledby="s3">
          <header class="step__head">
            <h2 id="s3" class="step__title"><span class="step__num">3</span> Paiement</h2>
          </header>
          <div class="step__body" data-step-body hidden>
            <p class="demo label">Mode démo — aucun paiement réel n'est effectué</p>
            <div class="row">
              <div class="field">
                <label for="card" class="label">Numéro de carte</label>
                <input class="input" id="card" name="card" inputmode="numeric" autocomplete="cc-number" placeholder="4242 4242 4242 4242" data-pattern="^[0-9]{16}$" data-message="Le numéro doit contenir 16 chiffres." required />
                <p class="field-error"></p>
              </div>
            </div>
            <div class="row row--2">
              <div class="field">
                <label for="exp" class="label">Expiration</label>
                <input class="input" id="exp" name="exp" inputmode="numeric" autocomplete="cc-exp" placeholder="MM / AA" data-pattern="^(0[1-9]|1[0-2])/[0-9]{2}$" data-message="Format attendu : MM / AA." required />
                <p class="field-error"></p>
              </div>
              <div class="field">
                <label for="cvc" class="label">CVC</label>
                <input class="input" id="cvc" name="cvc" inputmode="numeric" autocomplete="cc-csc" placeholder="123" data-pattern="^[0-9]{3,4}$" data-message="3 ou 4 chiffres." required />
                <p class="field-error"></p>
              </div>
            </div>
            <p class="muted co__legal">
              En validant, tu acceptes nos <a href="/cgv" class="link link--under">conditions générales de vente</a>. Paiement chiffré et sécurisé.
            </p>
            <button type="submit" class="btn btn--accent btn--lg btn--block" data-pay>
              <span data-pay-label>Payer <span data-total="total"></span></span>
              <span class="btn__dot" aria-hidden="true"></span>
            </button>
          </div>
        </section>
      </form>

      <!-- Récapitulatif -->
      <aside class="sum" aria-labelledby="sum-title">
        <div class="sum__inner">
          <h2 id="sum-title" class="label">Récapitulatif</h2>
          <div data-summary-lines></div>
          <div class="promo">
            <label for="promo" class="visually-hidden">Code promo</label>
            <input id="promo" class="input" placeholder="Code promo" data-promo-input autocomplete="off" />
            <button type="button" class="btn btn--ghost" data-promo-apply>Appliquer</button>
          </div>
          <p class="promo__msg" data-promo-msg aria-live="polite"></p>
          <dl class="totals">
            <div><dt>Sous-total</dt><dd data-total="sub"></dd></div>
            <div data-discount-row hidden><dt>Réduction</dt><dd class="accent" data-total="discount"></dd></div>
            <div><dt>Livraison</dt><dd data-total="ship"></dd></div>
            <div class="totals__grand"><dt>Total <span class="muted">TTC</span></dt><dd data-total="total"></dd></div>
          </dl>
        </div>
      </aside>
    </div>

    <!-- Confirmation -->
    <section class="confirm" data-confirm hidden tabindex="-1" aria-labelledby="confirm-title">
      <span class="confirm__ring" aria-hidden="true"></span>
      <p class="label accent">Commande <span data-order-id></span></p>
      <h2 id="confirm-title" class="display h-2xl">Merci<span class="dot" aria-hidden="true"></span></h2>
      <p class="lede">
        Ta commande de <strong data-order-total></strong> est confirmée. Un e-mail récapitulatif part vers <strong data-order-email></strong>. On prépare ton colis avec amour — over everything.
      </p>
      <div class="confirm__lines" data-order-lines></div>
      <div class="confirm__ctas">
        <a href="/boutique" class="btn">Retour à la boutique <span class="btn__dot" aria-hidden="true"></span></a>
        <a href={brand.socials[0].url} target="_blank" rel="noopener" class="btn btn--ghost">Suivre {brand.handle}</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .co {
    padding-bottom: var(--space-lg);
  }
  .co__head {
    display: grid;
    gap: 1rem;
    padding-block: var(--space-md);
  }
  .co__steps {
    display: flex;
    gap: 1.5rem;
    color: var(--muted);
    list-style: none;
    padding: 0;
    counter-reset: s;
  }
  .co__steps li::before {
    counter-increment: s;
    content: '0' counter(s) ' ';
    color: var(--accent);
  }
  .co__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 6rem);
    align-items: start;
  }
  .step {
    border-top: 1px solid var(--line-strong);
    padding-block: 1.5rem;
  }
  .step__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .step__title {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-family: var(--f-display);
    font-stretch: 75%;
    font-weight: 700;
    font-size: var(--fs-md);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .step__num {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    font-size: 0.75rem;
    transition:
      background 0.3s,
      color 0.3s;
  }
  .step:global(.is-open) .step__num {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .step:global(.is-done) .step__num {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }
  .step:not(:global(.is-open)):not(:global(.is-done)) .step__title {
    color: var(--muted);
  }
  .step__summary {
    font-size: var(--fs-sm);
    padding-left: calc(30px + 0.9rem);
    margin-top: 0.4rem;
  }
  .step__summary:empty,
  .step:global(.is-open) .step__summary {
    display: none;
  }
  .step__body {
    display: grid;
    gap: 1rem;
    padding-top: 1.5rem;
    animation: step-in 0.5s var(--ease-out);
  }
  @keyframes step-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  .step__body > .btn {
    justify-self: start;
    margin-top: 0.5rem;
  }
  .row {
    display: grid;
    gap: 1rem;
  }
  .row--2 {
    grid-template-columns: 1fr 1fr;
  }
  .row--3 {
    grid-template-columns: 1fr 1.4fr 1.4fr;
  }
  .check {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    font-size: var(--fs-sm);
    cursor: pointer;
  }
  .check input {
    accent-color: var(--accent);
    width: 18px;
    height: 18px;
    margin-top: 2px;
  }
  .ship {
    border: 0;
    padding: 0;
    margin: 0.5rem 0 0;
    display: grid;
    gap: 0.5rem;
  }
  .ship legend {
    margin-bottom: 0.75rem;
    color: var(--muted);
  }
  .ship__opt {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    cursor: pointer;
    transition:
      border-color 0.2s,
      background 0.2s;
  }
  .ship__opt:has(input:checked) {
    border-color: var(--fg);
    background: var(--surface);
  }
  .ship__opt input {
    position: absolute;
    opacity: 0;
  }
  .ship__radio {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1.5px solid var(--line-strong);
    transition: border 0.2s;
  }
  .ship__opt input:checked + .ship__radio {
    border: 5px solid var(--accent);
  }
  .ship__opt input:focus-visible + .ship__radio {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .ship__text {
    display: grid;
    font-size: var(--fs-sm);
  }
  .ship__price {
    font-weight: 600;
    font-size: var(--fs-sm);
  }
  .demo {
    padding: 0.75rem 1rem;
    border-radius: var(--radius);
    background: var(--accent-soft);
    color: var(--accent-deep);
  }
  .co__legal {
    font-size: var(--fs-xs);
  }
  .sum {
    position: sticky;
    top: calc(var(--header-total) + 1rem);
  }
  .sum__inner {
    background: var(--surface);
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border-radius: var(--radius);
    display: grid;
    gap: 1rem;
  }
  .promo {
    display: flex;
    gap: 0.5rem;
  }
  .promo .btn {
    min-height: 52px;
    padding-inline: 1.25rem;
  }
  .promo__msg {
    font-size: var(--fs-xs);
    color: var(--ok);
    margin-top: -0.5rem;
  }
  .promo__msg:global(.is-error) {
    color: var(--accent);
  }
  .promo__msg:empty {
    display: none;
  }
  .totals {
    display: grid;
    gap: 0.6rem;
    font-size: var(--fs-sm);
    border-top: 1px solid var(--line);
    padding-top: 1rem;
  }
  .totals div {
    display: flex;
    justify-content: space-between;
  }
  .totals dd {
    margin: 0;
    font-weight: 600;
  }
  .totals__grand {
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
    font-size: 1.15rem;
    font-weight: 700;
  }
  .totals__grand .muted {
    font-size: var(--fs-xs);
    font-weight: 400;
  }
  .co__empty,
  .confirm {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.25rem;
    padding-block: var(--space-lg);
    outline: none;
  }
  .co__empty[hidden],
  .confirm[hidden] {
    display: none;
  }
  .co__ring,
  .confirm__ring {
    width: 64px;
    height: 64px;
    border: 1.5px solid var(--accent);
    border-radius: 50%;
  }
  .confirm__ring {
    background: var(--accent);
    animation: pop 0.8s var(--ease-out);
  }
  @keyframes pop {
    from {
      transform: scale(0);
    }
  }
  .confirm .lede {
    max-width: 48ch;
  }
  .confirm__lines {
    width: min(460px, 100%);
    text-align: left;
  }
  .confirm__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
  @media (max-width: 960px) {
    .co__layout {
      grid-template-columns: 1fr;
    }
    .sum {
      position: static;
      order: -1;
    }
  }
  @media (max-width: 600px) {
    .row--2,
    .row--3 {
      grid-template-columns: 1fr;
    }
    .step__body > .btn {
      justify-self: stretch;
    }
  }
</style>
