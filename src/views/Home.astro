---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import Img from '../components/Img.astro';
import Newsletter from '../components/Newsletter.astro';
import { media } from '../lib/media';
import { getProducts, getBrand, byNewest, formatPrice, imageKeys, categoryLabel, totalStock } from '../lib/shop';
import { localeFromPath, translator, href } from '../i18n';

const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const products = getProducts(locale);
const brand = getBrand(locale);
const fmt = (n: number) => formatPrice(n, locale);
const productUrl = (slug: string) => href(locale, 'product', slug);

const ogImage = media('hero/desktop');
const gravel = media('texture/gravel');
const teeBack = media('cutout/dim-001-back', undefined, locale);
const teeFront = media('cutout/dim-001-front', undefined, locale);
const latest = byNewest(products);
const signature = products.find((p) => p.art === 'love')!;
const tshirtCount = products.filter((p) => p.category === 't-shirts').length;
const knitCount = products.filter((p) => p.category === 'maille').length;
const socialHandle = brand.handle;
const tiktok = brand.socials.find((s) => s.name === 'TikTok')!.url;
const sigUrl = productUrl(signature.slug);

// Scène du hero : la pièce signature d'abord, puis les nouveautés
const WORDS: Record<string, string> = { love: 'LOVE', crew: 'CREW', splash: 'SPLASH', doodle: 'DOODLE', camo: 'CAMO' };
const HERO_VIEW: Record<string, string> = { love: 'back', crew: 'back', splash: 'back', doodle: 'front', camo: 'front' };
const dvItems = [signature, ...latest.filter((p) => p.id !== signature.id)];
const dvData = dvItems.map((p) => ({
  id: p.id,
  slug: p.slug,
  name: p.name,
  price: p.price,
  color: p.colors[0].name,
  image: media(imageKeys(p)[0]).src,
  sizes: p.sizes,
  word: WORDS[p.art] ?? 'DIMENSION',
  short: p.short,
  category: categoryLabel(p.category, locale).replace(/s$/, ''),
  hero: media(`cutout/${p.id.toLowerCase()}-${HERO_VIEW[p.art] ?? 'front'}`).src,
  url: productUrl(p.slug),
}));
const first = dvData[0];
const firstStock = totalStock(dvItems[0]);
const dropStock = products.reduce((n, p) => n + totalStock(p), 0);
const ticker = products.map((p) => {
  const st = totalStock(p);
  return { id: p.id, name: p.name, url: productUrl(p.slug), hot: st < 16, label: st === 0 ? t('Épuisé', 'Sold out') : t(`${st} en stock`, `${st} in stock`) };
});

const manifesto = t(
  "On ne fait pas des vêtements pour remplir des placards. On fait des pièces qui se portent *fort,* qui se lavent cent fois et qu'on garde *dix ans.* Brodées. Imprimées. Tricotées. En séries courtes : quand c'est parti, c'est *parti.*",
  "We don't make clothes to fill wardrobes. We make pieces you wear *hard,* wash a hundred times and keep for *ten years.* Embroidered. Printed. Knitted. In short runs: when it's gone, it's *gone.*",
);
// Table de travail : les pièces à plat sur le gravier, à déplacer
const TABLE = [
  { x: 0.16, y: 0.45, r: -14, w: 21, view: 'back' },
  { x: 0.38, y: 0.62, r: 7, w: 23, view: 'front' },
  { x: 0.6, y: 0.4, r: -5, w: 22, view: 'back' },
  { x: 0.83, y: 0.58, r: 11, w: 20, view: 'front' },
  { x: 0.5, y: 0.82, r: -9, w: 18, view: 'front' },
];
const tableItems = dvItems.map((p, i) => ({
  ...TABLE[i % TABLE.length],
  name: p.name,
  price: fmt(p.price),
  url: productUrl(p.slug),
  img: media(`cutout/${p.id.toLowerCase()}-${TABLE[i % TABLE.length].view}`).src,
}));
const mfWords = manifesto.split(' ').map((w) => ({ text: w.replaceAll('*', ''), accent: w.includes('*') }));
---

<Base header="overlay" page="home" image={ogImage.src} route="home">
  <!-- HERO : la scène du drop -->
  <section class="dv theme-dark" data-dropviewer aria-labelledby="dv-title" style={`--gravel-img:url(${gravel.src})`}>
    <script type="application/json" data-dv-json set:html={JSON.stringify(dvData)} />
    <h1 id="dv-title" class="visually-hidden">dimension. — {brand.drop.name} : {brand.tagline}</h1>

    <div class="dv__word display" aria-hidden="true"><span data-dv-word>{first.word}</span></div>
    <img class="dv__fallback" data-dv-fallback src={first.hero} alt={`${first.name}`} width="1000" height="1250" fetchpriority="high" />
    <canvas class="dv__canvas" data-dv-canvas aria-hidden="true"></canvas>

    <div class="wrap dv__top">
      <p class="label dv__live"><span class="dv__dot" aria-hidden="true"></span>{brand.drop.name} — {t('en ligne', 'live')}</p>
      <p class="label dv__total">{t(`${dropStock} pièces restantes · séries courtes`, `${dropStock} pieces left · short runs`)}</p>
    </div>

    <ol class="dv__rail" role="list" aria-label={t('Pièces du drop', 'Pieces in the drop')}>
      {
        dvData.map((p, i) => (
          <li>
            <button type="button" class:list={['dv__go', i === 0 && 'is-active']} data-dv-go={i} aria-label={t(`Voir ${p.name}`, `View ${p.name}`)}>
              <span class="label">{String(i + 1).padStart(2, '0')}</span>
              <span class="dv__go-name">{p.name}</span>
              <span class="dv__go-bar" aria-hidden="true">
                <i />
              </span>
            </button>
          </li>
        ))
      }
    </ol>

    <div class="wrap dv__info">
      <div class="dv__meta">
        <p class="label dv__kicker"><span data-dv-index>01</span> / {String(dvData.length).padStart(2, '0')} — <span data-dv-cat>{first.category}</span></p>
        <p class="dv__name" data-dv-name>{first.name}</p>
        <p class="dv__short" data-dv-short>{first.short}</p>
      </div>
      <div class="dv__buy">
        <div class="dv__price-row">
          <p class="display dv__price" data-dv-price>{fmt(first.price)}</p>
          <p class="label dv__stock" data-dv-stock>{t(`${firstStock} pièces en stock`, `${firstStock} pieces in stock`)}</p>
        </div>
        <p class="label dv__hint">{t('Choisis ta taille — ajout instantané', 'Pick your size — instant add')}</p>
        <div class="dv__sizes" data-dv-sizes role="group" aria-label={t('Choisis ta taille pour ajouter au panier', 'Pick your size to add to bag')}>
          {first.sizes.map((s) => <button type="button" class="dv__size" data-dv-size={s.size} disabled={s.stock === 0}>{s.size}</button>)}
        </div>
        <a class="link link--under label dv__more" data-dv-link href={first.url}>{t('Voir la pièce en détail →', 'See the piece in detail →')}</a>
      </div>
    </div>
  </section>

  <!-- BANDEAU DE STOCK -->
  <div class="tick theme-dark" aria-label={t('Stock du drop en direct', 'Live drop stock')}>
    <div class="tick__track">
      {
        [0, 1].map((n) => (
          <ul class="tick__list" role="list" aria-hidden={n === 1 ? 'true' : undefined}>
            {ticker.map((tk) => (
              <li>
                <span class="tick__id">{tk.id}</span>
                <a href={tk.url} tabindex={n === 1 ? -1 : undefined}>{tk.name}</a>
                <span class:list={['tick__st', tk.hot && 'is-hot']}>{tk.label}</span>
                <span class="tick__sep" aria-hidden="true" />
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>

  <!-- NOUVEAUTÉS : grille claire (glissable au doigt sur mobile) -->
  <section id="drop" class="section drop" aria-labelledby="drop-title">
    <div class="wrap section-head drop__head">
      <div>
        <span class="label accent">{brand.drop.name} · {products.length} {t('pièces', 'pieces')}</span>
        <h2 id="drop-title" class="display h-2xl patch" data-chars>{t('Nouveautés', 'New in')}</h2>
      </div>
      <a href={href(locale, 'shop')} class="btn btn--ghost">{t('Toute la boutique', 'Shop all')} <span class="btn__dot" aria-hidden="true"></span></a>
    </div>
    <div class="drop__rail">
      <div class="drop__grid">
        <div class="drop__intro theme-brand">
          <p class="display drop__big">{products.length} {t('pièces.', 'pieces.')}<br /><span class="drop__ink">{t('Séries courtes.', 'Short runs.')}</span></p>
          <p>{t("Brodées, imprimées, tricotées. Quand c'est parti, c'est parti.", "Embroidered, printed, knitted. When it's gone, it's gone.")}</p>
          <p class="label drop__left">{t(`${dropStock} pièces restantes`, `${dropStock} pieces left`)}</p>
        </div>
        {
          latest.map((p, i) => (
            <div class="drop__item">
              <ProductCard product={p} index={i} vt sizes="(max-width: 700px) 72vw, (max-width: 1100px) 46vw, 30vw" />
            </div>
          ))
        }
      </div>
    </div>
    <ul class="wrap drop__facts" role="list">
      <li><span class="display">{t('Brodé', 'Embroidered')}</span><span>{t('monogramme au point plein', 'satin-stitch monogram')}</span></li>
      <li><span class="display">240 g/m²</span><span>{t('jersey de coton épais', 'heavyweight cotton jersey')}</span></li>
      <li><span class="display">{t('Offerte', 'Free')}</span><span>{t('livraison dès ', 'delivery from ')}{fmt(brand.shipping.freeThreshold)}</span></li>
      <li><span class="display">{t('14 j', '14 days')}</span><span>{t("pour changer d'avis", 'to change your mind')}</span></li>
    </ul>
  </section>

  <!-- PIÈCE SIGNATURE : devant / dos au scroll -->
  <section class="flip theme-dark" data-flip aria-labelledby="flip-title">
    <div class="flip__sticky">
      <div class="wrap flip__grid">
        <div class="flip__copy">
          <span class="label accent">{t('La pièce signature', 'The signature piece')}</span>
          <h2 id="flip-title" class="display flip__title patch">Love over<br />everything</h2>
          <ol class="flip__steps" role="list">
            <li data-flip-step="0" class="is-active">
              <span class="flip__n display">01</span>
              <div><strong>{t('Monogramme brodé', 'Embroidered monogram')}</strong><p>{t('Le « d° » au point plein, fil framboise cerné de noir, côté cœur.', 'The « d° » in satin stitch, raspberry thread outlined in black, over the heart.')}</p></div>
            </li>
            <li data-flip-step="1">
              <span class="flip__n display">02</span>
              <div><strong>{t('Jersey 240 g/m²', '240 g/m² jersey')}</strong><p>{t('Coton épais, col côtelé, épaules tombées : la coupe boxy qui tient.', 'Heavy cotton, ribbed collar, dropped shoulders: a boxy fit that holds its shape.')}</p></div>
            </li>
            <li data-flip-step="2">
              <span class="flip__n display">03</span>
              <div><strong>{t('Le cœur LOVE', 'The LOVE heart')}</strong><p>{t('Imprimé au dos en deux tons, gonflé comme une bulle. Signé over everything.', 'Printed on the back in two tones, puffed up like a bubble. Signed over everything.')}</p></div>
            </li>
          </ol>
          <div class="flip__buy">
            <span class="flip__price display">{fmt(signature.price)}</span>
            <a href={sigUrl} class="btn btn--accent btn--lg">{t('Je le veux', 'I want it')} <span class="btn__dot" aria-hidden="true"></span></a>
          </div>
        </div>

        <div class="flip__stage">
          <svg class="flip__ring" viewBox="0 0 100 100" aria-hidden="true">
            <circle cx="50" cy="50" r="48" pathLength="1"></circle>
            <circle class="flip__ring-p" cx="50" cy="50" r="48" pathLength="1"></circle>
          </svg>
          <span class="flip__side display" aria-hidden="true"><span data-flip-side data-front={t('Devant', 'Front')} data-back={t('Dos', 'Back')}>{t('Devant', 'Front')}</span></span>
          <div class="flip__card" data-flip-card>
            <div class="flip__face flip__face--front">
              <img src={teeFront.src} alt={teeFront.alt} width={teeFront.width} height={teeFront.height} loading="lazy" />
              <span class="flip__pin" style="left:50%;top:36%" aria-hidden="true"></span>
            </div>
            <div class="flip__face flip__face--back">
              <img src={teeBack.src} alt={teeBack.alt} width={teeBack.width} height={teeBack.height} loading="lazy" />
              <span class="flip__pin" style="left:50%;top:46%" aria-hidden="true"></span>
            </div>
          </div>
          <span class="flip__count label" aria-hidden="true"><span data-flip-count>01</span> / 03</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CATÉGORIES -->
  <section class="section cats" aria-labelledby="cats-title">
    <div class="wrap">
      <div class="section-head">
        <div data-reveal>
          <span class="label accent">{t('Explorer', 'Explore')}</span>
          <h2 id="cats-title" class="display h-2xl patch" data-chars>{t('Le vestiaire', 'The wardrobe')}</h2>
        </div>
      </div>
      <div class="cats__grid">
        <a href={href(locale, 'shop', '?categorie=t-shirts')} class="cat cat--a" data-reveal="clip" data-cursor={t('Explorer', 'Explore')}>
          <div class="media cat__media"><Img k="categories/t-shirts" sizes="(max-width: 860px) 100vw, 45vw" /></div>
          <div class="cat__meta">
            <h3 class="display cat__title">T-shirts</h3>
            <span class="label">{tshirtCount} {t('pièces', 'pieces')} →</span>
          </div>
        </a>
        <a href={href(locale, 'shop', '?categorie=maille')} class="cat cat--b" data-reveal="clip" style="--i:1" data-cursor={t('Explorer', 'Explore')}>
          <div class="media cat__media"><Img k="categories/maille" sizes="(max-width: 860px) 50vw, 30vw" /></div>
          <div class="cat__meta">
            <h3 class="display cat__title">{t('Maille', 'Knitwear')}</h3>
            <span class="label">{knitCount} {t(knitCount > 1 ? 'pièces' : 'pièce', knitCount > 1 ? 'pieces' : 'piece')} →</span>
          </div>
        </a>
        <a href={href(locale, 'lookbook')} class="cat cat--c" data-reveal="clip" style="--i:2" data-cursor={t('Voir', 'View')}>
          <div class="media cat__media"><Img k="categories/love" sizes="(max-width: 860px) 50vw, 25vw" /></div>
          <div class="cat__meta">
            <h3 class="display cat__title">Lookbook</h3>
            <span class="label">{brand.drop.name} →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- MANIFESTE : s'allume mot par mot -->
  <section class="mf theme-brand" data-scrub aria-label={t('Manifeste', 'Manifesto')}>
    <div class="mf__sticky">
      <div class="wrap">
        <p class="label mf__label">{t('Manifeste', 'Manifesto')}</p>
        <p class="display mf__text">
          {mfWords.map((w) => <span class:list={['mf__w', w.accent && 'is-accent']}>{w.text} </span>)}
        </p>
      </div>
    </div>
  </section>

  <!-- TABLE DE TRAVAIL : les pièces à plat, déplaçables -->
  <section class="tb theme-dark" data-table aria-labelledby="tb-title" style={`--gravel-img:url(${gravel.src})`}>
    <div class="wrap tb__head">
      <div>
        <span class="label accent">{t('Touche à tout', 'Hands on')}</span>
        <h2 id="tb-title" class="display h-2xl patch" data-chars>{t('Le drop à plat', 'The drop, laid flat')}</h2>
      </div>
      <p class="tb__hint">{t('Attrape les pièces, déplace-les, clique sur celle qui te plaît.', 'Grab the pieces, move them around, click the one you like.')}</p>
    </div>
    <div class="tb__stage" data-table-stage>
      {
        tableItems.map((it, i) => (
          <a class="tb__item" href={it.url} data-drag data-cursor={t('Attraper', 'Grab')} style={`--x:${it.x};--y:${it.y};--r:${it.r}deg;--w:${it.w};--z:${i + 1}`} aria-label={`${it.name}, ${it.price}`}>
            <img src={it.img} alt="" width="1000" height="1250" loading="lazy" draggable="false" />
            <span class="tb__tag">
              <b>{it.name}</b> {it.price}
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- BANDEAU SCRIPT -->
  <div class="ribbon-wrap" aria-hidden="true"><div class="ribbon">
    <div class="ribbon__track">
      {
        [0, 1].map(() => (
          <div class="ribbon__set">
            <span class="ribbon__word">dimension</span>
            <span class="ribbon__ring" />
            <span class="ribbon__caps display">Love over everything</span>
            <span class="ribbon__ring" />
            <span class="ribbon__word">dimension</span>
            <span class="ribbon__ring" />
            <span class="ribbon__caps display">{brand.drop.name}</span>
            <span class="ribbon__ring" />
          </div>
        ))
      }
    </div>
  </div></div>

  <!-- LOOKBOOK TEASER -->
  <section class="look" aria-labelledby="look-title">
    <a href={href(locale, 'lookbook')} class="look__hero media" data-cursor="Lookbook">
      <div class="look__img" data-parallax="0.12"><Img k="lookbook/1" sizes="100vw" /></div>
      <div class="look__overlay">
        <div class="wrap">
          <span class="label">{brand.drop.name} — Lookbook</span>
          <h2 id="look-title" class="display h-2xl" data-split>
            <span class="split-line"><span>{t('Sous le', 'Under the')}</span></span>
            <span class="split-line" style="--l:1"><span>{t('soleil', 'sun')}<span class="dot" aria-hidden="true"></span></span></span>
          </h2>
        </div>
      </div>
    </a>
  </section>

  <!-- SOCIAL -->
  <section class="section social" aria-labelledby="social-title">
    <div class="wrap">
      <div class="section-head social__head">
        <div data-reveal>
          <span class="label accent">On se retrouve là-bas</span>
          <h2 id="social-title" class="display h-xl" data-chars>{socialHandle}</h2>
        </div>
        <a href={tiktok} target="_blank" rel="noopener" class="btn btn--ghost" data-reveal>Suivre sur TikTok</a>
      </div>
      <ul class="social__grid" role="list">
        {
          [1, 2, 3, 4, 5, 6].map((n) => (
            <li data-reveal style={`--i:${n - 1}`}>
              <a href={tiktok} target="_blank" rel="noopener" class="social__item media ratio-11" aria-label={`Publication ${n} sur TikTok`}>
                <Img k={`social/${n}`} sizes="(max-width: 700px) 33vw, 16vw" />
                <span class="social__hover" aria-hidden="true">
                  <svg width="22" height="24" viewBox="0 0 22 24" fill="currentColor"><path d="M16 0c.4 3 2.3 5 5.6 5.3v3.9c-2 .1-3.8-.5-5.6-1.6V16c0 9.6-10.5 10.2-13.5 4.7C.3 17 1.6 10.8 8.6 10.6v4.1c-.6.1-1.1.2-1.6.4-1.4.5-2.2 1.4-2 3 .4 3 6.1 4 5.6-2V0z"></path></svg>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Newsletter />
</Base>

<style>
  /* ================= HERO : SCÈNE DU DROP ================= */
  .dv {
    position: relative;
    height: 100svh;
    min-height: 680px;
    overflow: hidden;
    isolation: isolate;
    background: var(--gravel) var(--gravel-img) center / cover;
  }
  .dv::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(ellipse 55% 60% at 50% 48%, transparent 30%, rgb(10 8 6 / 0.55) 100%),
      linear-gradient(0deg, rgb(10 8 6 / 0.75) 0%, transparent 38%),
      linear-gradient(180deg, rgb(10 8 6 / 0.55) 0%, transparent 25%);
  }
  .dv__word {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
    overflow: hidden;
  }
  .dv__word span {
    font-size: clamp(6rem, 24vw, 30rem);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(255 255 255 / 0.22);
    white-space: nowrap;
    letter-spacing: -0.01em;
    transform: translateY(-2%);
  }
  .dv__canvas,
  .dv__fallback {
    position: absolute;
    z-index: 1;
  }
  .dv__canvas {
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .dv__fallback {
    left: 50%;
    top: 50%;
    height: 86%;
    width: auto;
    transform: translate(-50%, -50%);
    object-fit: contain;
    transition: opacity 0.25s;
    filter: drop-shadow(18px 24px 18px rgb(0 0 0 / 0.55));
  }
  .dv:global(.has-gl) .dv__fallback {
    visibility: hidden;
  }
  .dv__top {
    position: absolute;
    inset: calc(var(--header-total) + 1rem) 0 auto;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .dv__live {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .dv__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 rgb(var(--accent-rgb) / 0.7);
    animation: live 1.6s infinite;
  }
  @keyframes live {
    70% {
      box-shadow: 0 0 0 10px rgb(var(--accent-rgb) / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(var(--accent-rgb) / 0);
    }
  }
  .dv__total {
    color: var(--muted);
  }
  .dv__rail {
    position: absolute;
    right: var(--gutter);
    top: 50%;
    z-index: 3;
    transform: translateY(-50%);
    display: grid;
    gap: 0.35rem;
    width: 250px;
    padding: 0.75rem 1rem;
    border-radius: 16px;
    border: 1.5px solid rgb(255 255 255 / 0.18);
    background: rgb(12 10 8 / 0.55);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .dv__go {
    width: 100%;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.25rem 0.75rem;
    padding: 0.45rem 0;
    text-align: left;
    color: var(--muted);
    transition: color 0.3s;
  }
  .dv__go:hover,
  .dv__go:global(.is-active) {
    color: var(--fg);
  }
  .dv__go-name {
    font-size: var(--fs-xs);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .dv__go-bar {
    display: block;
    grid-column: 1 / -1;
    height: 2px;
    background: var(--line);
    overflow: hidden;
  }
  .dv__go-bar i {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }
  .dv__go:global(.is-active) .dv__go-bar i {
    transform: scaleX(1);
  }
  .dv:global(.is-cycling) .dv__go:global(.is-active) .dv__go-bar i {
    animation: dv-fill var(--dv-autoplay, 7000ms) linear both;
  }
  .dv:global(.is-paused) .dv__go-bar i {
    animation-play-state: paused !important;
  }
  @keyframes dv-fill {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  .dv__info {
    position: absolute;
    inset: auto 0 0;
    z-index: 3;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 2rem;
    padding-bottom: clamp(1.5rem, 4vh, 2.75rem);
  }
  .dv__meta,
  .dv__buy {
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.9s var(--ease-out),
      transform 1.1s var(--ease-out);
  }
  .dv__buy {
    transition-delay: 0.15s;
  }
  .dv:global(.is-ready) .dv__meta,
  .dv:global(.is-ready) .dv__buy {
    opacity: 1;
    transform: none;
  }
  .dv__kicker {
    color: var(--muted);
    margin-bottom: 0.75rem;
  }
  .dv__name {
    font-family: var(--f-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    line-height: 1;
    font-size: clamp(1.9rem, 3.6vw, 4rem);
    max-width: 11ch;
    min-height: 2.05em;
    display: flex;
    align-items: end;
  }
  .dv__short {
    margin-top: 0.9rem;
    color: var(--fg-2);
    font-size: var(--fs-sm);
  }
  .dv__buy {
    display: grid;
    gap: 0.75rem;
    justify-items: end;
    text-align: right;
  }
  .dv__price-row {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }
  .dv__price {
    font-size: clamp(1.8rem, 2.6vw, 2.8rem);
  }
  .dv__stock {
    color: var(--muted);
  }
  .dv__stock :global(.dv__hot) {
    color: var(--accent-2);
  }
  .dv__hint {
    color: var(--muted);
  }
  .dv__sizes {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: end;
  }
  .dv__sizes :global(.dv__size) {
    position: relative;
    width: 56px;
    height: 52px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    transition:
      background 0.2s,
      color 0.2s,
      border-color 0.2s,
      transform 0.2s;
  }
  .dv__sizes :global(.dv__size:hover) {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
  .dv__sizes :global(.dv__size:disabled) {
    color: var(--muted);
    opacity: 0.45;
    background: linear-gradient(to top right, transparent calc(50% - 0.5px), var(--line-strong) 50%, transparent calc(50% + 0.5px));
  }
  .dv__sizes :global(.dv__size.is-low)::after {
    content: '';
    position: absolute;
    top: 5px;
    right: 5px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }
  .dv__sizes :global(.dv__size.is-added) {
    animation: added 0.7s var(--ease-out);
  }
  @keyframes added {
    30% {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--on-accent);
      transform: scale(0.92);
    }
  }
  .dv__more {
    color: var(--fg-2);
  }
  @media (max-width: 1100px) {
    .dv__rail {
      top: auto;
      bottom: auto;
      inset: calc(var(--header-total) + 2.6rem) var(--gutter) auto;
      transform: none;
      width: auto;
      display: flex;
      gap: 4px;
    }
    .dv__rail li {
      flex: 1;
    }
    .dv__rail {
      padding: 0;
      border: 0;
      background: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    .dv__go {
      display: block;
      padding: 0.5rem 0;
    }
    .dv__go .label,
    .dv__go-name {
      display: none;
    }
    .dv__total {
      display: none;
    }
  }
  @media (max-width: 860px) {
    .dv {
      min-height: 640px;
    }
    .dv__fallback {
      top: 40%;
      height: 60%;
    }
    .dv__info {
      grid-template-columns: 1fr;
      gap: 1rem;
      /* laisse la place à la barre d'onglets flottante */
      padding-bottom: calc(var(--tabbar-h, 0px) + 1.75rem + env(safe-area-inset-bottom));
    }
    .dv__name {
      font-size: clamp(1.6rem, 7.4vw, 2.4rem);
      min-height: 0;
      max-width: none;
    }
    .dv__short {
      display: none;
    }
    .dv__buy {
      justify-items: stretch;
      text-align: left;
    }
    .dv__price-row {
      justify-content: space-between;
    }
    .dv__price {
      font-size: 1.7rem;
    }
    .dv__sizes {
      justify-content: start;
      flex-wrap: nowrap;
    }
    .dv__sizes :global(.dv__size) {
      flex: 1;
      width: auto;
      height: 48px;
    }
    .dv__hint,
    .dv__more {
      display: none;
    }
  }

  /* ================= BANDEAU DE STOCK ================= */
  .tick {
    border-block: 1px solid var(--line);
    overflow: hidden;
    background: var(--bg-2);
  }
  .tick__track {
    display: flex;
    width: max-content;
    animation: tick 40s linear infinite;
  }
  .tick:hover .tick__track {
    animation-play-state: paused;
  }
  @keyframes tick {
    to {
      transform: translateX(-50%);
    }
  }
  .tick__list {
    display: flex;
  }
  .tick__list li {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.9rem 0;
    font-family: var(--f-mono);
    font-size: var(--fs-2xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }
  .tick__id {
    color: var(--muted);
  }
  .tick__list a:hover {
    color: var(--accent-2);
  }
  .tick__st {
    color: var(--ok);
  }
  .tick__st.is-hot {
    color: var(--accent-2);
  }
  .tick__sep {
    width: 6px;
    height: 6px;
    border: 1px solid var(--muted);
    border-radius: 50%;
    margin-inline: 1.5rem;
  }

  /* ================= TABLE DE TRAVAIL ================= */
  .tb {
    position: relative;
    padding-top: var(--space-lg);
    background: var(--gravel) var(--gravel-img) center / cover;
    overflow: hidden;
  }
  .tb::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(10 8 6 / 0.75) 0%, transparent 30%),
      linear-gradient(120deg, rgb(255 236 200 / 0.12), transparent 50%);
    pointer-events: none;
  }
  .tb__head {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .tb__head .label {
    display: block;
    margin-bottom: 0.9rem;
  }
  .tb__hint {
    max-width: 30ch;
    color: var(--fg-2);
    font-size: var(--fs-sm);
  }
  .tb__stage {
    position: relative;
    height: clamp(520px, 86vh, 900px);
    touch-action: pan-y;
  }
  .tb__item {
    --dx: 0px;
    --dy: 0px;
    --lift: 0;
    position: absolute;
    left: calc(var(--x) * 100%);
    top: calc(var(--y) * 100%);
    width: calc(var(--w) * 1vw);
    min-width: 150px;
    max-width: 380px;
    z-index: var(--z);
    transform: translate(-50%, -50%) translate(var(--dx), var(--dy)) rotate(var(--r)) scale(calc(1 + var(--lift) * 0.06));
    touch-action: none;
    cursor: grab;
    user-select: none;
    -webkit-user-drag: none;
  }
  .tb__item img {
    width: 100%;
    height: auto;
    pointer-events: none;
    filter: drop-shadow(calc(8px + var(--lift) * 14px) calc(12px + var(--lift) * 22px) calc(8px + var(--lift) * 14px) rgb(0 0 0 / 0.55));
    transition: filter 0.25s var(--ease-out);
  }
  .tb__item:global(.is-grabbing) {
    cursor: grabbing;
    --lift: 1;
  }
  .tb__tag {
    position: absolute;
    left: 50%;
    bottom: 6%;
    transform: translateX(-50%) rotate(calc(var(--r) * -1)) translateY(8px);
    white-space: nowrap;
    padding: 0.45rem 0.75rem;
    border-radius: 10px;
    border: 2px solid var(--ink);
    background: var(--cotton);
    color: var(--ink);
    box-shadow: 3px 3px 0 var(--brand);
    font-size: var(--fs-xs);
    opacity: 0;
    transition:
      opacity 0.25s,
      transform 0.3s var(--ease-out);
    pointer-events: none;
  }
  .tb__item:hover .tb__tag,
  .tb__item:focus-visible .tb__tag {
    opacity: 1;
    transform: translateX(-50%) rotate(calc(var(--r) * -1));
  }
  @media (max-width: 860px) {
    .tb__stage {
      height: 120vw;
      max-height: 680px;
    }
    .tb__item {
      width: calc(var(--w) * 1.9vw);
      min-width: 0;
    }
    .tb__tag {
      display: none;
    }
  }

  /* ================= MANIFESTE ================= */
  .mf {
    --mp: 0;
    height: 190vh;
    position: relative;
  }
  .mf__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    display: flex;
    align-items: center;
  }
  .mf__label {
    margin-bottom: 1.5rem;
  }
  .mf__text {
    font-size: clamp(1.5rem, 3.5vw, 4.2rem);
    line-height: 1.04;
  }
  .mf__w {
    opacity: 0.1;
    transition:
      opacity 0.35s,
      color 0.35s;
  }
  .mf__w:global(.is-lit) {
    opacity: 1;
  }
  .mf__w.is-accent:global(.is-lit) {
    color: var(--ink);
  }
  .mf__w {
    opacity: 0.22;
  }
  @keyframes ping {
    to {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  /* ================= NOUVEAUTÉS ================= */
  .drop__head {
    margin-bottom: var(--space-md);
  }
  .drop__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 3vw, 3rem) clamp(14px, 1.6vw, 28px);
    padding-inline: var(--gutter);
    max-width: 1720px;
    margin-inline: auto;
  }
  .drop__intro {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(1.5rem, 2.4vw, 2.5rem);
    border: 2px solid var(--ink);
    border-radius: 16px;
    box-shadow: 6px 6px 0 var(--ink);
    aspect-ratio: 4 / 5;
  }
  .drop__big {
    font-size: clamp(1.6rem, 2.6vw, 2.8rem);
  }
  .drop__ink {
    color: var(--ink);
  }
  .drop__left {
    display: inline-flex;
    align-self: start;
    padding: 0.4rem 0.7rem;
    border: 1.5px solid currentColor;
    border-radius: 999px;
  }
  .drop__facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: var(--space-lg);
    border: 2px solid var(--ink);
    border-radius: 16px;
    overflow: hidden;
    background: var(--bg);
  }
  .drop__facts li {
    display: grid;
    gap: 0.35rem;
    padding: 1.25rem clamp(1rem, 2vw, 1.75rem);
  }
  .drop__facts li + li {
    border-left: 2px dashed var(--line-strong);
  }
  .drop__facts .display {
    font-size: clamp(1.1rem, 1.6vw, 1.6rem);
    color: var(--brand);
  }
  .drop__facts li > span:last-child {
    font-size: var(--fs-sm);
    color: var(--fg-2);
  }
  @media (max-width: 1100px) {
    .drop__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .drop__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .drop__facts li:nth-child(3) {
      border-left: 0;
    }
    .drop__facts li:nth-child(n + 3) {
      border-top: 2px dashed var(--line-strong);
    }
  }
  /* Mobile : rail horizontal natif, avec aimantation sur chaque carte */
  @media (max-width: 700px) {
    .drop__rail {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }
    .drop__rail::-webkit-scrollbar {
      display: none;
    }
    .drop__grid {
      display: flex;
      gap: 12px;
      width: max-content;
      max-width: none;
      padding-bottom: 10px;
    }
    .drop__intro,
    .drop__item {
      flex: none;
      width: 72vw;
      scroll-snap-align: start;
    }
    .drop__intro {
      width: 60vw;
    }
  }

  /* ================= DEVANT / DOS ================= */
  .flip {
    --fp: 0;
    position: relative;
    height: 230vh;
    background: var(--bg);
  }
  /* Halo framboise : seule son opacité varie (composée par le GPU, sans repeindre). */
  .flip__sticky::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 72% 52%, rgb(var(--brand-rgb) / 0.8), transparent 52%);
    opacity: calc(0.3 + var(--fp) * 0.7);
    will-change: opacity;
    pointer-events: none;
  }
  .flip__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .flip__grid {
    position: relative;
    z-index: 1;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: var(--space-lg);
    align-items: center;
    padding-top: calc(var(--header-total) * 0.5);
  }
  .flip__copy {
    display: grid;
    gap: 1.5rem;
    align-content: center;
  }
  .flip__title {
    font-size: clamp(1.7rem, 2.9vw, 3.3rem);
  }
  .flip__steps {
    display: grid;
    gap: 0.25rem;
  }
  .flip__steps li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    padding-block: 1rem;
    border-top: 1px solid var(--line-strong);
    opacity: 0.32;
    transition: opacity 0.5s var(--ease-out);
  }
  .flip__steps li:global(.is-active) {
    opacity: 1;
  }
  .flip__steps strong {
    font-size: var(--fs-md);
  }
  .flip__steps p {
    font-size: var(--fs-sm);
    color: var(--fg-2);
    max-width: 40ch;
    margin-top: 0.2rem;
  }
  .flip__n {
    font-size: 1.2rem;
    color: transparent;
    -webkit-text-stroke: 1.2px var(--accent);
    transition: color 0.5s;
  }
  .flip__steps li:global(.is-active) .flip__n {
    color: var(--accent);
  }
  .flip__buy {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .flip__price {
    font-size: 1.9rem;
  }
  .flip__stage {
    position: relative;
    aspect-ratio: 1;
    width: min(100%, 78vh);
    justify-self: center;
    display: grid;
    place-items: center;
    perspective: 1600px;
  }
  .flip__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }
  .flip__ring circle {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 0.25;
  }
  .flip__ring .flip__ring-p {
    stroke: var(--accent);
    stroke-width: 0.6;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--fp));
  }
  .flip__side {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-size: clamp(2.6rem, 7vw, 8rem);
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(var(--fg-rgb) / 0.1);
    white-space: nowrap;
    pointer-events: none;
  }
  .flip__card {
    position: relative;
    width: 76%;
    aspect-ratio: 4 / 5;
    transform-style: preserve-3d;
    transform: rotateX(6deg) rotateZ(-4deg);
    will-change: transform;
  }
  .flip__face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .flip__face img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 34px 38px rgb(0 0 0 / 0.65));
  }
  .flip__face--back {
    transform: rotateY(180deg);
  }
  .flip__pin {
    position: absolute;
    width: 16px;
    height: 16px;
    margin: -8px 0 0 -8px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 4px var(--accent);
    opacity: 0;
    transform: scale(0.4);
    transition:
      opacity 0.4s,
      transform 0.5s var(--ease-out);
  }
  .flip__pin::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    animation: ping 2s var(--ease-out) infinite;
  }
  .flip:global([data-step='0']) .flip__face--front .flip__pin,
  .flip:global([data-step='2']) .flip__face--back .flip__pin {
    opacity: 1;
    transform: none;
  }
  .flip__count {
    position: absolute;
    bottom: 4%;
    right: 4%;
  }
  @media (max-width: 860px) {
    .flip {
      height: 220vh;
    }
    .flip__grid {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      padding-top: calc(var(--header-total) + 0.5rem);
    }
    .flip__stage {
      order: -1;
      width: min(100%, 44vh);
    }
    .flip__copy {
      gap: 0.75rem;
    }
    .flip__title {
      font-size: 1.45rem;
    }
    .flip__copy > .label {
      display: none;
    }
    .flip__steps li {
      display: none;
      padding-block: 0.6rem;
    }
    .flip__steps li:global(.is-active) {
      display: grid;
    }
    .flip__price {
      font-size: 1.5rem;
    }
  }

  /* CATÉGORIES : tuiles cousues, titre en étiquette */
  .cats__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(12px, 1.4vw, 24px);
  }
  .cat {
    position: relative;
    display: block;
    border: 2px solid var(--ink);
    border-radius: 16px;
    overflow: hidden;
  }
  /* (sélecteurs renforcés pour passer devant les styles d'apparition) */
  .cats__grid .cat {
    transition:
      clip-path 1.1s var(--ease-out) calc(var(--i, 0) * 90ms),
      transform 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out);
  }
  .cats__grid .cat:hover {
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 var(--brand);
  }
  .cat__media {
    aspect-ratio: 4 / 5;
  }
  .cat__media :global(img) {
    transition: transform 0.8s var(--ease-out);
  }
  .cat:hover .cat__media :global(img) {
    transform: scale(1.04);
  }
  .cat__meta {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1rem;
    padding: 0.8rem 1rem;
    border: 2px solid var(--ink);
    border-radius: 12px;
    background: var(--cotton);
    color: var(--ink);
  }
  .cat__title {
    font-size: clamp(1rem, 1.5vw, 1.5rem);
  }
  .cat .label {
    color: var(--brand);
  }
  @media (max-width: 860px) {
    .cats__grid {
      grid-template-columns: 1fr 1fr;
    }
    .cat--a {
      grid-column: 1 / -1;
    }
    .cat--a .cat__media {
      aspect-ratio: 16 / 11;
    }
    .cat--b .cat__meta,
    .cat--c .cat__meta {
      flex-direction: column;
      align-items: start;
      left: 8px;
      right: 8px;
      bottom: 8px;
      padding: 0.6rem 0.7rem;
    }
  }

  /* RIBBON */
  .ribbon-wrap {
    overflow: hidden;
    padding-block: 1.5rem;
  }
  .ribbon {
    background: var(--ink);
    color: var(--cotton);
    border-block: 2px solid var(--ink);
    overflow: hidden;
    padding-block: clamp(1rem, 2vw, 1.75rem);
    transform: rotate(-1.4deg) scale(1.03);
  }
  .ribbon__track {
    display: flex;
    width: max-content;
    animation: ribbon 32s linear infinite;
  }
  .ribbon__set {
    display: flex;
    align-items: center;
  }
  .ribbon__word {
    font-family: var(--f-display);
    font-weight: 700;
    letter-spacing: -0.05em;
    font-size: clamp(1.8rem, 4.4vw, 4rem);
    line-height: 1;
    padding-inline: 0.4em;
  }
