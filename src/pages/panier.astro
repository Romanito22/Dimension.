---
import Base from '../layouts/Base.astro';
import brand from '../data/brand.json';
---

<Base title="Panier" page="cart" noindex>
  <div class="wrap cart">
    <h1 class="display h-xl cart__title">Panier <sup data-cart-count>0</sup></h1>
    <div class="cart__grid">
      <div>
        <div class="cart__ship" data-ship>
          <p data-ship-text></p>
          <div class="cart__bar"><span data-ship-bar></span></div>
        </div>
        <div data-cart-lines></div>
      </div>
      <aside class="cart__sum" data-cart-foot>
        <div class="cart__row"><span class="label">Sous-total</span><strong data-cart-subtotal>0 €</strong></div>
        <p class="muted cart__note">Livraison offerte dès {brand.shipping.freeThreshold} €. Frais calculés à l'étape suivante.</p>
        <a href="/commande" class="btn btn--accent btn--lg btn--block">Commander <span class="btn__dot" aria-hidden="true"></span></a>
        <a href="/boutique" class="link label cart__back">Continuer mes achats</a>
      </aside>
    </div>
  </div>
</Base>

<style>
  .cart {
    padding-block: var(--space-md) var(--space-lg);
  }
  .cart__title sup {
    font-size: 0.35em;
    color: var(--accent);
    vertical-align: 1.6em;
  }
  .cart__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-md);
    margin-top: var(--space-md);
    align-items: start;
  }
  .cart__ship {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-sm);
  }
  .cart__bar {
    margin-top: 0.6rem;
    height: 3px;
    background: var(--surface);
  }
  .cart__bar span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--accent);
    transition: width 0.8s var(--ease-out);
  }
  .cart__sum {
    position: sticky;
    top: calc(var(--header-total) + 1rem);
    display: grid;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--surface);
    border-radius: var(--radius);
  }
  .cart__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 1.15rem;
  }
  .cart__note {
    font-size: var(--fs-xs);
  }
  .cart__back {
    justify-self: center;
  }
  @media (max-width: 860px) {
    .cart__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
