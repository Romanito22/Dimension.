---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import Img from '../components/Img.astro';
import Logo from '../components/Logo.astro';
import Newsletter from '../components/Newsletter.astro';
import { media } from '../lib/media';
import { products, brand, byNewest, formatPrice, imageKeys, categoryLabel, totalStock } from '../lib/shop';

const ogImage = media('hero/desktop');
const teeBack = media('cutout/dim-001-back');
const teeFront = media('cutout/dim-001-front');
const latest = byNewest(products);
const signature = products.find((p) => p.art === 'love')!;
const tshirtCount = products.filter((p) => p.category === 't-shirts').length;
const knitCount = products.filter((p) => p.category === 'maille').length;
const socialHandle = brand.handle;
const tiktok = brand.socials.find((s) => s.name === 'TikTok')!.url;
const sigUrl = `/produit/${signature.slug}`;

// Scène du hero : la pièce signature d'abord, puis les nouveautés
const WORDS: Record<string, string> = { love: 'LOVE', crew: 'CREW', splash: 'SPLASH', doodle: 'DOODLE', camo: 'CAMO' };
const HERO_VIEW: Record<string, string> = { love: 'back', crew: 'back', splash: 'back', doodle: 'front', camo: 'front' };
const dvItems = [signature, ...latest.filter((p) => p.id !== signature.id)];
const dvData = dvItems.map((p) => ({
  id: p.id,
  slug: p.slug,
  name: p.name,
  price: p.price,
  color: p.colors[0].name,
  image: media(imageKeys(p)[0]).src,
  sizes: p.sizes,
  word: WORDS[p.art] ?? 'DIMENSION',
  short: p.short,
  category: categoryLabel(p.category).replace(/s$/, ''),
  hero: media(`cutout/${p.id.toLowerCase()}-${HERO_VIEW[p.art] ?? 'front'}`).src,
  url: `/produit/${p.slug}`,
}));
const first = dvData[0];
const firstStock = totalStock(dvItems[0]);
const dropStock = products.reduce((n, p) => n + totalStock(p), 0);
const ticker = products.map((p) => {
  const st = totalStock(p);
  return { id: p.id, name: p.name, url: `/produit/${p.slug}`, hot: st < 16, label: st === 0 ? 'Épuisé' : `${st} en stock` };
});

const manifesto =
  "On ne fait pas des vêtements pour remplir des placards. On fait des pièces qui se portent *fort,* qui se lavent cent fois et qu'on garde *dix ans.* Brodées. Imprimées. Tricotées. En séries courtes : quand c'est parti, c'est *parti.*";
const mfWords = manifesto.split(' ').map((w) => ({ text: w.replaceAll('*', ''), accent: w.includes('*') }));
---

<Base header="overlay" page="home" image={ogImage.src}>
  <!-- HERO : la scène du drop -->
  <section class="dv" data-dropviewer aria-labelledby="dv-title">
    <script type="application/json" data-dv-json set:html={JSON.stringify(dvData)} />
    <h1 id="dv-title" class="visually-hidden">dimension. — {brand.drop.name} : {brand.tagline}</h1>

    <div class="dv__word display" aria-hidden="true"><span data-dv-word>{first.word}</span></div>
    <img class="dv__fallback" data-dv-fallback src={first.hero} alt={`${first.name}`} width="1000" height="1250" fetchpriority="high" />
    <canvas class="dv__canvas" data-dv-canvas aria-hidden="true"></canvas>

    <div class="wrap dv__top">
      <p class="label dv__live"><span class="dv__dot" aria-hidden="true"></span>{brand.drop.name} — en ligne</p>
      <p class="label dv__total">{dropStock} pièces restantes · séries courtes</p>
    </div>

    <ol class="dv__rail" role="list" aria-label="Pièces du drop">
      {
        dvData.map((p, i) => (
          <li>
            <button type="button" class:list={['dv__go', i === 0 && 'is-active']} data-dv-go={i} aria-label={`Voir ${p.name}`}>
              <span class="label">{String(i + 1).padStart(2, '0')}</span>
              <span class="dv__go-name">{p.name}</span>
              <span class="dv__go-bar" aria-hidden="true">
                <i />
              </span>
            </button>
          </li>
        ))
      }
    </ol>

    <div class="wrap dv__info">
      <div class="dv__meta">
        <p class="label dv__kicker"><span data-dv-index>01</span> / {String(dvData.length).padStart(2, '0')} — <span data-dv-cat>{first.category}</span></p>
        <p class="chrome dv__name" data-dv-name>{first.name}</p>
        <p class="dv__short" data-dv-short>{first.short}</p>
      </div>
      <div class="dv__buy">
        <div class="dv__price-row">
          <p class="display chrome dv__price" data-dv-price>{formatPrice(first.price)}</p>
          <p class="label dv__stock" data-dv-stock>{firstStock} pièces en stock</p>
        </div>
        <p class="label dv__hint">Choisis ta taille — ajout instantané</p>
        <div class="dv__sizes" data-dv-sizes role="group" aria-label="Choisis ta taille pour ajouter au panier">
          {first.sizes.map((s) => <button type="button" class="dv__size" data-dv-size={s.size} disabled={s.stock === 0}>{s.size}</button>)}
        </div>
        <a class="link link--under label dv__more" data-dv-link href={first.url}>Voir la pièce en détail →</a>
      </div>
    </div>
  </section>

  <!-- BANDEAU DE STOCK -->
  <div class="tick" aria-label="Stock du drop en direct">
    <div class="tick__track">
      {
        [0, 1].map((n) => (
          <ul class="tick__list" role="list" aria-hidden={n === 1 ? 'true' : undefined}>
            {ticker.map((t) => (
              <li>
                <span class="tick__id">{t.id}</span>
                <a href={t.url} tabindex={n === 1 ? -1 : undefined}>{t.name}</a>
                <span class:list={['tick__st', t.hot && 'is-hot']}>{t.label}</span>
                <span class="tick__sep" aria-hidden="true" />
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>

  <!-- NOUVEAUTÉS : défilement horizontal -->
  <section id="drop" class="hs" data-hscroll aria-labelledby="drop-title">
    <div class="hs__sticky">
      <div class="wrap hs__head">
        <div>
          <span class="label accent">{brand.drop.name} · {products.length} pièces</span>
          <h2 id="drop-title" class="display h-xl" data-chars>Nouveautés</h2>
        </div>
        <a href="/boutique" class="link link--under label">Tout voir</a>
      </div>
      <div class="hs__viewport">
        <div class="hs__track" data-hs-track>
          <div class="hs__intro">
            <p class="display chrome hs__big">5 pièces.<br /><span class="accent">Séries courtes.</span></p>
            <p class="muted">Brodées, imprimées, tricotées. Quand c'est parti, c'est parti.</p>
            <span class="label hs__hint" aria-hidden="true">Continue de scroller <span class="hs__arrow">→</span></span>
          </div>
          {
            latest.map((p, i) => (
              <div class="hs__item" style={`--i:${i}`}>
                <span class="hs__num display" aria-hidden="true">0{i + 1}</span>
                <ProductCard product={p} index={i} vt sizes="(max-width: 860px) 74vw, 26vw" />
              </div>
            ))
          }
          <a href="/boutique" class="hs__end" data-cursor="Boutique">
            <span class="hs__end-ring" aria-hidden="true"></span>
            <span class="display">Toute la<br />boutique →</span>
          </a>
        </div>
      </div>
      <div class="wrap hs__bar"><span data-hs-progress></span></div>
    </div>
  </section>

  <!-- PIÈCE SIGNATURE : devant / dos au scroll -->
  <section class="flip" data-flip aria-labelledby="flip-title">
    <div class="flip__sticky">
      <div class="wrap flip__grid">
        <div class="flip__copy">
          <span class="label accent">La pièce signature</span>
          <h2 id="flip-title" class="display flip__title">Love over<br />everything</h2>
          <ol class="flip__steps" role="list">
            <li data-flip-step="0" class="is-active">
              <span class="flip__n display">01</span>
              <div><strong>Monogramme brodé</strong><p>Le « d° » au point plein, fil framboise cerné de noir, côté cœur.</p></div>
            </li>
            <li data-flip-step="1">
              <span class="flip__n display">02</span>
              <div><strong>Jersey 240 g/m²</strong><p>Coton épais, col côtelé, épaules tombées : la coupe boxy qui tient.</p></div>
            </li>
            <li data-flip-step="2">
              <span class="flip__n display">03</span>
              <div><strong>Le cœur LOVE</strong><p>Imprimé au dos en deux tons, gonflé comme une bulle. Signé over everything.</p></div>
            </li>
          </ol>
          <div class="flip__buy">
            <span class="flip__price display chrome">{formatPrice(signature.price)}</span>
            <a href={sigUrl} class="btn btn--accent btn--lg">Je le veux <span class="btn__dot" aria-hidden="true"></span></a>
          </div>
        </div>

        <div class="flip__stage">
          <svg class="flip__ring" viewBox="0 0 100 100" aria-hidden="true">
            <circle cx="50" cy="50" r="48" pathLength="1"></circle>
            <circle class="flip__ring-p" cx="50" cy="50" r="48" pathLength="1"></circle>
          </svg>
          <span class="flip__side display" aria-hidden="true"><span data-flip-side>Devant</span></span>
          <div class="flip__card" data-flip-card>
            <div class="flip__face flip__face--front">
              <img src={teeFront.src} alt={teeFront.alt} width={teeFront.width} height={teeFront.height} loading="lazy" />
              <span class="flip__pin" style="left:50%;top:36%" aria-hidden="true"></span>
            </div>
            <div class="flip__face flip__face--back">
              <img src={teeBack.src} alt={teeBack.alt} width={teeBack.width} height={teeBack.height} loading="lazy" />
              <span class="flip__pin" style="left:50%;top:46%" aria-hidden="true"></span>
            </div>
          </div>
          <span class="flip__count label" aria-hidden="true"><span data-flip-count>01</span> / 03</span>
        </div>
      </div>
    </div>
  </section>

  <!-- MANIFESTE : s'allume mot par mot -->
  <section class="mf" data-scrub aria-label="Manifeste">
    <div class="mf__sticky">
      <div class="wrap">
        <p class="label accent mf__label">Manifeste</p>
        <p class="display mf__text">
          {mfWords.map((w) => <span class:list={['mf__w', w.accent && 'is-accent']}>{w.text} </span>)}
        </p>
      </div>
    </div>
  </section>

  <!-- CATÉGORIES -->
  <section class="section cats" aria-labelledby="cats-title">
    <div class="wrap">
      <div class="section-head">
        <div data-reveal>
          <span class="label accent">Explorer</span>
          <h2 id="cats-title" class="display h-xl" data-chars>Le vestiaire</h2>
        </div>
      </div>
      <div class="cats__grid">
        <a href="/boutique?categorie=t-shirts" class="cat cat--a" data-reveal="clip" data-cursor="Explorer">
          <div class="media cat__media"><Img k="categories/t-shirts" sizes="(max-width: 860px) 100vw, 45vw" /></div>
          <div class="cat__meta">
            <h3 class="display cat__title">T-shirts</h3>
            <span class="label">{tshirtCount} pièces →</span>
          </div>
        </a>
        <a href="/boutique?categorie=maille" class="cat cat--b" data-reveal="clip" style="--i:1" data-cursor="Explorer">
          <div class="media cat__media"><Img k="categories/maille" sizes="(max-width: 860px) 50vw, 30vw" /></div>
          <div class="cat__meta">
            <h3 class="display cat__title">Maille</h3>
            <span class="label">{knitCount} pièce →</span>
          </div>
        </a>
        <a href="/lookbook" class="cat cat--c" data-reveal="clip" style="--i:2" data-cursor="Voir">
          <div class="media cat__media"><Img k="categories/love" sizes="(max-width: 860px) 50vw, 25vw" /></div>
          <div class="cat__meta">
            <h3 class="display cat__title">Lookbook</h3>
            <span class="label">{brand.drop.name} →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- BANDEAU SCRIPT -->
  <div class="ribbon-wrap" aria-hidden="true"><div class="ribbon">
    <div class="ribbon__track">
      {
        [0, 1].map(() => (
          <div class="ribbon__set">
            <span class="ribbon__word">dimension</span>
            <span class="ribbon__ring" />
            <span class="ribbon__caps display">Love over everything</span>
            <span class="ribbon__ring" />
            <span class="ribbon__word">dimension</span>
            <span class="ribbon__ring" />
            <span class="ribbon__caps display">{brand.drop.name}</span>
            <span class="ribbon__ring" />
          </div>
        ))
      }
    </div>
  </div></div>

  <!-- STORY -->
  <section class="section story" aria-labelledby="story-title">
    <div class="wrap story__grid">
      <div class="story__copy">
        <span class="label accent" data-reveal>{brand.story.kicker}</span>
        <h2 id="story-title" class="display h-xl" data-reveal style="--i:1">{brand.story.title}</h2>
        <p class="lede" data-reveal style="--i:2">{brand.story.intro}</p>
        <a href="/la-marque" class="btn btn--ghost" data-reveal style="--i:3">Notre histoire <span class="btn__dot" aria-hidden="true"></span></a>
      </div>
      <div class="story__visual">
        <div class="media ratio-45 story__img" data-reveal="clip">
          <Img k="story/1" sizes="(max-width: 860px) 100vw, 40vw" />
        </div>
        <div class="story__badge" aria-hidden="true">
          <Logo variant="mono" />
        </div>
      </div>
    </div>
    <ul class="wrap story__facts" role="list">
      <li data-reveal><span class="display">Brodé</span><span class="muted">monogramme au point plein</span></li>
      <li data-reveal style="--i:1"><span class="display">240 g/m²</span><span class="muted">jersey de coton épais</span></li>
      <li data-reveal style="--i:2"><span class="display">Séries</span><span class="muted">courtes, par drops</span></li>
      <li data-reveal style="--i:3"><span class="display">14 j</span><span class="muted">pour changer d'avis</span></li>
    </ul>
  </section>

  <!-- LOOKBOOK TEASER -->
  <section class="look" aria-labelledby="look-title">
    <a href="/lookbook" class="look__hero media" data-cursor="Lookbook">
      <div class="look__img" data-parallax="0.12"><Img k="lookbook/1" sizes="100vw" /></div>
      <div class="look__overlay">
        <div class="wrap">
          <span class="label">{brand.drop.name} — Lookbook</span>
          <h2 id="look-title" class="display h-2xl" data-split>
            <span class="split-line"><span>Sous le</span></span>
            <span class="split-line" style="--l:1"><span>soleil<span class="dot" aria-hidden="true"></span></span></span>
          </h2>
        </div>
      </div>
    </a>
  </section>

  <!-- SOCIAL -->
  <section class="section social" aria-labelledby="social-title">
    <div class="wrap">
      <div class="section-head social__head">
        <div data-reveal>
          <span class="label accent">On se retrouve là-bas</span>
          <h2 id="social-title" class="display h-xl" data-chars>{socialHandle}</h2>
        </div>
        <a href={tiktok} target="_blank" rel="noopener" class="btn btn--ghost" data-reveal>Suivre sur TikTok</a>
      </div>
      <ul class="social__grid" role="list">
        {
          [1, 2, 3, 4, 5, 6].map((n) => (
            <li data-reveal style={`--i:${n - 1}`}>
              <a href={tiktok} target="_blank" rel="noopener" class="social__item media ratio-11" aria-label={`Publication ${n} sur TikTok`}>
                <Img k={`social/${n}`} sizes="(max-width: 700px) 33vw, 16vw" />
                <span class="social__hover" aria-hidden="true">
                  <svg width="22" height="24" viewBox="0 0 22 24" fill="currentColor"><path d="M16 0c.4 3 2.3 5 5.6 5.3v3.9c-2 .1-3.8-.5-5.6-1.6V16c0 9.6-10.5 10.2-13.5 4.7C.3 17 1.6 10.8 8.6 10.6v4.1c-.6.1-1.1.2-1.6.4-1.4.5-2.2 1.4-2 3 .4 3 6.1 4 5.6-2V0z"></path></svg>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Newsletter />
</Base>

<style>
  /* ================= HERO : SCÈNE DU DROP ================= */
  .dv {
    position: relative;
    height: 100svh;
    min-height: 680px;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(ellipse 60% 55% at 50% 52%, #1a1f2a 0%, transparent 70%),
      var(--bg);
  }
  .dv__word {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
    overflow: hidden;
  }
  .dv__word span {
    font-size: clamp(6rem, 24vw, 30rem);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1px rgb(var(--fg-rgb) / 0.1);
    white-space: nowrap;
    letter-spacing: -0.01em;
    transform: translateY(-2%);
  }
  .dv__canvas,
  .dv__fallback {
    position: absolute;
    z-index: 1;
  }
  .dv__canvas {
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .dv__fallback {
    left: 50%;
    top: 50%;
    height: 86%;
    width: auto;
    transform: translate(-50%, -50%);
    object-fit: contain;
    transition: opacity 0.25s;
    filter: drop-shadow(0 40px 50px rgb(0 0 0 / 0.6));
  }
  .dv:global(.has-gl) .dv__fallback {
    visibility: hidden;
  }
  .dv__top {
    position: absolute;
    inset: calc(var(--header-total) + 1rem) 0 auto;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .dv__live {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .dv__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 rgb(var(--accent-rgb) / 0.7);
    animation: live 1.6s infinite;
  }
  @keyframes live {
    70% {
      box-shadow: 0 0 0 10px rgb(var(--accent-rgb) / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(var(--accent-rgb) / 0);
    }
  }
  .dv__total {
    color: var(--muted);
  }
  .dv__rail {
    position: absolute;
    right: var(--gutter);
    top: 50%;
    z-index: 3;
    transform: translateY(-50%);
    display: grid;
    gap: 0.35rem;
    width: 220px;
  }
  .dv__go {
    width: 100%;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.25rem 0.75rem;
    padding: 0.45rem 0;
    text-align: left;
    color: var(--muted);
    transition: color 0.3s;
  }
  .dv__go:hover,
  .dv__go:global(.is-active) {
    color: var(--fg);
  }
  .dv__go-name {
    font-size: var(--fs-xs);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .dv__go-bar {
    display: block;
    grid-column: 1 / -1;
    height: 2px;
    background: var(--line);
    overflow: hidden;
  }
  .dv__go-bar i {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }
  .dv__go:global(.is-active) .dv__go-bar i {
    transform: scaleX(1);
  }
  .dv:global(.is-cycling) .dv__go:global(.is-active) .dv__go-bar i {
    animation: dv-fill var(--dv-autoplay, 7000ms) linear both;
  }
  .dv:global(.is-paused) .dv__go-bar i {
    animation-play-state: paused !important;
  }
  @keyframes dv-fill {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  .dv__info {
    position: absolute;
    inset: auto 0 0;
    z-index: 3;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 2rem;
    padding-bottom: clamp(1.5rem, 4vh, 2.75rem);
  }
  .dv__meta,
  .dv__buy {
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.9s var(--ease-out),
      transform 1.1s var(--ease-out);
  }
  .dv__buy {
    transition-delay: 0.15s;
  }
  .dv:global(.is-ready) .dv__meta,
  .dv:global(.is-ready) .dv__buy {
    opacity: 1;
    transform: none;
  }
  .dv__kicker {
    color: var(--muted);
    margin-bottom: 0.75rem;
  }
  .dv__name {
    font-family: var(--f-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    line-height: 1;
    font-size: clamp(1.9rem, 3.6vw, 4rem);
    max-width: 11ch;
    min-height: 2.05em;
    display: flex;
    align-items: end;
  }
  .dv__short {
    margin-top: 0.9rem;
    color: var(--fg-2);
    font-size: var(--fs-sm);
  }
  .dv__buy {
    display: grid;
    gap: 0.75rem;
    justify-items: end;
    text-align: right;
  }
  .dv__price-row {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }
  .dv__price {
    font-size: clamp(1.8rem, 2.6vw, 2.8rem);
  }
  .dv__stock {
    color: var(--muted);
  }
  .dv__stock :global(.dv__hot) {
    color: var(--accent-2);
  }
  .dv__hint {
    color: var(--muted);
  }
  .dv__sizes {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: end;
  }
  .dv__sizes :global(.dv__size) {
    position: relative;
    width: 56px;
    height: 52px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    transition:
      background 0.2s,
      color 0.2s,
      border-color 0.2s,
      transform 0.2s;
  }
  .dv__sizes :global(.dv__size:hover) {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
  .dv__sizes :global(.dv__size:disabled) {
    color: var(--muted);
    opacity: 0.45;
    background: linear-gradient(to top right, transparent calc(50% - 0.5px), var(--line-strong) 50%, transparent calc(50% + 0.5px));
  }
