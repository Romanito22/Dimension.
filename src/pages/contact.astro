---
import Base from '../layouts/Base.astro';
import SizeTable from '../components/SizeTable.astro';
import brand from '../data/brand.json';
import faq from '../data/faq.json';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.groups.flatMap((g) =>
    g.items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
  ),
};
---

<Base title="Contact & FAQ" description="Une question sur une commande, une taille ou un retour ? Écris-nous — et retrouve toutes les réponses dans la FAQ dimension." page="contact" jsonld={faqLd}>
  <section class="wrap contact">
    <div class="contact__intro">
      <p class="label accent" data-reveal>Contact</p>
      <h1 class="display h-2xl" data-split>
        <span class="split-line"><span>On t'écoute</span></span>
        <span class="split-line" style="--l:1"><span class="accent">vraiment</span><span class="dot" aria-hidden="true"></span></span>
      </h1>
      <p class="lede muted" data-reveal style="--i:2">Une question sur une commande, une taille, un retour, une collab ? On répond sous 24 h ouvrées.</p>
      <ul class="contact__direct" role="list" data-reveal style="--i:3">
        <li><span class="label muted">E-mail</span><a class="link link--under" href={`mailto:${brand.email}`}>{brand.email}</a></li>
        {
          brand.socials.map((s) => (
            <li>
              <span class="label muted">{s.name}</span>
              <a class="link link--under" href={s.url} target="_blank" rel="noopener">
                {brand.handle}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="contact__form-wrap">
      <form class="contact__form" data-contact novalidate>
        <div class="row">
          <div class="field">
            <label for="c-name" class="label">Nom</label>
            <input class="input" id="c-name" name="name" autocomplete="name" required />
            <p class="field-error"></p>
          </div>
          <div class="field">
            <label for="c-email" class="label">E-mail</label>
            <input class="input" id="c-email" name="email" type="email" autocomplete="email" required />
            <p class="field-error"></p>
          </div>
        </div>
        <div class="field">
          <label for="c-subject" class="label">Sujet</label>
          <select class="select" id="c-subject" name="subject" required>
            <option value="">Choisir un sujet</option>
            <option>Ma commande</option>
            <option>Taille & conseil</option>
            <option>Retour ou échange</option>
            <option>Collaboration / presse</option>
            <option>Autre</option>
          </select>
          <p class="field-error"></p>
        </div>
        <div class="field">
          <label for="c-order" class="label">N° de commande <span class="muted">(facultatif)</span></label>
          <input class="input" id="c-order" name="order" placeholder="DIM-XXXXXX" />
          <p class="field-error"></p>
        </div>
        <div class="field">
          <label for="c-msg" class="label">Message</label>
          <textarea class="textarea" id="c-msg" name="message" required></textarea>
          <p class="field-error"></p>
        </div>
        <button class="btn btn--accent btn--lg" type="submit">Envoyer <span class="btn__dot" aria-hidden="true"></span></button>
      </form>
      <div class="contact__ok" data-contact-ok hidden tabindex="-1">
        <span class="contact__ring" aria-hidden="true"></span>
        <p class="display h-lg">Message reçu</p>
        <p class="muted">Merci ! On revient vers toi sous 24 h ouvrées.</p>
      </div>
    </div>
  </section>

  <section id="faq" class="section wrap faq" aria-labelledby="faq-title">
    <div class="faq__side">
      <span class="label accent">Aide</span>
      <h2 id="faq-title" class="display h-xl">FAQ</h2>
      <p class="muted">Tu ne trouves pas ta réponse ? <a class="link link--under" href={`mailto:${brand.email}`}>Écris-nous</a>.</p>
    </div>
    <div class="faq__groups">
      {
        faq.groups.map((g) => (
          <div class="faq__group">
            <h3 class="label faq__gtitle">{g.title}</h3>
            {g.items.map((i) => (
              <details class="faq__item">
                <summary>{i.q}</summary>
                <p>{i.a}</p>
              </details>
            ))}
          </div>
        ))
      }
    </div>
  </section>

  <section id="guide-des-tailles" class="section wrap guide" aria-labelledby="guide-title">
    <div class="faq__side">
      <span class="label accent">Mesures</span>
      <h2 id="guide-title" class="display h-xl">Guide des tailles</h2>
      <p class="muted">Nos coupes sont amples. Entre deux tailles ? Prends ta taille habituelle pour l'effet boxy, une en dessous pour un tombé classique.</p>
    </div>
    <SizeTable />
  </section>
</Base>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    padding-block: var(--space-lg);
  }
  .contact__intro {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .contact__direct {
    display: grid;
    gap: 0.9rem;
    margin-top: 1rem;
  }
  .contact__direct li {
    display: grid;
    gap: 0.2rem;
  }
  .contact__form {
    display: grid;
    gap: 1rem;
  }
  .contact__form .btn {
    justify-self: start;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .contact__ok {
    display: grid;
    gap: 1rem;
    justify-items: start;
    padding: 2rem;
    background: var(--paper);
    border-radius: var(--radius);
    outline: none;
  }
  .contact__ok[hidden] {
    display: none;
  }
  .contact__ring {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--framboise);
  }
  .faq,
  .guide {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-lg);
    border-top: 1px solid var(--line);
  }
  .faq__side {
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .faq__groups {
    display: grid;
    gap: 2.5rem;
  }
  .faq__gtitle {
    margin-bottom: 0.5rem;
    color: var(--framboise);
  }
  .faq__item {
    border-bottom: 1px solid var(--line);
  }
  .faq__item summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.2rem;
    cursor: pointer;
    font-weight: 600;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__item summary::after {
    content: '';
    flex: none;
    width: 12px;
    height: 12px;
    margin-top: 0.35em;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    transition: background 0.3s;
  }
  .faq__item[open] summary::after {
    background: var(--framboise);
    border-color: var(--framboise);
  }
  .faq__item summary:hover {
    color: var(--framboise);
  }
  .faq__item p {
    padding-bottom: 1.25rem;
    max-width: 62ch;
    color: var(--ink-2);
  }
  @media (max-width: 860px) {
    .contact,
    .faq,
    .guide {
      grid-template-columns: 1fr;
    }
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
