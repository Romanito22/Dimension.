---
import brand from '../data/brand.json';

const next = brand.nextDrop;
---

<section class="nl" aria-labelledby="nl-title">
  <div class="wrap nl__inner">
    <div class="nl__copy">
      <p class="label accent"><span class="nl__dot" aria-hidden="true"></span>Accès anticipé</p>
      <h2 id="nl-title" class="display nl__title" data-chars>{next.name} arrive</h2>
      <div class="nl__count" data-countdown={next.date} aria-label={`Lancement du ${next.name}`}>
        <div><span class="display" data-cd="d">00</span><span class="label">jours</span></div>
        <div><span class="display" data-cd="h">00</span><span class="label">heures</span></div>
        <div><span class="display" data-cd="m">00</span><span class="label">min</span></div>
        <div><span class="display" data-cd="s">00</span><span class="label">sec</span></div>
      </div>
    </div>
    <form class="nl__form" data-newsletter novalidate>
      <p class="lede">
        {next.teaser} Et <strong>−{Math.round(brand.promo.rate * 100)} %</strong> sur ta première commande.
      </p>
      <div class="nl__field">
        <label for="nl-email" class="visually-hidden">Adresse e-mail</label>
        <input id="nl-email" name="email" type="email" required autocomplete="email" placeholder="ton@email.com" />
        <button class="btn btn--accent" type="submit">Je veux l'accès</button>
      </div>
      <p class="nl__msg" data-nl-msg role="status" aria-live="polite"></p>
      <p class="nl__legal">Un e-mail par drop, pas de spam. Désinscription en un clic.</p>
    </form>
  </div>
</section>

<style>
  .nl {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-xl);
    background:
      radial-gradient(ellipse 50% 70% at 15% 100%, rgb(var(--accent-rgb) / 0.22), transparent 70%),
      var(--bg);
    border-top: 1px solid var(--line);
  }
  .nl__inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-lg);
    align-items: end;
  }
  .nl__copy {
    display: grid;
    gap: 1.25rem;
  }
  .nl__copy > .label {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .nl__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    animation: nl-pulse 1.6s infinite;
  }
  @keyframes nl-pulse {
    50% {
      opacity: 0.3;
    }
  }
  .nl__title {
    font-size: clamp(3rem, 8vw, 8.5rem);
  }
  .nl__count {
    display: grid;
    grid-template-columns: repeat(4, auto);
    justify-content: start;
    gap: clamp(1rem, 3vw, 2.5rem);
  }
  .nl__count div {
    display: grid;
    gap: 0.4rem;
  }
  .nl__count .display {
    font-size: clamp(3rem, 7vw, 7rem);
    font-variant-numeric: tabular-nums;
    color: var(--accent-2);
    line-height: 0.85;
  }
  .nl__count .label {
    color: var(--muted);
  }
  .nl__form {
    display: grid;
    gap: 1.25rem;
  }
  .nl__field {
    display: flex;
    gap: 0.5rem;
    padding: 0.4rem;
    border-radius: 999px;
    background: var(--surface-2);
    border: 1px solid var(--line-strong);
  }
  .nl__field input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    padding: 0 1rem;
    font-size: 16px;
    color: var(--fg);
  }
  .nl__field input:focus {
    outline: none;
  }
  .nl__field:focus-within {
    border-color: var(--accent);
  }
  .nl__msg {
    min-height: 1.5em;
    font-weight: 600;
    color: var(--ok);
  }
  .nl__legal {
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .nl__inner {
      grid-template-columns: 1fr;
    }
    .nl__field {
      flex-direction: column;
      border-radius: 20px;
      padding: 0.5rem;
    }
    .nl__field input {
      min-height: 48px;
    }
  }
</style>
