---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Logo from '../components/Logo.astro';
import Newsletter from '../components/Newsletter.astro';
import { getBrand } from '../lib/shop';
import { localeFromPath, translator } from '../i18n';

const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const brand = getBrand(locale);
const s = brand.story;
const visuals = ['story/1', 'lookbook/3', 'story/3', 'lookbook/6'];
---

<Base
  title={t('La marque', 'About')}
  description={t(
    'dimension. — notre histoire : des vêtements brodés et imprimés en séries courtes, une seule règle : love over everything.',
    'dimension. — our story: embroidered and printed clothes in short runs, one rule: love over everything.',
  )}
  page="brand"
  route="brand"
>
  <section class="intro wrap">
    <p class="label accent" data-reveal>{s.kicker}</p>
    <h1 class="display intro__title patch" data-split>
      <span class="split-line"><span>{t('Une dimension', 'One more')}</span></span>
      <span class="split-line" style="--l:1"><span>{t('en plus', 'dimension')}<span class="dot" aria-hidden="true"></span></span></span>
    </h1>
    <div class="intro__grid">
      <p class="lede" data-reveal>{s.intro}</p>
      <div class="intro__mark" data-reveal style="--i:1" aria-hidden="true"><Logo variant="mono" /></div>
    </div>
  </section>

  <div class="wide media" data-reveal="clip">
    <div class="wide__img" data-parallax="0.1"><Img k="story/2" sizes="100vw" /></div>
  </div>

  <section class="section wrap chapters" aria-label={t('Notre histoire en quatre chapitres', 'Our story in four chapters')}>
    {
      s.chapters.map((c, i) => (
        <article class:list={['chapter', i % 2 && 'chapter--flip']}>
          <div class="chapter__media media ratio-45" data-reveal="clip">
            <Img k={visuals[i]} sizes="(max-width: 860px) 100vw, 40vw" />
          </div>
          <div class="chapter__copy">
            <span class="chapter__num display" data-reveal>0{i + 1}</span>
            <h2 class="display h-xl" data-reveal style="--i:1">{c.title}</h2>
            <p class="lede" data-reveal style="--i:2">{c.text}</p>
          </div>
        </article>
      ))
    }
  </section>

  <section class="section wrap values" aria-labelledby="values-title">
    <div class="section-head">
      <div>
        <span class="label accent">{t("Ce qu'on défend", 'What we stand for')}</span>
        <h2 id="values-title" data-chars class="display h-xl">{t('Nos engagements', 'Our commitments')}</h2>
      </div>
    </div>
    <ul class="values__grid" role="list">
      <li data-reveal><span class="label accent">01</span><h3>{t('Moins, mais mieux', 'Less, but better')}</h3><p class="muted">{t("Des drops courts plutôt qu'un catalogue infini. Chaque pièce est pensée, dessinée, testée.", 'Short drops rather than an endless catalogue. Every piece is thought through, drawn, tested.')}</p></li>
      <li data-reveal style="--i:1"><span class="label accent">02</span><h3>{t('Des matières qui durent', 'Fabrics that last')}</h3><p class="muted">{t('Cotons épais, broderies denses, encres résistantes : des pièces qui vieillissent bien.', 'Heavy cottons, dense embroidery, tough inks: pieces that age well.')}</p></li>
      <li data-reveal style="--i:2"><span class="label accent">03</span><h3>{t("Fait à la main d'abord", 'Hand-made first')}</h3><p class="muted">{t("Chaque graphisme naît d'un dessin. On garde le trait, l'accident, la main.", 'Every graphic starts as a drawing. We keep the line, the accident, the hand.')}</p></li>
      <li data-reveal style="--i:3"><span class="label accent">04</span><h3>{t('Une communauté', 'A community')}</h3><p class="muted">{t('On construit dimension. avec celles et ceux qui la portent — retrouve-nous sur ', 'We build dimension. with the people who wear it — find us at ')}{brand.handle}.</p></li>
    </ul>
  </section>

  <Newsletter />
</Base>

<style>
  .intro {
    padding-block: var(--space-lg) var(--space-md);
    display: grid;
    gap: 1.5rem;
  }
  .intro__title {
    font-size: clamp(1.8rem, 5.6vw, 6.2rem);
  }
  .intro__grid {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
  }
  .intro__mark {
    font-size: clamp(3rem, 8vw, 7rem);
    color: var(--accent);
  }
  .wide {
    height: clamp(320px, 70vh, 820px);
  }
  .wide__img {
    position: absolute;
    inset: -10% 0;
  }
  .chapters {
    display: grid;
    gap: var(--space-xl);
  }
  .chapter {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: clamp(1.5rem, 6vw, 8rem);
    align-items: center;
  }
  .chapter--flip .chapter__media {
    order: 2;
  }
  .chapter__media {
    border: 2px solid var(--ink);
    border-radius: 16px;
  }
  .chapter__copy {
    display: grid;
    gap: 1.25rem;
  }
  .chapter__num {
    font-size: clamp(3rem, 7vw, 6rem);
    color: transparent;
    -webkit-text-stroke: 1.5px var(--accent);
  }
  .values__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .values__grid li {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-strong);
  }
  .values__grid h3 {
    font-size: var(--fs-md);
  }
  .values__grid p {
    font-size: var(--fs-sm);
  }
  @media (max-width: 860px) {
    .chapter {
      grid-template-columns: 1fr;
    }
    .chapter--flip .chapter__media {
      order: 0;
    }
    .values__grid {
      grid-template-columns: 1fr 1fr;
    }
    .intro__grid {
      flex-direction: column;
      align-items: start;
    }
  }
</style>
