---
import Logo from './Logo.astro';
import brand from '../data/brand.json';

const nav = [
  { href: '/boutique', label: 'Boutique' },
  { href: '/lookbook', label: 'Lookbook' },
  { href: '/la-marque', label: 'La marque' },
];
const menu = [...nav, { href: '/contact', label: 'Contact & FAQ' }];
---

<header class="site-header" data-header transition:persist="site-header">
  <div class="announce" aria-label="Informations">
    <div class="announce__track">
      {
        [0, 1].map((n) => (
          <ul class="announce__list" role="list" aria-hidden={n === 1 ? 'true' : undefined}>
            {brand.marquee.map((m) => (
              <li>
                <span>{m}</span>
                <span class="announce__sep" aria-hidden="true" />
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>

  <div class="bar">
    <div class="wrap bar__inner">
      <nav class="bar__nav" aria-label="Navigation principale">
        <ul role="list">
          {
            nav.map((l) => (
              <li>
                <a class="link label" href={l.href} data-nav>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <a href="/" class="bar__logo" aria-label="dimension. — accueil">
        <Logo />
      </a>

      <div class="bar__actions">
        <a class="link label bar__contact" href="/contact" data-nav>Contact</a>
        <button class="bar__cart label" type="button" data-cart-open aria-haspopup="dialog" aria-controls="cart-drawer">
          <span>Panier</span>
          <span class="bar__count" data-cart-count>0</span>
        </button>
        <button
          class="burger"
          type="button"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Ouvrir le menu"
        >
          <span></span><span></span>
        </button>
      </div>
    </div>
  </div>

  <div class="menu" id="mobile-menu" data-menu hidden>
    <nav class="wrap menu__inner" aria-label="Menu mobile">
      <ul role="list" class="menu__list">
        {
          menu.map((l, i) => (
            <li style={`--i:${i}`}>
              <a href={l.href} class="display menu__link" data-nav>
                <span class="menu__index label">0{i + 1}</span>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="menu__foot">
        <p class="label muted">{brand.tagline}</p>
        <ul role="list" class="menu__socials">
          {
            brand.socials.map((s) => (
              <li>
                <a class="link label" href={s.url} target="_blank" rel="noopener">
                  {s.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    color: var(--fg);
    transition: transform 0.5s var(--ease-out);
  }
  .site-header.is-hidden {
    transform: translateY(calc(-100% + 0px));
  }
  .site-header.is-hidden:has(.menu:not([hidden])) {
    transform: none;
  }

  /* Bandeau défilant */
  .announce {
    background: var(--brand);
    color: #fff;
    border-bottom: 2px solid var(--ink);
    height: 32px;
    overflow: hidden;
    display: flex;
    align-items: center;
  }
  .announce__track {
    display: flex;
    width: max-content;
    animation: marquee 38s linear infinite;
  }
  .announce:hover .announce__track {
    animation-play-state: paused;
  }
  .announce__list {
    display: flex;
    align-items: center;
  }
  .announce__list li {
    display: flex;
    align-items: center;
    font-family: var(--f-mono);
    font-weight: 600;
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .announce__sep {
    width: 7px;
    height: 7px;
    border: 1.3px solid currentColor;
    border-radius: 50%;
    margin-inline: 2.2rem;
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* Barre principale */
  .bar {
    background: rgb(var(--bg-rgb) / 0.72);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    border-bottom: 1px solid var(--line);
    transition:
      background 0.4s,
      color 0.4s,
      border-color 0.4s;
  }
  :global(body[data-header='overlay']) .site-header:not(.is-scrolled):not(:has(.menu:not([hidden]))) .bar {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-color: transparent;
    color: #fff;
  }
  .bar__inner {
    height: var(--header-h);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }
  .bar__nav ul {
    display: flex;
    gap: clamp(1rem, 2.4vw, 2.4rem);
  }
  .bar__logo {
    font-size: 1.5rem;
    display: inline-flex;
    transition: opacity 0.3s;
  }
  .bar__logo:hover {
    opacity: 0.75;
  }
  .bar__actions {
    display: flex;
    align-items: center;
    justify-content: end;
    gap: clamp(1rem, 2.4vw, 2.4rem);
  }
  .bar__cart {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
  }
  .bar__count {
    display: inline-grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 999px;
    border: 1.3px solid currentColor;
    letter-spacing: 0;
    font-size: 0.625rem;
    transition:
      background 0.3s,
      color 0.3s,
      transform 0.4s var(--ease-out);
  }
  .bar__count.has-items {
    background: var(--brand);
    border-color: var(--ink);
    color: #fff;
  }
  .bar__count.bump {
    animation: bump 0.6s var(--ease-out);
  }
  @keyframes bump {
    40% {
      transform: scale(1.35);
    }
  }

  .burger {
    display: none;
    width: 44px;
    height: 44px;
    position: relative;
    margin-right: -10px;
  }
  .burger span {
    position: absolute;
    left: 11px;
    right: 11px;
    height: 1.5px;
    background: currentColor;
    transition:
      transform 0.45s var(--ease-out),
      top 0.45s var(--ease-out);
  }
  .burger span:first-child {
    top: 18px;
  }
  .burger span:last-child {
    top: 25px;
  }
  .burger[aria-expanded='true'] span:first-child {
    top: 21.5px;
    transform: rotate(45deg);
  }
  .burger[aria-expanded='true'] span:last-child {
    top: 21.5px;
    transform: rotate(-45deg);
  }

  /* Menu mobile */
  .menu {
    position: fixed;
    inset: calc(32px + var(--header-h)) 0 0;
    background: var(--bg);
    color: var(--fg);
    overflow-y: auto;
    animation: menu-in 0.5s var(--ease-out);
  }
  @keyframes menu-in {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  .menu__inner {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-block: 2rem;
  }
  .menu__list li {
    border-bottom: 1px solid var(--line);
    animation: item-in 0.6s var(--ease-out) both;
    animation-delay: calc(var(--i) * 60ms + 100ms);
  }
  @keyframes item-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }
  .menu__link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    font-size: clamp(1.4rem, 6.6vw, 2.4rem);
    padding-block: 1rem;
  }
  .menu__link[aria-current='page'] {
    color: var(--accent);
  }
  .menu__index {
    color: var(--muted);
  }
  .menu__foot {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
    padding-top: 2rem;
  }
  .menu__socials {
    display: flex;
    gap: 1.25rem;
  }

  @media (max-width: 860px) {
    .bar__nav,
    .bar__contact {
      display: none;
    }
    .burger {
      display: block;
    }
    .bar__inner {
      grid-template-columns: auto 1fr;
    }
    .bar__logo {
      font-size: 1.3rem;
    }
    .bar__cart span:first-child {
      display: none;
    }
  }
  @media (min-width: 861px) {
    .menu {
      display: none !important;
    }
  }
</style>
